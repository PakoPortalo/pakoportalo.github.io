---
/**
 * Prueba: tres variantes de "Quién soy" que parten de la que había (foto,
 * nombre y biografía), sin botón de contacto (está justo debajo) y con la
 * biografía entera a la vista, que ya es corta.
 *
 * - directo:  nombre en la display de la web, rol y los tres párrafos.
 * - times:    el rótulo de antes en Times (PAKO PORTALO + lema) y debajo
 *             los tres párrafos, sin pasar de página.
 * - bloques:  la biografía en tres columnas con su tema (Formación,
 *             Videojuegos, Publicidad) para leerla de un vistazo.
 */
import { biografia, trozos } from '../data/sobre';

type Variante = 'directo' | 'times' | 'bloques';

interface Props {
  variante: Variante;
}

const { variante } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---

<section class={`enfoque enfoque--${variante}`}>
  <div class="rejilla">
    <div class="texto">
      <p class="etiqueta">Quién soy</p>
      {
        variante === 'times' ? (
          <h2 class="rotulo">
            <span class="nombre-times">Pako</span>
            <span class="nombre-times">Portalo</span>
            <span class="lema">Música &amp; Diseño sonoro.</span>
          </h2>
        ) : (
          <>
            <h2 class="nombre">Pako Portalo</h2>
            <p class="rol">Compositor y director de sonido</p>
          </>
        )
      }

      <div class:list={['bio', variante === 'bloques' && 'bio--bloques']}>
        {biografia.map((parrafo) => (
          <div class="bio__bloque">
            {variante === 'bloques' && <h3 class="bio__tema">{parrafo.tema}</h3>}
            <p>
              {trozos(parrafo.texto).map((t) => (t.tono ? <span class={`es-${t.tono}`}>{t.texto}</span> : t.texto))}
            </p>
          </div>
        ))}
      </div>
    </div>

    <figure class="foto">
      <img src={`${base}sobre/pako-1-fondo.webp`} alt="" />
      <img src={`${base}sobre/pako-1-persona.webp`} alt="Pako Portalo tocando la guitarra en un concierto" />
    </figure>
  </div>
</section>

<style>
  .enfoque {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: clamp(48px, 7svh, 88px) max(24px, 5.5vw);
    box-sizing: border-box;
    background: #050505;
    color: #f4f1ec;
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    --romana: 'Times New Roman', Times, 'Liberation Serif', 'Nimbus Roman', serif;
  }

  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 6vw, 110px);
    align-items: center;
  }

  .etiqueta {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .nombre {
    margin: 0;
    font-family: ClashDisplay, InstrumentSans, sans-serif;
    font-size: clamp(44px, 5vw, 86px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .rol {
    margin: 12px 0 0;
    font-size: clamp(15px, 1.2vw, 19px);
    color: rgb(255 255 255 / 0.6);
  }

  /* El rótulo de antes, en Times. */
  .rotulo {
    display: grid;
    justify-items: start;
    margin: 0;
    font-weight: normal;
  }

  .nombre-times {
    font-family: var(--romana);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(48px, min(6.4vw, 11svh), 120px);
    letter-spacing: -0.05em;
    line-height: 0.8;
    transform: scaleX(0.94);
    transform-origin: 0 50%;
  }

  .lema {
    position: relative;
    margin-block-start: -0.5em;
    margin-inline-start: 0.5em;
    font-family: var(--romana);
    font-style: italic;
    font-size: clamp(24px, min(2.6vw, 4.4svh), 44px);
    letter-spacing: -0.035em;
    transform: scaleX(0.88);
    transform-origin: 0 50%;
    -webkit-text-stroke: 0.2em #050505;
    paint-order: stroke fill;
  }

  .bio {
    margin-top: clamp(28px, 4svh, 48px);
    padding-top: clamp(20px, 3svh, 32px);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .bio p {
    margin: 0 0 1em;
    max-width: 60ch;
    font-size: clamp(15px, 1.1vw, 18px);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.5);
  }

  .bio--bloques {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.4vw, 40px);
  }

  .bio--bloques p {
    font-size: clamp(14px, 1vw, 16px);
  }

  .bio__tema {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .es-blanco {
    color: rgb(255 255 255 / 0.82);
  }

  .es-verde {
    color: color-mix(in oklab, #5ff7c6 75%, #8a8a8a);
  }

  .es-morado {
    color: color-mix(in oklab, #b660ff 75%, #8a8a8a);
  }

  .foto {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: calc((100svh - 2 * clamp(48px, 7svh, 88px)) * 0.8);
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
  }

  .foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* En bloques, la foto va a la izquierda y la biografía tiene más sitio. */
  .enfoque--bloques .rejilla {
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }

  .enfoque--bloques .foto {
    order: -1;
    justify-self: start;
  }

  @media (max-width: 860px) {
    .rejilla,
    .enfoque--bloques .rejilla,
    .bio--bloques {
      grid-template-columns: 1fr;
    }
  }
</style>
