---
/**
 * El pie de la página, en negro, después del cierre claro: el copyright a
 * la izquierda, Instagram y correo a la derecha. Sin adornos.
 */

import { textos } from '../i18n/textos';
import Banderas from './Banderas.astro';

const correo = 'pakoportalo@gmail.com';
const instagram = 'https://www.instagram.com/pakoportalo/';
const ano = 2026;
const t = textos(Astro.currentLocale);
---

<footer class="pie">
  <div class="pie__fila">
    <div class="pie__izq">
      <p class="pie__copy">© {ano} Pako Portalo</p>
    </div>

    <nav class="pie__redes" aria-label={t.pie.redes}>
      <a class="pie__icono" href={instagram} target="_blank" rel="noreferrer" aria-label="Instagram: @pakoportalo">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.4" cy="6.6" r="1.1" class="pie__lleno" />
        </svg>
      </a>
      <a class="pie__icono" href={`mailto:${correo}`} aria-label={`${t.pie.correo}: ${correo}`}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2.5" />
          <path d="M4 7l8 6 8-6" />
        </svg>
      </a>
      <Banderas class="pie__banderas" />
    </nav>
  </div>
</footer>

<style>
  .pie {
    position: relative;
    z-index: 2;
    overflow: hidden;
    background: #050505;
    color: #f4f1ec;
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    --margen: max(24px, 5.5vw);
  }

  .pie__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    padding: 8px var(--margen);
    border-block-start: 1px solid rgb(255 255 255 / 0.08);
  }

  .pie__izq {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 40px;
  }

  .pie__copy {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.45);
  }

  .pie__redes {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Clásico: iconos sueltos, sin círculo, que se encienden al pasar. */
  .pie__icono {
    display: grid;
    place-items: center;
    width: 34px;
    aspect-ratio: 1;
    color: rgb(255 255 255 / 0.6);
    transition: color 250ms ease;
  }

  .pie__icono svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pie__lleno {
    fill: currentColor;
    stroke: none;
  }

  .pie__icono:hover,
  .pie__icono:focus-visible {
    color: #5ff7c6;
  }

  .pie__icono + .pie__icono:hover,
  .pie__icono + .pie__icono:focus-visible {
    color: #b660ff;
  }

  /* Las banderas, al final del todo, con un poco de aire tras los iconos. */
  .pie__redes :global(.pie__banderas) {
    margin-inline-start: 10px;
  }
</style>
