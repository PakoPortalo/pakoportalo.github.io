---
/**
 * Prueba: cuatro maneras de desplegar Publicidad, Videojuegos y Escenario
 * en "Quién soy". La foto va quieta, solo para ver el conjunto.
 *
 * - acordeon:  tres filas con lo destacado de cada una; al abrir una, se
 *              cierra la otra y el texto entra palabra a palabra.
 * - pestanas:  tres pestañas con una raya de color que se desliza; el
 *              texto cambia en el mismo sitio.
 * - columnas:  las tres columnas de ahora, pero la elegida se ensancha y
 *              las otras se quedan en su título y lo destacado.
 * - indice:    los tres temas en grande, como un índice; el texto del
 *              elegido aparece al lado.
 */
import { biografia, palabras, trozos } from '../data/sobre';

type Variante = 'acordeon' | 'pestanas' | 'columnas' | 'indice';

interface Props {
  variante: Variante;
}

const { variante } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const colores = ['verde', 'morado', 'blanco'] as const;

const temas = biografia.map((b, k) => {
  const destacados = trozos(b.texto).filter((p) => p.tono);
  const grupos = palabras(b.texto);
  return {
    tema: b.tema,
    color: colores[k],
    // Lo destacado, en una línea: lo que se ve con el tema cerrado. Sin
    // destacados, el principio del texto.
    resumen: destacados.length
      ? destacados.map((p) => p.texto).join(' · ')
      : `${grupos
          .slice(0, 9)
          .map((g) => g.map((pz) => pz.texto).join(''))
          .join(' ')}…`,
    palabras: grupos.map((piezas, i) => ({ piezas, i })),
  };
});
---

<section class={`desp desp--${variante}`} data-desp data-abierto="0">
  <div class="desp__rejilla">
    <figure class="desp__foto">
      <img src={`${base}sobre/pako-1-fondo.webp`} alt="" />
      <img src={`${base}sobre/pako-1-persona.webp`} alt="Pako Portalo tocando la guitarra en un concierto" />
    </figure>

    <div class="desp__texto">
      <p class="desp__etiqueta">Quién soy</p>
      <h2 class="desp__nombre">Pako Portalo</h2>
      <p class="desp__rol">Compositor y director de sonido</p>

      <div class="desp__temas">
        {
          variante === 'pestanas' || variante === 'indice' ? (
            <>
              <div class="desp__botones" role="tablist">
                {temas.map((t, k) => (
                  <button class={`desp__boton es-${t.color}`} role="tab" data-boton={k} type="button">
                    {t.tema}
                  </button>
                ))}
                {variante === 'pestanas' && <span class="desp__raya" aria-hidden="true" />}
              </div>
              <div class="desp__paneles">
                {temas.map((t, k) => (
                  <p class="desp__panel" role="tabpanel" data-panel={k}>
                    {t.palabras.map((p) => (
                      <Fragment>
                        {p.i > 0 && ' '}
                        <span class="desp__p" style={`--i: ${p.i}`}>
                          {p.piezas.map((pz) => (pz.tono ? <span class={`es-${pz.tono}`}>{pz.texto}</span> : pz.texto))}
                        </span>
                      </Fragment>
                    ))}
                  </p>
                ))}
              </div>
            </>
          ) : (
            temas.map((t, k) => (
              <div class={`desp__fila es-${t.color}`} data-fila={k}>
                <button class="desp__cabeza" data-boton={k} type="button">
                  <span class="desp__tema">{t.tema}</span>
                  <span class="desp__resumen">{t.resumen}</span>
                  <span class="desp__mas" aria-hidden="true" />
                </button>
                <div class="desp__cuerpo" data-panel={k}>
                  <p class="desp__panel">
                    {t.palabras.map((p) => (
                      <Fragment>
                        {p.i > 0 && ' '}
                        <span class="desp__p" style={`--i: ${p.i}`}>
                          {p.piezas.map((pz) => (pz.tono ? <span class={`es-${pz.tono}`}>{pz.texto}</span> : pz.texto))}
                        </span>
                      </Fragment>
                    ))}
                  </p>
                </div>
              </div>
            ))
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .desp {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: clamp(48px, 7svh, 88px) max(24px, 5.5vw);
    box-sizing: border-box;
    background: #050505;
    color: #f4f1ec;
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    --suave: cubic-bezier(0.16, 1, 0.3, 1);
    --c-verde: color-mix(in oklab, #5ff7c6 75%, #8a8a8a);
    --c-morado: color-mix(in oklab, #b660ff 75%, #8a8a8a);
    --c-blanco: rgb(255 255 255 / 0.82);
  }

  .desp__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(40px, 6vw, 110px);
    align-items: center;
  }

  .desp__foto {
    position: relative;
    width: 100%;
    max-width: calc((100svh - 2 * clamp(48px, 7svh, 88px)) * 0.947);
    aspect-ratio: 950 / 1003;
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
  }

  .desp__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .desp__etiqueta {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .desp__nombre {
    margin: 0;
    font-family: ClashDisplay, InstrumentSans, sans-serif;
    font-size: clamp(44px, 5vw, 86px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    white-space: nowrap;
  }

  .desp__rol {
    margin: 12px 0 0;
    font-size: clamp(15px, 1.2vw, 19px);
    color: rgb(255 255 255 / 0.6);
  }

  .desp__temas {
    margin-top: clamp(28px, 4svh, 48px);
  }

  .desp button {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
  }

  .desp__panel {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(14px, 1.05vw, 17px);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.5);
  }

  .es-blanco {
    --c: var(--c-blanco);
  }
  .es-verde {
    --c: var(--c-verde);
  }
  .es-morado {
    --c: var(--c-morado);
  }
  .desp__p .es-blanco,
  .desp__p .es-verde,
  .desp__p .es-morado {
    color: var(--c);
  }

  /* Las palabras entran desde la izquierda al abrirse su panel. */
  .desp__p {
    display: inline-block;
    opacity: 0;
    translate: -24px 0;
  }

  .desp [data-panel].abierto .desp__p {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 400ms ease calc(120ms + var(--i) * 7ms),
      translate 600ms var(--suave) calc(120ms + var(--i) * 7ms);
  }

  /* ── 1 · Acordeón ─────────────────────────────────────────── */
  .desp--acordeon .desp__fila {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .desp--acordeon .desp__fila:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .desp--acordeon .desp__cabeza {
    display: grid;
    grid-template-columns: 9.5em 1fr 20px;
    align-items: center;
    gap: 24px;
    width: 100%;
    padding: 20px 0;
  }

  .desp__tema {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
    transition: color 300ms ease;
  }

  .desp__resumen {
    overflow: hidden;
    font-size: 14px;
    color: rgb(255 255 255 / 0.4);
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: opacity 300ms ease;
  }

  /* El + que gira hasta ser ×. */
  .desp__mas {
    position: relative;
    width: 14px;
    height: 14px;
    transition: rotate 500ms var(--suave);
  }

  .desp__mas::before,
  .desp__mas::after {
    content: '';
    position: absolute;
    inset: 6px 0;
    background: currentColor;
  }

  .desp__mas::after {
    rotate: 90deg;
  }

  .desp--acordeon .desp__cuerpo {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 600ms var(--suave);
  }

  .desp--acordeon .desp__cuerpo > p {
    overflow: hidden;
    padding-left: calc(9.5em + 24px);
  }

  .desp--acordeon .abierto.desp__cuerpo {
    grid-template-rows: 1fr;
  }

  .desp--acordeon .desp__cuerpo.abierto > p {
    padding-bottom: 22px;
  }

  .desp--acordeon .desp__fila:has(.abierto) .desp__tema,
  .desp--acordeon .desp__cabeza:hover .desp__tema {
    color: var(--c);
  }

  .desp--acordeon .desp__fila:has(.abierto) .desp__resumen {
    opacity: 0;
  }

  .desp--acordeon .desp__fila:has(.abierto) .desp__mas {
    rotate: 45deg;
    color: var(--c);
  }

  /* ── 2 · Pestañas ─────────────────────────────────────────── */
  .desp--pestanas .desp__botones {
    position: relative;
    display: flex;
    gap: clamp(24px, 3vw, 48px);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .desp--pestanas .desp__boton {
    padding: 0 0 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
    transition: color 300ms ease;
  }

  .desp--pestanas .desp__boton:hover,
  .desp--pestanas .desp__boton.activo {
    color: var(--c);
  }

  /* La raya: la pone el script bajo la pestaña activa, con su color. */
  .desp__raya {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    width: var(--w, 0);
    translate: var(--x, 0) 0;
    background: var(--c, #fff);
    box-shadow: 0 0 12px var(--c, #fff);
    transition:
      translate 600ms var(--suave),
      width 600ms var(--suave),
      background-color 300ms ease;
  }

  .desp--pestanas .desp__paneles,
  .desp--indice .desp__paneles {
    display: grid;
  }

  .desp--pestanas .desp__panel,
  .desp--indice .desp__panel {
    grid-area: 1 / 1;
    padding-top: 24px;
    visibility: hidden;
  }

  .desp--pestanas .desp__panel.abierto,
  .desp--indice .desp__panel.abierto {
    visibility: visible;
  }

  /* ── 3 · Columnas que se ensanchan ────────────────────────── */
  .desp--columnas .desp__temas {
    display: flex;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .desp--columnas .desp__fila {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 700ms var(--suave);
  }

  .desp--columnas .desp__fila:has(.abierto) {
    flex-grow: 2.6;
  }

  .desp--columnas .desp__cabeza {
    display: grid;
    gap: 10px;
    width: 100%;
    padding-bottom: 14px;
  }

  .desp--columnas .desp__resumen {
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    line-height: 1.5;
  }

  .desp--columnas .desp__mas {
    display: none;
  }

  /* Raya de color bajo el título de la columna abierta. */
  .desp--columnas .desp__tema {
    padding-bottom: 10px;
    background: linear-gradient(var(--c), var(--c)) no-repeat 0 100% / 0 2px;
    transition:
      color 300ms ease,
      background-size 600ms var(--suave);
  }

  .desp--columnas .desp__fila:has(.abierto) .desp__tema,
  .desp--columnas .desp__cabeza:hover .desp__tema {
    color: var(--c);
  }

  .desp--columnas .desp__fila:has(.abierto) .desp__tema {
    background-size: 32px 2px;
  }

  .desp--columnas .desp__fila:has(.abierto) .desp__resumen {
    display: none;
  }

  .desp--columnas .desp__cuerpo {
    display: none;
  }

  .desp--columnas .desp__cuerpo.abierto {
    display: block;
  }

  .desp--columnas .desp__panel {
    min-width: 30ch;
  }

  /* ── 4 · Índice ───────────────────────────────────────────── */
  .desp--indice .desp__temas {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .desp--indice .desp__botones {
    display: grid;
    gap: 4px;
  }

  .desp--indice .desp__boton {
    font-family: ClashDisplay, InstrumentSans, sans-serif;
    font-size: clamp(30px, 2.8vw, 46px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: rgb(255 255 255 / 0.18);
    transition:
      color 400ms ease,
      translate 600ms var(--suave),
      text-shadow 400ms ease;
  }

  .desp--indice .desp__boton:hover {
    color: rgb(255 255 255 / 0.45);
  }

  .desp--indice .desp__boton.activo {
    color: var(--c);
    translate: 12px 0;
    text-shadow: 0 0 24px color-mix(in oklab, var(--c) 40%, transparent);
  }

  .desp--indice .desp__panel {
    padding-top: 6px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-desp]').forEach((seccion) => {
    const botones = Array.from(seccion.querySelectorAll<HTMLElement>('[data-boton]'));
    const paneles = Array.from(seccion.querySelectorAll<HTMLElement>('[data-panel]'));
    const raya = seccion.querySelector<HTMLElement>('.desp__raya');
    const acordeon = seccion.classList.contains('desp--acordeon');
    const conHover = seccion.matches('.desp--indice, .desp--columnas');

    const abrir = (k: number) => {
      botones.forEach((b, j) => {
        b.classList.toggle('activo', j === k);
        b.setAttribute(b.role === 'tab' ? 'aria-selected' : 'aria-expanded', String(j === k));
      });
      paneles.forEach((p, j) => p.classList.toggle('abierto', j === k));
      if (raya && botones[k]) {
        const b = botones[k];
        raya.style.setProperty('--x', `${b.offsetLeft}px`);
        raya.style.setProperty('--w', `${b.offsetWidth}px`);
        raya.style.setProperty('--c', getComputedStyle(b).getPropertyValue('--c'));
      }
    };

    let actual = 0;
    botones.forEach((b, k) => {
      b.addEventListener('click', () => {
        // En el acordeón, pulsar el abierto lo cierra.
        actual = acordeon && actual === k ? -1 : k;
        abrir(actual);
      });
      if (conHover) {
        b.addEventListener('pointerenter', () => {
          actual = k;
          abrir(k);
        });
      }
    });

    // El primero, abierto al llegar.
    new IntersectionObserver(
      ([e], obs) => {
        if (!e?.isIntersecting) return;
        abrir(actual);
        obs.disconnect();
      },
      { threshold: 0.4 },
    ).observe(seccion);
  });
</script>
