---
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { youtubeThumb } from '../i18n/utils';

interface Props {
  /** ID del vídeo, no la URL: "dQw4w9WgXcQ" */
  id: string;
  title: string;
  locale: Locale;
}

const { id, title, locale } = Astro.props;
const t = useTranslations(locale);
---

{/*
  Fachada: hasta que no pulsas, no se carga nada de YouTube — ni iframe, ni
  cookies, ni el megabyte de su reproductor. Solo la miniatura.
*/}
<yt-facade class="yt" data-id={id} data-title={title}>
  <button type="button" class="yt__button">
    <img
      src={youtubeThumb(id)}
      alt=""
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
    />
    <span class="yt__play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48">
        <path
          d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2 0 34 0 34 0S12.8 0 7.5 1.7a8.6 8.6 0 0 0-6 6A90 90 0 0 0 0 24a90 90 0 0 0 1.5 16.3 8.6 8.6 0 0 0 6 6C12.8 48 34 48 34 48s21.2 0 26.5-1.7a8.6 8.6 0 0 0 6-6A90 90 0 0 0 68 24a90 90 0 0 0-1.5-16.3z"
          fill="#f00"></path>
        <path d="M27 34 45 24 27 14z" fill="#fff"></path>
      </svg>
    </span>
    <span class="visually-hidden">{t('work.watch')}: {title}</span>
  </button>
</yt-facade>

<style>
  .yt {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-sunken);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .yt__button {
    all: unset;
    display: block;
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .yt__button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -4px;
  }

  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    opacity: 0.85;
    transition: opacity 150ms ease, scale 150ms ease;
  }

  .yt__button:hover .yt__play,
  .yt__button:focus-visible .yt__play {
    opacity: 1;
    scale: 1.06;
  }

  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  class YouTubeFacade extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      button?.addEventListener(
        'click',
        () => {
          const id = this.dataset.id;
          const title = this.dataset.title ?? '';
          if (!id) return;

          const iframe = document.createElement('iframe');
          // nocookie + autoplay, ya que el usuario ha pulsado explícitamente.
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
          iframe.title = title;
          iframe.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          this.replaceChildren(iframe);
          iframe.focus();
        },
        { once: true },
      );
    }
  }

  if (!customElements.get('yt-facade')) {
    customElements.define('yt-facade', YouTubeFacade);
  }
</script>
