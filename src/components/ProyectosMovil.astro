---
/**
 * Prueba: la lista de proyectos para el móvil, una obra debajo de otra,
 * con cuatro maneras de entrar al bajar.
 *
 * - lados:      una desde la izquierda y la siguiente desde la derecha,
 *               con un giro leve que se endereza al llegar.
 * - cortinilla: el vídeo se destapa con un barrido lateral, alternando el
 *               sentido, mientras se aleja un poco por dentro.
 * - zoom:       ligado al scroll: cada vídeo se abre de estrecho a todo el
 *               ancho, y su zoom se suelta, según sube hacia el centro.
 * - montaje:    una línea vertical con el cabezal morado que avanza al
 *               bajar; cada obra es un clip enganchado a ella.
 *
 * Todas abren la ventana del proyecto al tocar (data-proyecto).
 */
import { obras, enlaceYouTube } from '../data/obras';
import ClipVideo from './ClipVideo.astro';

type Variante = 'lados' | 'cortinilla' | 'zoom' | 'montaje';

interface Props {
  variante: Variante;
}

const { variante } = Astro.props;
const total = String(obras.length).padStart(2, '0');
const num = (i: number) => `${String(i + 1).padStart(2, '0')} / ${total}`;
const meta = (o: (typeof obras)[number]) => [o.titulo, o.agencia, o.ano, o.papel].filter(Boolean).join(' · ');
---

<section class={`pm pm--${variante}`} data-pm={variante}>
  <h2 class="pm__rotulo">Proyectos destacados</h2>
  <div class="pm__lista" data-lista>
    {
      variante === 'montaje' && (
        <span class="pm__via" aria-hidden="true">
          <span class="pm__cabezal" data-cabezal />
        </span>
      )
    }
    {
      obras.map((obra, i) => (
        <a
          class:list={['pm__pieza', i % 2 ? 'pm__pieza--dcha' : 'pm__pieza--izq']}
          href={enlaceYouTube(obra)}
          target="_blank"
          rel="noreferrer"
          data-proyecto={obra.slug}
          data-pieza
        >
          {variante === 'montaje' && <span class="pm__marca" aria-hidden="true" />}
          <div class="pm__marco">
            <ClipVideo clip={obra.slug} />
          </div>
          <div class="pm__ficha">
            <span class="pm__num">{num(i)}</span>
            <h3 class="pm__titulo">{obra.marca}</h3>
            <p class="pm__meta">{meta(obra)}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .pm {
    position: relative;
    overflow: clip;
    padding: 56px 20px 80px;
    background: #050505;
    color: #f4f1ec;
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    --morado: #b660ff;
    --suave: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pm a {
    color: inherit;
    text-decoration: none;
  }

  .pm__rotulo {
    margin: 0 0 28px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .pm__lista {
    position: relative;
    display: grid;
    gap: 52px;
  }

  .pm__pieza {
    position: relative;
    display: block;
  }

  .pm__marco {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: #111;
  }

  .pm__ficha {
    display: grid;
    gap: 2px;
    margin-top: 14px;
  }

  .pm__num {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: rgb(255 255 255 / 0.4);
  }

  .pm__titulo {
    margin: 0;
    font-family: ClashDisplay, InstrumentSans, sans-serif;
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .pm__meta {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.55);
  }

  /* ── 1 · Lados ─────────────────────────────────────────────── */
  .pm--lados .pm__marco,
  .pm--lados .pm__ficha {
    opacity: 0;
    transition:
      opacity 700ms ease,
      translate 1100ms var(--suave),
      rotate 1100ms var(--suave);
  }

  .pm--lados .pm__pieza--izq .pm__marco {
    translate: -70px 0;
    rotate: -3deg;
  }

  .pm--lados .pm__pieza--dcha .pm__marco {
    translate: 70px 0;
    rotate: 3deg;
  }

  .pm--lados .pm__pieza--izq .pm__ficha {
    translate: -30px 0;
  }

  .pm--lados .pm__pieza--dcha .pm__ficha {
    translate: 30px 0;
  }

  .pm--lados .dentro :is(.pm__marco, .pm__ficha) {
    opacity: 1;
    translate: 0 0;
    rotate: 0deg;
  }

  .pm--lados .dentro .pm__ficha {
    transition-delay: 160ms;
  }

  /* ── 2 · Cortinilla ────────────────────────────────────────── */
  .pm--cortinilla .pm__marco {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1100ms cubic-bezier(0.77, 0, 0.18, 1);
  }

  .pm--cortinilla .pm__pieza--dcha .pm__marco {
    clip-path: inset(0 0 0 100%);
  }

  .pm--cortinilla .pm__marco :global(video),
  .pm--cortinilla .pm__marco :global(img[data-clip-animado]) {
    scale: 1.3;
    transition: scale 1600ms var(--suave);
  }

  .pm--cortinilla .dentro .pm__marco {
    clip-path: inset(0 0 0 0);
  }

  .pm--cortinilla .dentro .pm__marco :global(video),
  .pm--cortinilla .dentro .pm__marco :global(img[data-clip-animado]) {
    scale: 1;
  }

  .pm--cortinilla .pm__ficha > * {
    opacity: 0;
    translate: 0 18px;
    transition:
      opacity 500ms ease,
      translate 800ms var(--suave);
  }

  .pm--cortinilla .dentro .pm__ficha > * {
    opacity: 1;
    translate: 0 0;
  }

  .pm--cortinilla .dentro .pm__ficha > :nth-child(1) {
    transition-delay: 650ms;
  }

  .pm--cortinilla .dentro .pm__ficha > :nth-child(2) {
    transition-delay: 730ms;
  }

  .pm--cortinilla .dentro .pm__ficha > :nth-child(3) {
    transition-delay: 810ms;
  }

  /* ── 3 · Zoom con el scroll ────────────────────────────────── */
  /* --a va de 0 (abajo del todo) a 1 (cerca del centro); lo pone el script. */
  .pm--zoom .pm__marco {
    margin-inline: calc((1 - var(--a, 0)) * 9%);
    border-radius: calc(4px + (1 - var(--a, 0)) * 14px);
    opacity: calc(0.35 + var(--a, 0) * 0.65);
  }

  .pm--zoom .pm__marco :global(video),
  .pm--zoom .pm__marco :global(img[data-clip-animado]) {
    scale: calc(1 + (1 - var(--a, 0)) * 0.35);
  }

  .pm--zoom .pm__ficha {
    translate: calc((1 - var(--a, 0)) * 40px) 0;
    opacity: var(--a, 0);
  }

  /* ── 4 · Línea de montaje ──────────────────────────────────── */
  .pm--montaje .pm__lista {
    padding-left: 22px;
  }

  .pm__via {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 4px;
    width: 1px;
    background: rgb(255 255 255 / 0.15);
  }

  /* El cabezal: lo recorrido en morado y su punta, como en la línea de
     tiempo del ordenador. --c va de 0 a 1, lo pone el script. */
  .pm__cabezal {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: calc(var(--c, 0) * 100%);
    background: var(--morado);
    box-shadow: 0 0 8px var(--morado);
  }

  .pm__cabezal::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: -4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--morado);
    box-shadow: 0 0 12px var(--morado);
  }

  /* La marca de cada obra en la línea: se enciende al pasar el cabezal. */
  .pm__marca {
    position: absolute;
    top: 0;
    left: -22px;
    width: 9px;
    height: 9px;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: #050505;
    translate: 0 -4px;
    transition:
      background-color 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }

  .pm--montaje .pasado .pm__marca {
    background: var(--morado);
    border-color: var(--morado);
    box-shadow: 0 0 10px var(--morado);
  }

  .pm--montaje .pm__marco,
  .pm--montaje .pm__ficha {
    opacity: 0;
    translate: 60px 0;
    transition:
      opacity 600ms ease,
      translate 1000ms var(--suave);
  }

  .pm--montaje .dentro :is(.pm__marco, .pm__ficha) {
    opacity: 1;
    translate: 0 0;
  }

  .pm--montaje .dentro .pm__ficha {
    transition-delay: 140ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .pm * {
      transition: none !important;
    }
  }
</style>

<script>
  const limitar = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  // Lados, cortinilla y montaje: cada obra entra al asomar.
  const entra = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) {
        if (e.isIntersecting) {
          e.target.classList.add('dentro');
          entra.unobserve(e.target);
        }
      }
    },
    { threshold: 0.25 },
  );
  document.querySelectorAll('.pm:not(.pm--zoom) [data-pieza]').forEach((el) => entra.observe(el));

  // Zoom y montaje: ligados al scroll.
  const zoom = Array.from(document.querySelectorAll<HTMLElement>('.pm--zoom [data-pieza]'));
  const montajes = Array.from(document.querySelectorAll<HTMLElement>('.pm--montaje'));
  let pedido = 0;
  const actualizar = () => {
    pedido = 0;
    const alto = window.innerHeight;
    // Cada vídeo, de 0 con su parte alta en el borde de abajo a 1 en el centro.
    zoom.forEach((pieza) => {
      const r = pieza.getBoundingClientRect();
      const centro = r.top + r.height * 0.35;
      const a = limitar((alto - centro) / (alto * 0.5), 0, 1);
      pieza.style.setProperty('--a', (1 - Math.pow(1 - a, 2)).toFixed(3));
    });
    // El cabezal llega hasta algo más abajo del centro de la pantalla.
    montajes.forEach((seccion) => {
      const lista = seccion.querySelector<HTMLElement>('[data-lista]')!;
      const r = lista.getBoundingClientRect();
      const c = limitar((alto * 0.55 - r.top) / r.height, 0, 1);
      seccion.querySelector<HTMLElement>('[data-cabezal]')!.style.setProperty('--c', c.toFixed(4));
      const linea = r.top + c * r.height;
      seccion.querySelectorAll<HTMLElement>('[data-pieza]').forEach((pieza) => {
        pieza.classList.toggle('pasado', pieza.getBoundingClientRect().top <= linea + 2);
      });
    });
  };
  if (zoom.length || montajes.length) {
    window.addEventListener('scroll', () => (pedido ||= requestAnimationFrame(actualizar)), { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  }
</script>
