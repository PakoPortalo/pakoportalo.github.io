---
/**
 * Franja de contacto: una pregunta en grande que, al pasar el ratón, rueda
 * letra a letra y deja ver la respuesta. Abre la tarjeta de visita
 * (Tarjeta.astro); sin JavaScript, lleva a la página de contacto.
 *
 * Sale dos veces: justo después de los proyectos, que es cuando alguien se
 * convence y no tiene por qué bajar hasta el final para escribir, y como
 * cierre de la página, con otra frase.
 */

import { textos } from '../i18n/textos';

interface Props {
  pregunta?: string;
  respuesta?: string;
  destino?: string;
  id?: string;
  /** El cierre de la página: más alto, con un texto debajo de la frase. */
  texto?: string;
  /** Órbitas alrededor de la flecha y una mirilla, de fondo. */
  conOrbitas?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const t = textos(Astro.currentLocale);

const {
  pregunta = t.atajo.pregunta,
  respuesta = t.atajo.respuesta,
  destino = `${base}contacto/`,
  id,
  texto,
  conOrbitas = false,
} = Astro.props;

/*
  Cada frase, partida en palabras y cada palabra en letras. Las letras
  ruedan una a una (por eso cada una es una caja con su número de orden),
  y las palabras son bloques que no se parten: así, si la frase no cabe en
  una línea, salta entre palabras y nunca a mitad de una.
*/
const palabras = (texto: string) => {
  let i = 0;
  return texto.split(' ').map((palabra) => Array.from(palabra).map((letra) => ({ letra, i: i++ })));
};

/** Un signo de cierre detrás de una vocal con tilde: el acento lo pisaría. */
const pisaAcento = (palabra: { letra: string }[], k: number) =>
  (palabra[k]?.letra === '!' || palabra[k]?.letra === '?') && /[áéíóú]/i.test(palabra[k - 1]?.letra ?? '');

/*
  Las órbitas alrededor de la flecha: anillos grises quietos y, encima,
  órbitas que giran con un punto cada una, a distintas velocidades y en
  sentidos contrarios. Centradas en el círculo de la flecha, que por eso
  deja de seguir al ratón.
*/
const orbitas = conOrbitas
  ? [
      // El verde pasa por encima del texto; el morado, por debajo.
      { r: 126, color: 'verde', segundos: 34, sentido: 1, punto: 9, encima: true },
      { r: 210, color: 'morado', segundos: 26, sentido: -1, punto: 12, encima: false },
    ]
  : null;
---

<section class:list={['atajo', texto && 'atajo--cierre', orbitas && 'atajo--orbitas']} aria-label={t.atajo.etiqueta} id={id} data-atajo>
  {
    orbitas && (
      <>
      {/* Fuera de la capa de órbitas, que crece con el ratón: así no se mueve. */}
      <svg class="atajo__mira" viewBox="0 0 60 60" aria-hidden="true">
        <circle cx="30" cy="30" r="12" />
        <line x1="30" x2="30" y1="0" y2="60" />
        <line x1="0" x2="60" y1="30" y2="30" />
      </svg>
      <div class="atajo__orbitas" aria-hidden="true">
        <svg class="atajo__sistema" viewBox="-260 -260 520 520">
          {/* El brillo de los planetas, como filtro SVG: Safari no aplica
              filtros CSS a lo que va dentro de un SVG y se quedaban planos. */}
          <defs>
            <filter id="atajo-brillo" x="-300%" y="-300%" width="700%" height="700%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="halo" />
              <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="nucleo" />
              <feMerge>
                <feMergeNode in="halo" />
                <feMergeNode in="halo" />
                <feMergeNode in="nucleo" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>
          {Array.from({ length: 7 }, (_, k) => (
            <circle class="atajo__anillo" r={70 + k * 28} />
          ))}
          {orbitas.filter((o) => !o.encima).map((o) => (
            <g
              class={`atajo__orbita atajo__orbita--${o.color}`}
              data-orbita
              data-r={o.r}
              data-segundos={o.segundos}
              data-sentido={o.sentido}
            >
              <circle class="atajo__satelite" cx={o.r} cy="0" r={o.punto} filter="url(#atajo-brillo)" />
            </g>
          ))}
        </svg>
      </div>
      <div class="atajo__orbitas atajo__orbitas--encima" aria-hidden="true">
        <svg class="atajo__sistema" viewBox="-260 -260 520 520">
          {orbitas.filter((o) => o.encima).map((o) => (
            <g
              class={`atajo__orbita atajo__orbita--${o.color}`}
              data-orbita
              data-r={o.r}
              data-segundos={o.segundos}
              data-sentido={o.sentido}
            >
              <circle class="atajo__satelite" cx={o.r} cy="0" r={o.punto} filter="url(#atajo-brillo)" />
            </g>
          ))}
        </svg>
      </div>
      </>
    )
  }
  <a class="atajo__enlace" href={destino} aria-label={`${pregunta} ${respuesta}`} data-tarjeta>
    <span class="atajo__frases" aria-hidden="true">
      <span class="atajo__frase atajo__frase--pregunta">
        {
          palabras(pregunta).map((palabra, j, todas) => (
            <>
            <span class="atajo__palabra">
              {palabra.map(({ letra, i }) => (
                <span class="atajo__letra" style={`--i: ${i}`}>
                  {letra}
                </span>
              ))}
            </span>
            {j < todas.length - 1 && ' '}
            </>
          ))
        }
      </span>
      <span class="atajo__frase atajo__frase--respuesta">
        {
          palabras(respuesta).map((palabra, j, todas) => (
            <>
            <span class="atajo__palabra">
              {palabra.map(({ letra, i }, k) => (
                <span
                  class:list={['atajo__letra', { 'es-cierre': pisaAcento(palabra, k) }]}
                  style={`--i: ${i}`}
                >
                  {letra}
                </span>
              ))}
            </span>
            {j < todas.length - 1 && ' '}
            </>
          ))
        }
      </span>
    </span>
    <span class="atajo__flecha" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </a>
  <p class="atajo__movil" aria-hidden="true">{respuesta}</p>
  {texto && <p class="atajo__texto">{texto}</p>}
</section>

<style>
  .atajo {
    /* Por encima del hero, que es una capa fija, como todos los módulos. */
    position: relative;
    /* Un nivel por encima del módulo siguiente: su sombra cae hacia arriba
       para leerse como una lámina sobre el negro, y sobre este fondo claro
       se quedaba como una mancha gris. */
    z-index: 2;
    color: #050505;
    padding: clamp(26px, 3vw, 48px) max(24px, 5.5vw);
    /* El color de la respuesta: verde la primera vez que pasas el ratón,
       morado la siguiente, y así. Lo alterna el script. */
    --acento: #5ff7c6;
  }

  .atajo[data-tono='morado'] {
    --acento: #b660ff;
  }

  /*
    El fondo claro va en una capa aparte para poder ampliarlo al pasar el
    ratón sin mover nada: crece por encima de los módulos de al lado en vez
    de empujarlos, y la página no da saltos.

    Al revés que el resto: una franja clara entre módulos negros. Es el
    único corte de color de la página, y por eso se ve sin buscarla.
  */
  .atajo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #f4f1ec;
    transition: scale 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .atajo:has(.atajo__enlace:hover)::before,
  .atajo:has(.atajo__enlace:focus-visible)::before {
    scale: 1.03 1.1;
  }

  /* ── El cierre: más alto, con texto, y la página acaba en claro ── */
  .atajo--cierre {
    display: grid;
    align-content: center;
    min-height: 60svh;
    padding-block: clamp(64px, 10svh, 120px);
  }

  .atajo--cierre:has(.atajo__enlace:hover)::before,
  .atajo--cierre:has(.atajo__enlace:focus-visible)::before {
    scale: 1.01 1.03;
  }

  .atajo__enlace,
  .atajo__texto,
  .atajo__movil {
    position: relative;
    z-index: 1;
  }

  /* ── Órbitas alrededor de la flecha ───────────────────────── */
  /*
    La flecha se coloca a mano en el centro vertical de la franja y en el
    margen derecho, y la capa de órbitas usa ese mismo punto como centro.
    La capa ocupa toda la franja y recorta lo que se sale, así los anillos
    no invaden el módulo de arriba ni crean scroll.
  */
  .atajo--orbitas {
    --flecha: clamp(56px, 6vw, 96px);
    --margen: max(24px, 5.5vw);
  }

  .atajo--orbitas .atajo__frases {
    position: relative;
    z-index: 1;
  }

  .atajo--orbitas .atajo__flecha {
    position: relative;
    z-index: 1;
  }

  /*
    La capa crece con el fondo al pasar el ratón (la misma escala que el
    ::before), así el recorte de los anillos se abre con él y no corta por
    arriba. Dentro, el sistema se contraescala para que los anillos no se
    deformen.
  */
  .atajo__orbitas {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    transition: scale 650ms cubic-bezier(0.16, 1, 0.3, 1);
    /* Crece desde el centro de las órbitas: desde el de la franja, el
       sistema se desplazaba a la derecha y la flecha perdía el centro. */
    transform-origin: var(--ox, 90%) var(--oy, 50%);
  }

  /* La capa del planeta verde, por encima de la frase y el texto. */
  .atajo__orbitas--encima {
    z-index: 2;
  }

  .atajo--cierre:has(.atajo__enlace:hover) .atajo__orbitas,
  .atajo--cierre:has(.atajo__enlace:focus-visible) .atajo__orbitas {
    scale: 1.01 1.03;
  }

  .atajo--cierre:has(.atajo__enlace:hover) .atajo__sistema,
  .atajo--cierre:has(.atajo__enlace:focus-visible) .atajo__sistema {
    scale: calc(1 / 1.01) calc(1 / 1.03);
  }

  /* El centro del sistema es el de la flecha (--ox, --oy, los mide el
     script). Lo que se sale por arriba queda cortado por la franja, por
     detrás del módulo negro. */
  .atajo__sistema {
    transition: scale 650ms cubic-bezier(0.16, 1, 0.3, 1);
    position: absolute;
    inset-block-start: var(--oy, 50%);
    inset-inline-start: var(--ox, 90%);
    width: 520px;
    height: 520px;
    translate: -50% -50%;
    overflow: visible;
    fill: none;
  }

  .atajo__anillo {
    stroke: rgb(5 5 5 / 0.1);
    stroke-width: 1;
  }

  .atajo__mira {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    inset-block-end: clamp(28px, 6svh, 64px);
    inset-inline-start: max(24px, 5.5vw);
    width: 40px;
    fill: none;
    stroke: rgb(5 5 5 / 0.55);
    stroke-width: 1.5;
  }

  /* Los puntos, en neón como los de los premios: color pleno y halo del
     mismo color alrededor. */
  .atajo__satelite {
    fill: var(--c);
  }

  .atajo__orbita--verde {
    --c: #5ff7c6;
    --halo: rgb(95 247 198 / 0.8);
  }

  .atajo__orbita--morado {
    --c: #b660ff;
    --halo: rgb(182 96 255 / 0.8);
  }


  /*
    La flecha, como un planeta: al pasar el ratón se enciende con un neón
    potente de su color, con un halo que tiembla muy sutilmente, y el
    círculo late suave.
  */
  .atajo--orbitas .atajo__enlace:hover .atajo__flecha,
  .atajo--orbitas .atajo__enlace:focus-visible .atajo__flecha,
  .atajo--orbitas[data-encendida] .atajo__flecha {
    /* Dos ritmos a la vez: el halo chisporrotea a saltos y el círculo
       late suave, creciendo y decreciendo. */
    animation:
      crepita 2.9s ease-in-out infinite,
      palpita 2.4s ease-in-out infinite;
  }

  @keyframes palpita {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.12;
    }
  }

  /* El halo apenas tiembla: variaciones pequeñas de intensidad, sin
     apagones. Se nota que está vivo, no que falla. */
  @keyframes crepita {
    0%,
    100% {
      box-shadow:
        0 0 14px 3px var(--acento),
        0 0 46px 10px color-mix(in srgb, var(--acento) 50%, transparent);
    }
    23% {
      box-shadow:
        0 0 15px 3px var(--acento),
        0 0 50px 11px color-mix(in srgb, var(--acento) 56%, transparent);
    }
    41% {
      box-shadow:
        0 0 13px 3px var(--acento),
        0 0 43px 10px color-mix(in srgb, var(--acento) 46%, transparent);
    }
    67% {
      box-shadow:
        0 0 15px 4px var(--acento),
        0 0 52px 12px color-mix(in srgb, var(--acento) 54%, transparent);
    }
    84% {
      box-shadow:
        0 0 13px 3px var(--acento),
        0 0 45px 10px color-mix(in srgb, var(--acento) 48%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atajo--orbitas .atajo__enlace:hover .atajo__flecha {
      animation: none;
      box-shadow: 0 0 46px 10px color-mix(in srgb, var(--acento) 55%, transparent);
    }
  }



  @media (prefers-reduced-motion: reduce) {
  }

  /* En el cierre, la respuesta se alinea a la izquierda como la pregunta y
     el texto: centrada rompía la columna. */
  .atajo--cierre .atajo__frase--respuesta {
    justify-self: start;
    text-align: start;
  }

  /* Y crece desde su arranque, no desde el centro: así no se sale por la
     izquierda de la columna. */
  .atajo--cierre .atajo__frases {
    transform-origin: 0 50%;
  }

  .atajo__texto {
    max-width: 46ch;
    margin: clamp(24px, 4svh, 44px) 0 0;
    font-size: clamp(17px, 1.4vw, 22px);
    line-height: 1.5;
    color: rgb(5 5 5 / 0.62);
  }

  .atajo__enlace {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    color: inherit;
    text-decoration: none;
  }

  /* Las dos frases ocupan la misma celda: una se va por arriba mientras la
     otra entra por abajo. El recorte es de la línea, no de cada letra. */
  .atajo__frases {
    /* Puede encoger: si no, una frase larga empujaba el círculo fuera de la
       pantalla por la derecha. */
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    /* Solo se recorta en vertical, que es lo que necesita el rodar de las
       letras: en horizontal, al crecer o seguir al ratón, cortaba el
       principio y el final de la frase. */
    overflow-x: visible;
    overflow-y: clip;
    font-family: ClashDisplay, InstrumentSans, sans-serif;
    font-size: clamp(30px, 5vw, 96px);
    /* Crecen un pelín más que la franja, para que se lea como que se
       acercan. El desplazamiento lateral (translate) lo pone el script. */
    transform-origin: 50% 50%;
    transition: scale 650ms cubic-bezier(0.16, 1, 0.3, 1);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .atajo__frase {
    grid-area: 1 / 1;
  }

  .atajo__palabra {
    display: inline-block;
    white-space: nowrap;
  }

  /* La respuesta entra centrada: no sustituye a la pregunta en su sitio,
     aparece como lo que es, otra cosa. Con menos apretura entre letras
     porque el trazo engorda cada una, y con el interletrado de la pregunta
     la exclamación final se montaba sobre la í. */
  .atajo__frase--respuesta {
    justify-self: center;
    text-align: center;
    letter-spacing: 0;
  }

  /* Detrás de una vocal con tilde, el signo de cierre necesita aire propio:
     el acento se sale de su caja por la derecha y, con el trazo, se
     pisaban ("aquí!"). Detrás de cualquier otra letra no hace falta. */
  .atajo__frase--respuesta .es-cierre {
    margin-inline-start: 0.2em;
  }

  .atajo__letra {
    display: inline-block;
    /* Escalonado: cada letra sale un poco después de la anterior, y así la
       frase rueda como un marcador en vez de saltar entera. */
    transition: translate 620ms cubic-bezier(0.7, 0, 0.2, 1) calc(var(--i) * 16ms);
  }

  /* El verde neón sobre claro se lava y no se lee: lleva un trazo negro
     fino por fuera, que le da el contorno sin oscurecer el color. */
  .atajo__frase--respuesta {
    color: var(--acento);
    -webkit-text-stroke: 1.5px #050505;
    paint-order: stroke fill;
  }

  .atajo__frase--respuesta .atajo__letra {
    translate: 0 110%;
  }

  .atajo__enlace:hover .atajo__frases,
  .atajo__enlace:focus-visible .atajo__frases {
    scale: 1.14;
  }

  .atajo__enlace:hover .atajo__frase--pregunta .atajo__letra,
  .atajo__enlace:focus-visible .atajo__frase--pregunta .atajo__letra {
    translate: 0 -110%;
  }

  .atajo__enlace:hover .atajo__frase--respuesta .atajo__letra,
  .atajo__enlace:focus-visible .atajo__frase--respuesta .atajo__letra {
    translate: 0 0;
  }

  .atajo__flecha {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(56px, 6vw, 96px);
    aspect-ratio: 1;
    border: 1px solid rgb(5 5 5 / 0.3);
    border-radius: 50%;
    transition:
      background-color 500ms ease,
      border-color 500ms ease,
      color 500ms ease,
      rotate 620ms cubic-bezier(0.7, 0, 0.2, 1);
  }

  .atajo__flecha svg {
    width: 38%;
    height: auto;
  }

  .atajo__enlace:hover .atajo__flecha,
  .atajo__enlace:focus-visible .atajo__flecha,
  .atajo[data-encendida] .atajo__flecha {
    background: var(--acento);
    border-color: var(--acento);
    color: #050505;
    rotate: 45deg;
  }

  .atajo__movil {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .atajo__letra,
    .atajo__flecha,
    .atajo__frases,
    .atajo::before {
      transition: none;
    }
  }

  /*
    En móvil no hay hover. La pregunta se queda (no rueda a la respuesta,
    que ni se ve) y de vez en cuando la recorre una ondulación suave: cada
    letra sube un poco y baja, en ola (lo dispara el script con
    data-boing). Y la flecha se enciende, con el halo que tiembla y el
    latido del cierre, mientras la franja pasa entre el 40 % y el 70 % de la
    pantalla (data-encendida): morada la primera vez, verde la siguiente, y
    así.
  */
  @media (hover: none), (max-width: 600px) {
    .atajo__frases {
      overflow-y: visible;
    }

    .atajo__frase--respuesta {
      display: none;
    }

    .atajo[data-boing] .atajo__frase--pregunta .atajo__letra {
      animation: ola 1300ms ease-in-out calc(var(--i) * 22ms) both;
    }

    .atajo[data-encendida] .atajo__flecha {
      animation:
        crepita 2.9s ease-in-out infinite,
        palpita 2.4s ease-in-out infinite;
    }
  }

  @keyframes ola {
    0%,
    100% {
      translate: 0 0;
    }
    45% {
      translate: 0 -0.12em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atajo[data-boing] .atajo__frase--pregunta .atajo__letra {
      animation: none;
    }
  }

  /* En la tablet en horizontal, la franja de en medio algo más alta. */
  @media (min-width: 601px) and (orientation: landscape) and (pointer: coarse) {
    .atajo:not(.atajo--cierre) {
      padding-block: clamp(48px, 7svh, 72px);
    }
  }
</style>

<script>
  /*
    Verde, morado, verde… El tono se decide al entrar, no al salir: así la
    respuesta sube ya con su color y se va con el mismo. Cada franja lleva
    su propia cuenta.
  */
  /*
    Las órbitas giran por script y no con una animación fija: cada punto va
    a su velocidad mientras se ve y al triple cuando sale de la pantalla,
    hasta justo antes de volver a asomar, para que no tarde en reaparecer.
    El cambio de velocidad es gradual. Solo mientras la franja se ve.
  */
  document.querySelectorAll<HTMLElement>('.atajo--orbitas').forEach((franja) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const sistema = franja.querySelector<SVGSVGElement>('.atajo__sistema')!;
    const orbitas = Array.from(franja.querySelectorAll<SVGGElement>('[data-orbita]')).map((g, k) => ({
      g,
      r: Number(g.dataset.r),
      grados: (360 / Number(g.dataset.segundos)) * Number(g.dataset.sentido),
      angulo: k * 140,
      marcha: 1,
    }));
    let bucle = 0;
    let anterior = 0;

    const paso = (ahora: number) => {
      const dt = anterior ? Math.min((ahora - anterior) / 1000, 0.05) : 0;
      anterior = ahora;
      // Centro y escala del sistema en pantalla: el SVG mide 520 unidades.
      const caja = sistema.getBoundingClientRect();
      const cx = caja.left + caja.width / 2;
      const cy = caja.top + caja.height / 2;
      const escala = caja.width / 520;
      const visible = franja.getBoundingClientRect();
      const izquierda = Math.max(0, visible.left);
      const derecha = Math.min(window.innerWidth, visible.right);
      const arriba = Math.max(0, visible.top);
      const abajo = Math.min(window.innerHeight, visible.bottom);

      for (const o of orbitas) {
        const rad = (o.angulo * Math.PI) / 180;
        const x = cx + Math.cos(rad) * o.r * escala;
        const y = cy + Math.sin(rad) * o.r * escala;
        // Un pelo de margen: acelera cuando ya no se ve nada del punto.
        const margen = 14 * escala;
        const fuera = x < izquierda - margen || x > derecha + margen || y < arriba - margen || y > abajo + margen;
        o.marcha += ((fuera ? 3 : 1) - o.marcha) * Math.min(dt * 8, 1);
        o.angulo = (o.angulo + o.grados * o.marcha * dt) % 360;
        o.g.setAttribute('transform', `rotate(${o.angulo.toFixed(2)})`);
      }
      bucle = requestAnimationFrame(paso);
    };

    new IntersectionObserver(([e]) => {
      if (e?.isIntersecting && !bucle) {
        anterior = 0;
        bucle = requestAnimationFrame(paso);
      } else if (!e?.isIntersecting && bucle) {
        cancelAnimationFrame(bucle);
        bucle = 0;
      }
    }).observe(franja);
  });

  // Las órbitas se centran en la flecha: se mide dónde cae dentro de la franja.
  document.querySelectorAll<HTMLElement>('.atajo--orbitas').forEach((franja) => {
    const flecha = franja.querySelector<HTMLElement>('.atajo__flecha')!;
    const medir = () => {
      const f = flecha.getBoundingClientRect();
      const c = franja.getBoundingClientRect();
      franja.style.setProperty('--ox', `${(f.left + f.width / 2 - c.left).toFixed(1)}px`);
      franja.style.setProperty('--oy', `${(f.top + f.height / 2 - c.top).toFixed(1)}px`);
    };
    medir();
    new ResizeObserver(medir).observe(franja);
  });

  document.querySelectorAll<HTMLElement>('[data-atajo]').forEach((franja) => {
    const enlace = franja.querySelector<HTMLElement>('.atajo__enlace')!;
    let veces = 0;
    const alternar = () => {
      franja.dataset.tono = veces % 2 === 0 ? 'verde' : 'morado';
      veces += 1;
    };
    enlace.addEventListener('pointerenter', alternar);
    enlace.addEventListener('focus', alternar);

    if (window.matchMedia('(hover: none), (max-width: 600px)').matches) {
      /*
        La flecha se enciende en morado mientras la franja pasa por la
        banda entre el 40 % y el 70 % del alto de la pantalla, contando
        desde arriba.
      */
      let encendidos = 0;
      new IntersectionObserver(
        ([e]) => {
          if (!e) return;
          if (e.isIntersecting && !franja.hasAttribute('data-encendida')) {
            franja.dataset.tono = encendidos % 2 === 0 ? 'morado' : 'verde';
            encendidos += 1;
          }
          franja.toggleAttribute('data-encendida', e.isIntersecting);
        },
        { rootMargin: '-40% 0px -30% 0px' },
      ).observe(franja);

      /*
        La ondulación de la pregunta: al aparecer la franja y luego cada
        dos segundos mientras se vea.
      */
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let repetir = 0;
        const boing = () => {
          franja.removeAttribute('data-boing');
          void franja.offsetWidth; // para que la animación vuelva a empezar
          franja.setAttribute('data-boing', '');
        };
        new IntersectionObserver(
          ([e]) => {
            clearInterval(repetir);
            if (!e?.isIntersecting) return;
            boing();
            repetir = window.setInterval(boing, 2000);
          },
          { threshold: 0.6 },
        ).observe(franja);
      }
    }
  });

  /*
    Las letras siguen al ratón en horizontal, con retraso, como si tuvieran
    peso: a la izquierda de la franja se van un poco a la izquierda, a la
    derecha, a la derecha. El círculo también, pero menos. Al salir vuelven
    al centro. Sin movimiento reducido.
  */
  const limitar = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conRaton = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (!quieto && conRaton) {
    document.querySelectorAll<HTMLElement>('[data-atajo]').forEach((franja) => {
      const frases = franja.querySelector<HTMLElement>('.atajo__frases')!;
      const flecha = franja.querySelector<HTMLElement>('.atajo__flecha')!;
      // Con órbitas, la flecha es su centro: no se mueve.
      const flechaQuieta = franja.classList.contains('atajo--orbitas');
      /** Cuánto se desplazan como mucho, en píxeles. */
      const RECORRIDO = 36;
      let destino = 0;
      let x = 0;
      let bucle = 0;
      let anterior = 0;

      const paso = (ahora: number) => {
        const dt = anterior ? limitar((ahora - anterior) / 16.67, 0, 2.5) : 1;
        anterior = ahora;
        x += (destino - x) * (1 - Math.pow(0.9, dt));
        frases.style.translate = `${x.toFixed(2)}px 0`;
        if (!flechaQuieta) flecha.style.translate = `${(x * 0.4).toFixed(2)}px 0`;
        bucle = Math.abs(destino - x) > 0.05 ? requestAnimationFrame(paso) : 0;
      };

      const arrancar = () => {
        if (bucle) return;
        anterior = 0;
        bucle = requestAnimationFrame(paso);
      };

      franja.addEventListener('pointermove', (evento) => {
        const caja = franja.getBoundingClientRect();
        destino = ((evento.clientX - caja.left) / caja.width - 0.5) * 2 * RECORRIDO;
        arrancar();
      });
      franja.addEventListener('pointerleave', () => {
        destino = 0;
        arrancar();
      });
    });
  }
</script>
