---
/**
 * Proyectos · el recorrido.
 *
 * La sección se queda clavada y el scroll vertical la recorre en horizontal,
 * como una línea de tiempo de montaje. Debajo, el indicador es literalmente
 * eso: una regla de editor de vídeo que se desliza bajo un cabezal fijo, con
 * la marca de cada obra pasando por debajo.
 */
import { obras, enlaceYouTube } from '../data/obras';
import ClipVideo from './ClipVideo.astro';
import BarraColor from './BarraColor.astro';

interface Props {
  /** La barra de color de arriba: solo cuando el módulo va tras el hero. */
  barra?: boolean;
  id?: string;
}

const { barra = true, id = 'proyectos' } = Astro.props;

const total = String(obras.length).padStart(2, '0');
/** Dónde cae cada obra en el recorrido, de 0 a 1: la primera al principio, la última al final. */
const posicion = (i: number) => (obras.length > 1 ? i / (obras.length - 1) : 0);
---

<section
  class="recorrido"
  aria-labelledby={`${id}-titulo`}
  data-recorrido
  data-cursor-zona
  style={`--n: ${obras.length}`}
>
  {barra && <BarraColor />}
  <div class="recorrido__fijo">
    <h2 class="recorrido__rotulo" id={`${id}-titulo`}>Proyectos destacados</h2>
    <div class="recorrido__escena">
      <div class="recorrido__pista" data-pista>
        {
          obras.map((obra, i) => (
            <a
              class="recorrido__pieza"
              href={enlaceYouTube(obra)}
              target="_blank"
              rel="noreferrer"
              data-proyecto={obra.slug}
            >
              <div class="recorrido__marco" data-origen data-cursor-ver>
                <ClipVideo clip={obra.slug} class="recorrido__video" />
              </div>
              <div class="recorrido__ficha">
                <span class="recorrido__num">
                  {String(i + 1).padStart(2, '0')} / {total}
                </span>
                <h3 class="recorrido__titulo">{obra.marca}</h3>
                <p class="recorrido__meta">
                  {[obra.titulo, obra.agencia, obra.ano, obra.papel].filter(Boolean).join(' · ')}
                </p>
              </div>
            </a>
          ))
        }
      </div>

      <div class="recorrido__indicador" aria-hidden="true">
        <div class="tl">
          <div class="tl__regla">
            {
              obras.map((obra, i) => (
                <span class="tl__clip" style={`--pos: ${posicion(i)}`} data-obra-i={i}>
                  {obra.marca}
                </span>
              ))
            }
          </div>
          <span class="tl__cabezal" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .recorrido {
    /*
      Va justo detrás del hero, que es una capa fija: este módulo se le echa
      encima como una lámina, con la sombra cayendo hacia arriba.

      Recorta con clip y no con hidden: hidden convertiría la sección en
      contenedor de scroll y el sticky de dentro dejaría de pegarse. Hace
      falta recortar porque el contenido entra ampliado y, sin recorte, se
      saldría por arriba encima del hero.
    */
    position: relative;
    z-index: 1;
    overflow: clip;
    /* 0 cuando el módulo asoma por abajo, 1 cuando ya está colocado. */
    --entrada: 1;
    background: #050505;
    color: #f4f1ec;
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    box-shadow: 0 -34px 80px -12px rgb(0 0 0 / 0.92);
    /* Una pantalla de scroll por obra: más corto y cada una pasa de largo,
       más largo y el gesto se hace pesado. */
    height: calc(var(--n) * 100svh);
    --progreso: 0;
    /* El morado neón de los puntos del hero. */
    --morado: #b660ff;
    --gutter: max(16px, 5.5vw);
  }

  .recorrido__fijo {
    position: sticky;
    inset-block-start: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    /* La columna mide la pantalla: sin esto la estira la pista, que es
       mucho más ancha, y el indicador de abajo se iría con ella. */
    grid-template-columns: minmax(0, 1fr);
    /*
      La misma entrada que el módulo de clientes: el contenido llega de
      frente, ampliado, y se va colocando según sube, como si aplastara al
      hero. Se escala lo de dentro y no la sección para que el fondo se quede
      quieto.
    */
    transform: scale(calc(1 + var(--zoom, 0.5) * (1 - var(--entrada))));
    transform-origin: 50% 0;
    /* Lo mismo abajo que lo que ocupa el rótulo arriba, para que la escena
       quede centrada en la pantalla y no en el hueco que deja el rótulo. */
    padding-block-end: clamp(48px, 7svh, 80px);
  }

  /*
    La pista y el indicador son UN bloque, centrado en vertical: el
    indicador va colgado de las fichas a una distancia fija, no pegado al
    borde de la pantalla. Así su sitio no depende del alto de la ventana.
  */
  .recorrido__escena {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 5svh, 64px);
    min-height: 0;
  }

  .recorrido__rotulo {
    margin: 0;
    padding: clamp(28px, 4svh, 48px) max(24px, 5.5vw) 0;
    font-size: clamp(10px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }

  .recorrido__pista {
    display: flex;
    align-items: center;
    gap: 5vw;
    padding-inline: var(--gutter);
    width: max-content;
    will-change: transform;
  }

  .recorrido__pieza {
    display: block;
    width: min(64vw, 1100px);
    color: inherit;
    text-decoration: none;
  }

  .recorrido__marco {
    aspect-ratio: 16 / 9;
    max-height: 52svh;
    overflow: hidden;
    border-radius: 4px;
    background: #111;
    transition: scale 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Al señalarlo crece un pelo: lo justo para decir que se puede pinchar. */
  .recorrido__pieza:hover .recorrido__marco,
  .recorrido__pieza:focus-visible .recorrido__marco {
    scale: 1.015;
  }

  :global(.recorrido__video) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .recorrido__ficha {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 20px;
    margin-block-start: 18px;
  }

  .recorrido__num {
    grid-row: span 2;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: rgb(255 255 255 / 0.45);
    font-variant-numeric: tabular-nums;
  }

  .recorrido__titulo {
    margin: 0;
    font-family: ClashDisplay, InstrumentSans, sans-serif;
    font-size: clamp(26px, 3.2vw, 56px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .recorrido__meta {
    margin: 8px 0 0;
    font-size: clamp(11px, 0.85vw, 13px);
    color: rgb(255 255 255 / 0.5);
  }

  .recorrido__indicador {
    margin-inline: var(--gutter);
  }

  /* ── La línea de montaje ──────────────────────────────────── */
  .tl {
    position: relative;
    height: 52px;
    overflow: hidden;
    /* Se funde por los lados: es una regla que sigue, no una caja. */
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }

  /*
    La regla mide dos pantallas y empieza en el centro. Se arrastra hacia la
    izquierda entera según avanzas, así que el cabezal, que no se mueve, va
    pasando por encima de cada obra. Las rayitas son fondos repetidos, no
    elementos: cientos de nodos para dibujar una regla serían un despilfarro.
  */
  .tl__regla {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: 200vw;
    translate: calc(var(--progreso) * -100%) 0;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.4) 0 1px, transparent 1px 80px) 0 100% / 100% 14px no-repeat,
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.18) 0 1px, transparent 1px 16px) 0 100% / 100% 7px no-repeat;
  }

  .tl__clip {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-start: calc(var(--pos) * 100%);
    translate: -50% 0;
    font-size: clamp(11px, 0.85vw, 13px);
    white-space: nowrap;
    color: rgb(255 255 255 / 0.35);
    transition: color 400ms ease;
  }

  .tl__clip[data-activo] {
    color: #f4f1ec;
  }

  .tl__cabezal {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: 2px;
    margin-inline-start: -1px;
    background: var(--morado);
  }

  .tl__cabezal::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    width: 10px;
    height: 10px;
    translate: -50% 0;
    border-radius: 0 0 50% 50%;
    background: var(--morado);
  }

  @media (prefers-reduced-motion: reduce) {
    .recorrido__fijo {
      transform: none;
    }

    .recorrido__marco {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .recorrido__pieza {
      width: 82vw;
    }
  }
</style>

<script>
  const limitar = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  document.querySelectorAll<HTMLElement>('[data-recorrido]').forEach((seccion) => {
    const pista = seccion.querySelector<HTMLElement>('[data-pista]')!;
    const marcas = Array.from(seccion.querySelectorAll<HTMLElement>('[data-obra-i]'));
    const total = seccion.querySelectorAll('[data-proyecto]').length;
    let pendiente = 0;
    let activa = -1;

    /*
      Del scroll vertical al desplazamiento horizontal. Va directo, sin
      muelle: es el propio scroll el que manda, y cualquier retraso añadido
      se notaría como que la pista no obedece a la rueda.
    */
    const actualizar = () => {
      pendiente = 0;
      const caja = seccion.getBoundingClientRect();
      const recorrible = caja.height - window.innerHeight;
      const progreso = recorrible > 0 ? limitar(-caja.top / recorrible, 0, 1) : 0;
      const sobrante = pista.scrollWidth - window.innerWidth;
      pista.style.transform = `translate3d(${-progreso * Math.max(0, sobrante)}px, 0, 0)`;
      seccion.style.setProperty('--progreso', progreso.toFixed(4));

      // La entrada: 0 con el canto del módulo en el borde de abajo, 1 al
      // llegar al de arriba. A partir de ahí se queda en 1 todo el recorrido.
      const entrada = limitar((window.innerHeight - caja.top) / window.innerHeight, 0, 1);
      seccion.style.setProperty('--entrada', entrada.toFixed(4));

      // La obra que está delante es la más cercana a su sitio en el recorrido.
      const ahora = Math.round(progreso * (total - 1));
      if (ahora !== activa) {
        activa = ahora;
        marcas.forEach((marca) => marca.toggleAttribute('data-activo', Number(marca.dataset.obraI) === ahora));
      }
    };

    const pedir = () => {
      if (!pendiente) pendiente = requestAnimationFrame(actualizar);
    };

    window.addEventListener('scroll', pedir, { passive: true });
    window.addEventListener('resize', pedir);
    actualizar();
  });
</script>
