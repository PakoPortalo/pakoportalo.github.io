---
/**
 * La tarjeta de visita: se abre encima de la página desde cualquier enlace
 * marcado con data-tarjeta (las franjas de contacto). Sin JavaScript esos
 * enlaces siguen llevando a /contacto.
 *
 * Una tarjeta de papel en vertical, con textura de grano. Por delante, un
 * punto de color verde difuminado, como tinta que se abre en el papel, y
 * el rótulo de siempre en vertical: PAKO PORTALO en Times New Roman
 * negrita algo condensada, con "Música & Diseño sonoro." en cursiva
 * montado encima. Por detrás, brutalista: correo, Instagram y teléfono,
 * centrados y en negro.
 *
 * Entra girando, se inclina en 3D siguiendo el ratón y, al hacer clic,
 * se da la vuelta.
 */
const correo = 'pakoportalo@gmail.com';
const instagram = 'pakoportalo';
const telefono = '+34 636 25 06 34';

/*
  El grano del papel: ruido fino en gris, en un SVG dentro del propio CSS.
  Se multiplica sobre el color del papel y sobre el punto verde.
*/
const grano = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.55 0'/></filter><rect width='100%' height='100%' filter='url(%23g)'/></svg>`,
).replace(/%2523/g, '%23')}")`;
---

<dialog class="tarjeta" data-tarjeta-dialogo aria-labelledby="tarjeta-nombre" style={`--grano: ${grano}`}>
  <div class="tarjeta__escena" data-escena>
    <div class="tarjeta__giro" data-giro>
      <section class="tarjeta__cara tarjeta__cara--frente" data-voltear>
        <span class="tarjeta__punto" aria-hidden="true"></span>
        <h2 class="tarjeta__rotulo" id="tarjeta-nombre">
          <span class="tarjeta__nombre">Pako</span>
          <span class="tarjeta__nombre">Portalo</span>
          <span class="tarjeta__lema">Música &amp; Diseño sonoro.</span>
        </h2>
        <span class="tarjeta__papel" aria-hidden="true"></span>
        <span class="tarjeta__brillo" aria-hidden="true"></span>
      </section>

      <section class="tarjeta__cara tarjeta__cara--dorso" aria-label="Contacto" data-voltear>
        <ul class="tarjeta__datos">
          <li>
            <a href={`mailto:${correo}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="1" />
                <path d="M3.5 6l8.5 7 8.5-7" />
              </svg>
              <span>{correo}</span>
            </a>
          </li>
          <li>
            <a href={`https://www.instagram.com/${instagram}/`} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.4" cy="6.6" r="1.1" class="tarjeta__lleno" />
              </svg>
              <span>@{instagram}</span>
            </a>
          </li>
          <li>
            <a href={`tel:${telefono.replace(/\s/g, '')}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M5 3.5h3.2l1.6 4.3-2.1 1.4a11 11 0 0 0 7.1 7.1l1.4-2.1 4.3 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z"
                />
              </svg>
              <span>{telefono}</span>
            </a>
          </li>
        </ul>
        <span class="tarjeta__papel" aria-hidden="true"></span>
        <span class="tarjeta__brillo" aria-hidden="true"></span>
      </section>
    </div>

    <button class="tarjeta__girar" type="button" data-voltear>↻ Dar la vuelta</button>
  </div>

  <button class="tarjeta__cerrar" type="button" data-cerrar-tarjeta>Cerrar</button>
</dialog>

<style>
  .tarjeta {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: #111;
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    --romana: 'Times New Roman', Times, 'Liberation Serif', 'Nimbus Roman', serif;
    --papel: #ecebe6;
    --tinta: #141414;
  }

  .tarjeta::backdrop {
    background: rgb(5 5 5 / 0.82);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .tarjeta[data-abierta]::backdrop {
    opacity: 1;
  }

  /* La escena da la perspectiva; el giro lleva la inclinación con el ratón
     (--rx, --ry) y la vuelta de la tarjeta (--vuelta). */
  .tarjeta__escena {
    display: grid;
    place-items: center;
    align-content: center;
    gap: clamp(18px, 3svh, 32px);
    height: 100%;
    perspective: 1600px;
  }

  /* En vertical, con la proporción de una tarjeta de 55 × 85 mm. */
  .tarjeta__giro {
    position: relative;
    height: min(560px, 72svh, calc(88vw / 0.647));
    aspect-ratio: 0.647;
    transform-style: preserve-3d;
    transform: rotateX(calc(var(--rx, 0) * 1deg)) rotateY(calc(var(--ry, 0) * 1deg + var(--vuelta, 0deg)));
    /* La entrada: llega de canto, de abajo y algo más pequeña. */
    opacity: 0;
    translate: 0 60px;
    scale: 0.85;
  }

  .tarjeta[data-abierta] .tarjeta__giro {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    transition:
      opacity 400ms ease,
      translate 900ms cubic-bezier(0.16, 1, 0.3, 1),
      scale 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta__cara {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 3px;
    background:
      radial-gradient(130% 90% at 20% 0%, #f4f3ef, transparent 65%),
      var(--papel);
    box-shadow:
      0 50px 70px -40px rgb(0 0 0 / 0.75),
      0 0 0 1px rgb(0 0 0 / 0.05);
    backface-visibility: hidden;
    cursor: pointer;
  }

  .tarjeta__cara--dorso {
    display: grid;
    place-items: center;
    transform: rotateY(180deg);
  }

  /*
    El grano, encima de todo lo impreso: multiplica, así oscurece un pelo
    el papel y deja el punto verde con textura, como tinta absorbida.
  */
  .tarjeta__papel {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--grano);
    background-size: 240px;
    mix-blend-mode: multiply;
    opacity: 0.8;
  }

  /* ── Delante: el punto y el rótulo ────────────────────────── */
  /*
    El punto: núcleo verde intenso que se abre en un halo menta y se
    pierde en el papel. Se mueve un poco con la inclinación, como si
    flotara bajo la superficie.
  */
  .tarjeta__punto {
    position: absolute;
    top: 8%;
    left: -6%;
    width: 92%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #10b884 0%,
      #2fd9a2 14%,
      rgb(95 247 198 / 0.62) 30%,
      rgb(95 247 198 / 0.24) 48%,
      rgb(95 247 198 / 0) 68%
    );
    filter: blur(5px) saturate(1.1);
    mix-blend-mode: multiply;
    translate: calc(var(--ry, 0) * -0.6px) calc(var(--rx, 0) * 0.6px);
  }

  /*
    El rótulo de "Quién soy" de antes, en vertical como en una tarjeta de
    imprenta: se lee de abajo arriba, pegado al borde derecho.
  */
  .tarjeta__rotulo {
    position: absolute;
    right: 7%;
    bottom: 6%;
    display: grid;
    justify-items: start;
    margin: 0;
    font-weight: normal;
    color: var(--tinta);
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  /*
    El nombre, condensado un pelo: Times New Roman no tiene versión
    estrecha, así que se aprieta con menos espacio entre letras y un 6 %
    menos de largo (en vertical, el largo es el alto).
  */
  .tarjeta__nombre {
    font-family: var(--romana);
    font-weight: 700;
    text-transform: uppercase;
    font-size: min(68px, 12svh);
    letter-spacing: -0.05em;
    line-height: 0.8;
    white-space: nowrap;
    transform: scaleY(0.94);
    transform-origin: 50% 0;
  }

  /*
    El lema se monta sobre el pie del nombre: chocan a propósito. Un
    contorno grueso del color del papel por debajo del relleno recorta el
    nombre donde lo pisa y deja un filo limpio alrededor de cada letra.
  */
  .tarjeta__lema {
    position: relative;
    margin-block-start: -0.5em;
    margin-inline-start: 0.5em;
    font-family: var(--romana);
    font-style: italic;
    font-size: min(27px, 4.8svh);
    letter-spacing: -0.035em;
    line-height: 1.1;
    white-space: nowrap;
    transform: scaleY(0.88);
    transform-origin: 50% 0;
    -webkit-text-stroke: 0.2em var(--papel);
    paint-order: stroke fill;
  }

  /* ── Detrás: el contacto, brutalista ──────────────────────── */
  .tarjeta__datos {
    display: grid;
    width: 86%;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 3px solid var(--tinta);
  }

  .tarjeta__datos li + li {
    border-block-start: 3px solid var(--tinta);
  }

  .tarjeta__datos a {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 18px 2px;
    color: var(--tinta);
    font-size: min(21px, 3.7svh);
    font-weight: 800;
    letter-spacing: -0.035em;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      padding 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta__datos a:hover,
  .tarjeta__datos a:focus-visible {
    padding-inline-start: 10px;
    background: var(--tinta);
    color: var(--papel);
    outline: none;
  }

  .tarjeta__datos svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .tarjeta__lleno {
    fill: currentColor;
    stroke: none;
  }

  /*
    El brillo: un punto de luz blanca que sigue la inclinación, mezclado
    suave con el papel. Es lo que hace que parezca un objeto.
  */
  .tarjeta__brillo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--lx, 50%) var(--ly, 50%), rgb(255 255 255 / 0.5), transparent 45%);
    mix-blend-mode: soft-light;
  }

  .tarjeta__girar,
  .tarjeta__cerrar {
    padding: 10px 0;
    border: 0;
    background: none;
    color: #f4f1ec;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 250ms ease;
  }

  .tarjeta__cerrar {
    position: absolute;
    inset-block-start: clamp(16px, 2.4vw, 32px);
    inset-inline-end: max(16px, 5.5vw);
  }

  :is(.tarjeta__girar, .tarjeta__cerrar):hover,
  :is(.tarjeta__girar, .tarjeta__cerrar):focus-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta__giro,
    .tarjeta[data-abierta] .tarjeta__giro {
      transition: none;
      translate: none;
      scale: none;
    }
  }
</style>

<script>
  const limitar = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  const dialogo = document.querySelector<HTMLDialogElement>('[data-tarjeta-dialogo]');

  if (dialogo) {
    const giro = dialogo.querySelector<HTMLElement>('[data-giro]')!;
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /** Cuánto se inclina como mucho, en grados. */
    const INCLINA = 14;

    let destinoX = 0;
    let destinoY = 0;
    let x = 0;
    let y = 0;
    /** La vuelta: 0 de frente, 180 del revés. Va con muelle. */
    let vuelta = 0;
    let vueltaDestino = 0;
    let velocidadVuelta = 0;
    let bucle = 0;
    let anterior = 0;
    let origen: HTMLElement | null = null;

    const paso = (ahora: number) => {
      const dt = anterior ? limitar((ahora - anterior) / 16.67, 0, 2.5) : 1;
      anterior = ahora;
      // Cuando el ratón no se mueve, la tarjeta flota sola un poco.
      const flotaX = Math.sin(ahora / 1700) * 0.12;
      const flotaY = Math.cos(ahora / 2100) * 0.1;
      x += (destinoX + flotaX - x) * (1 - Math.pow(0.9, dt));
      y += (destinoY + flotaY - y) * (1 - Math.pow(0.9, dt));
      velocidadVuelta += (vueltaDestino - vuelta) * 0.06 * dt;
      velocidadVuelta *= Math.pow(0.78, dt);
      vuelta += velocidadVuelta * dt;

      giro.style.setProperty('--ry', (x * INCLINA).toFixed(2));
      giro.style.setProperty('--rx', (-y * INCLINA).toFixed(2));
      giro.style.setProperty('--vuelta', `${vuelta.toFixed(2)}deg`);
      giro.style.setProperty('--lx', `${(50 + x * 45).toFixed(1)}%`);
      giro.style.setProperty('--ly', `${(50 + y * 45).toFixed(1)}%`);
      bucle = dialogo.open ? requestAnimationFrame(paso) : 0;
    };

    const abrir = (desde: HTMLElement) => {
      origen = desde;
      // Llega de canto y se endereza: la vuelta arranca girada.
      vuelta = quieto ? 0 : -70;
      vueltaDestino = 0;
      velocidadVuelta = 0;
      dialogo.showModal();
      requestAnimationFrame(() => dialogo.setAttribute('data-abierta', ''));
      if (!quieto && !bucle) {
        anterior = 0;
        bucle = requestAnimationFrame(paso);
      } else if (quieto) {
        giro.style.setProperty('--vuelta', '0deg');
      }
    };

    const cerrar = () => {
      dialogo.removeAttribute('data-abierta');
      window.setTimeout(() => {
        dialogo.close();
        origen?.focus({ preventScroll: true });
      }, 300);
    };

    document.addEventListener('click', (evento) => {
      if (evento.defaultPrevented || evento.button !== 0) return;
      if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
      const enlace = (evento.target as Element).closest<HTMLElement>('[data-tarjeta]');
      if (!enlace) return;
      evento.preventDefault();
      abrir(enlace);
    });

    dialogo.addEventListener('pointermove', (evento) => {
      destinoX = (evento.clientX / window.innerWidth - 0.5) * 2;
      destinoY = (evento.clientY / window.innerHeight - 0.5) * 2;
    });

    // Clic en la tarjeta (fuera de sus enlaces) o en el botón: se da la vuelta.
    dialogo.querySelectorAll('[data-voltear]').forEach((zona) =>
      zona.addEventListener('click', (evento) => {
        if ((evento.target as Element).closest('a')) return;
        vueltaDestino = vueltaDestino === 0 ? 180 : 0;
        if (quieto) giro.style.setProperty('--vuelta', `${vueltaDestino}deg`);
      }),
    );

    dialogo.querySelector('[data-cerrar-tarjeta]')!.addEventListener('click', cerrar);
    dialogo.addEventListener('cancel', (evento) => {
      evento.preventDefault();
      cerrar();
    });
    // Clic fuera de la tarjeta, en el fondo.
    dialogo.addEventListener('click', (evento) => {
      const t = evento.target as Element;
      if (t === dialogo || t.classList.contains('tarjeta__escena')) cerrar();
    });
  }
</script>
