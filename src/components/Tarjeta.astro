---
/**
 * La tarjeta de visita: se abre encima de la página desde cualquier enlace
 * marcado con data-tarjeta (las franjas de contacto). Sin JavaScript esos
 * enlaces siguen llevando a /contacto.
 *
 * Es una tarjeta que entra girando y luego se inclina en 3D siguiendo el
 * ratón, con un reflejo tornasolado (verde y morado, los de los puntos de
 * la web) que se mueve con la luz. Por delante, en papel claro, el nombre
 * en Times New Roman y el lema en cursiva. Por detrás, como el hero: el
 * mismo humo y unas pompas del mismo líquido (src/scripts/liquid/tarjeta.ts)
 * flotando por encima del correo, Instagram y el teléfono. Cada dato se
 * copia al portapapeles al pulsarlo.
 */
const correo = 'pakoportalo@gmail.com';
const instagram = 'pakoportalo';
const telefono = '+34 636 25 06 34';
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---

<dialog class="tarjeta" data-tarjeta-dialogo aria-labelledby="tarjeta-nombre">
  <div class="tarjeta__escena" data-escena>
    <div class="tarjeta__giro" data-giro>
      <section class="tarjeta__cara tarjeta__cara--frente" style={`--grano: url('${base}tarjeta/grano.webp')`}>
        <h2 class="tarjeta__nombre" id="tarjeta-nombre" data-nombre-tarjeta>
          <span data-texto="Pako">Pako</span>
          <span data-texto="Portalo">Portalo</span>
        </h2>
        <p class="tarjeta__lema">Música &amp; Diseño sonoro.</p>

        <div class="tarjeta__pie">
          <button class="tarjeta__boton" type="button" data-voltear>Contacto ↻</button>
        </div>
        <span class="tarjeta__punto" aria-hidden="true"></span>
        <span class="tarjeta__brillo" aria-hidden="true"></span>
      </section>

      <section class="tarjeta__cara tarjeta__cara--dorso" aria-label="Contacto">
        <canvas class="tarjeta__liquido" data-liquido-fondo aria-hidden="true"></canvas>

        <ul class="tarjeta__datos">
          {
            [
              { valor: correo, icono: 'correo' },
              { valor: `@${instagram}`, icono: 'instagram' },
              { valor: telefono, icono: 'telefono' },
            ].map((dato) => (
              <li>
                <button class="tarjeta__dato" type="button" data-copiar={dato.valor} aria-label={`Copiar ${dato.valor}`}>
                  {dato.icono === 'correo' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="5" width="18" height="14" rx="2.5" />
                      <path d="M4 7l8 6 8-6" />
                    </svg>
                  )}
                  {dato.icono === 'instagram' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4.2" />
                      <circle cx="17.4" cy="6.6" r="1.1" class="tarjeta__lleno" />
                    </svg>
                  )}
                  {dato.icono === 'telefono' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 3.5h3.2l1.6 4.3-2.1 1.4a11 11 0 0 0 7.1 7.1l1.4-2.1 4.3 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z" />
                    </svg>
                  )}
                  <span class="tarjeta__valor">{dato.valor}</span>
                  <span class="tarjeta__copiado" aria-hidden="true">
                    {[...'¡Copiado!'].map((letra, i) => (
                      <span style={`--i: ${i}`}>{letra}</span>
                    ))}
                  </span>
                </button>
              </li>
            ))
          }
        </ul>

        <canvas class="tarjeta__liquido tarjeta__liquido--brillo" data-liquido-brillo aria-hidden="true"></canvas>

        <div class="tarjeta__acciones">
          <button class="tarjeta__boton" type="button" data-voltear>↺ Atrás</button>
        </div>
        <span class="tarjeta__brillo" aria-hidden="true"></span>
      </section>
    </div>
  </div>

  <button class="tarjeta__cerrar" type="button" data-cerrar-tarjeta>Cerrar</button>
</dialog>

<style>
  .tarjeta {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    color: #050505;
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    --romana: 'Times New Roman', Times, 'Liberation Serif', 'Nimbus Roman', serif;
    --verde: #5ff7c6;
    --morado: #b660ff;
  }

  .tarjeta::backdrop {
    background: rgb(5 5 5 / 0.82);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .tarjeta[data-abierta]::backdrop {
    opacity: 1;
  }

  /* La escena da la perspectiva; el giro lleva la inclinación con el ratón
     (--rx, --ry) y la vuelta de la tarjeta (--vuelta). */
  .tarjeta__escena {
    display: grid;
    place-items: center;
    height: 100%;
    perspective: 1400px;
  }

  .tarjeta__giro {
    position: relative;
    width: min(600px, 88vw);
    aspect-ratio: 1.75;
    transform-style: preserve-3d;
    transform: rotateX(calc(var(--rx, 0) * 1deg)) rotateY(calc(var(--ry, 0) * 1deg + var(--vuelta, 0deg)));
    /* La entrada: llega de canto, de abajo y algo más pequeña. */
    opacity: 0;
    translate: 0 60px;
    scale: 0.85;
  }

  .tarjeta[data-abierta] .tarjeta__giro {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    transition:
      opacity 400ms ease,
      translate 900ms cubic-bezier(0.16, 1, 0.3, 1),
      scale 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta__cara {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto auto 1fr;
    padding: clamp(22px, 4vw, 40px);
    border-radius: 14px;
    overflow: hidden;
    /* Además del overflow: en 3D, los lienzos WebGL se saltaban las
       esquinas redondeadas; el clip-path las recorta igual. */
    clip-path: inset(0 round 14px);
    background:
      radial-gradient(120% 90% at 0% 0%, #fbf9f5, transparent 60%),
      #ece8e1;
    box-shadow:
      0 30px 80px -20px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(0 0 0 / 0.06);
  }

  /*
    Qué cara se ve lo decide el script según el ángulo (data-dorso), no
    backface-visibility: algún navegador aplana el 3D de la tarjeta y
    entonces enseñaba el frente en espejo en lugar del dorso.
  */
  .tarjeta__giro[data-dorso] .tarjeta__cara--frente,
  .tarjeta__giro:not([data-dorso]) .tarjeta__cara--dorso {
    visibility: hidden;
  }

  /*
    El papel del frente: el grano sacado de una foto de papel de verdad
    (solo el relieve, sin el viñeteado), en "overlay" sobre el color.
  */
  .tarjeta__cara--frente::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--grano) center / cover;
    mix-blend-mode: overlay;
    opacity: 0.15;
    pointer-events: none;
  }

  .tarjeta__cara--dorso {
    grid-template-rows: 1fr auto;
    transform: rotateY(180deg);
    background: #050505;
    color: #f4f1ec;
  }

  /* Lo del dorso, entre los dos lienzos del líquido. */
  .tarjeta__cara--dorso > :not(.tarjeta__liquido, .tarjeta__brillo) {
    position: relative;
    z-index: 1;
  }

  /* El tono de los datos al pasar el ratón: verde, luego morado, y así. */
  .tarjeta__cara--dorso {
    --acento: var(--verde);
  }

  .tarjeta__cara--dorso[data-tono='morado'] {
    --acento: var(--morado);
  }

  /*
    El nombre, condensado un pelo: Times New Roman no tiene versión
    estrecha, así que se aprieta con menos espacio entre letras y un 6 %
    menos de ancho. Pako y Portalo, muy juntos.
  */
  .tarjeta__nombre {
    display: grid;
    margin: 0;
    font-family: var(--romana);
    font-weight: 700;
    font-size: clamp(40px, 8vw, 76px);
    letter-spacing: -0.05em;
    line-height: 0.72;
    text-transform: uppercase;
  }

  .tarjeta__nombre span {
    position: relative;
    display: block;
    transform: scaleX(0.94);
    transform-origin: 0 50%;
  }

  /*
    El glitch del nombre, como el de "Quién soy": de vez en cuando un
    espasmo corto. El nombre da un par de tirones de pocos píxeles y dos
    copias, una roja y otra cian, saltan por franjas a los lados. Sobre
    el papel claro se multiplican en vez de sumarse. Lo dispara el script.
  */
  .tarjeta__nombre span::before,
  .tarjeta__nombre span::after {
    content: attr(data-texto);
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  /* Los colores del glitch de siempre: rojo y cian, como un RGB descolocado. */
  .tarjeta__nombre span::before {
    color: #ff1744;
  }

  .tarjeta__nombre span::after {
    color: #00e5ff;
  }

  .tarjeta__nombre[data-glitch] {
    animation: tarjeta-espasmo 280ms steps(1) both;
  }

  .tarjeta__nombre[data-glitch] span::before {
    animation: tarjeta-franja-a 280ms steps(1) both;
  }

  .tarjeta__nombre[data-glitch] span::after {
    animation: tarjeta-franja-b 280ms steps(1) both;
  }

  @keyframes tarjeta-espasmo {
    0% { translate: 0 0; transform: skewX(0deg); }
    15% { translate: -1.5px 0.5px; transform: skewX(-1.5deg); }
    30% { translate: 1px 0; transform: skewX(0deg); }
    50% { translate: -0.5px -0.5px; transform: skewX(1deg); }
    70% { translate: 1px 0.5px; transform: skewX(0deg); }
    85%, 100% { translate: 0 0; transform: skewX(0deg); }
  }

  @keyframes tarjeta-franja-a {
    0% { opacity: 0.55; translate: -2px 0; clip-path: inset(10% 0 62% 0); }
    25% { opacity: 0.5; translate: 1.5px 0; clip-path: inset(55% 0 20% 0); }
    50% { opacity: 0.45; translate: -1px 0; clip-path: inset(30% 0 48% 0); }
    75% { opacity: 0.4; translate: 2px 0; clip-path: inset(72% 0 6% 0); }
    100% { opacity: 0; translate: 0 0; clip-path: inset(0); }
  }

  @keyframes tarjeta-franja-b {
    0% { opacity: 0.55; translate: 2px 0; clip-path: inset(48% 0 30% 0); }
    25% { opacity: 0.45; translate: -1.5px 0; clip-path: inset(5% 0 75% 0); }
    50% { opacity: 0.5; translate: 1.5px 0; clip-path: inset(66% 0 12% 0); }
    75% { opacity: 0.35; translate: -2px 0; clip-path: inset(22% 0 58% 0); }
    100% { opacity: 0; translate: 0 0; clip-path: inset(0); }
  }

  /*
    El lema se monta sobre el pie del nombre: chocan a propósito, como en
    el antiguo "Quién soy". Un contorno grueso del color del papel por
    debajo del relleno (paint-order) recorta el nombre donde lo pisa y deja
    un filo limpio alrededor de cada letra. Condensado, para casar con él.
  */
  .tarjeta__lema {
    position: relative;
    justify-self: start;
    margin: -0.5em 0 0;
    font-family: var(--romana);
    font-style: italic;
    font-size: clamp(20px, 3.2vw, 32px);
    letter-spacing: -0.035em;
    line-height: 1.1;
    transform: scaleX(0.88);
    transform-origin: 0 50%;
    -webkit-text-stroke: 0.2em #ede9e3;
    paint-order: stroke fill;
  }

  /*
    El punto verde que sigue al cursor por el frente, como tinta que se
    abre en el papel: núcleo intenso, halo menta y nada en el borde. Se
    multiplica sobre todo, así el negro sigue negro y el papel se tiñe; la
    cara lo recorta, así que solo se ve dentro de la tarjeta.
  */
  .tarjeta__punto {
    position: absolute;
    left: var(--px, 50%);
    top: var(--py, 50%);
    width: 58%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgb(var(--punto-centro) / 0.85) 0%,
      rgb(var(--punto-halo) / 0.55) 20%,
      rgb(var(--punto-halo) / 0.22) 44%,
      rgb(var(--punto-halo) / 0) 68%
    );
    filter: blur(5px) saturate(1.1);
    mix-blend-mode: multiply;
    pointer-events: none;
    opacity: 0;
    scale: 0.7;
    transition:
      opacity 500ms ease,
      scale 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Verde una vez, morado la siguiente: cambia al abrir y al volver atrás. */
  .tarjeta__cara--frente {
    --punto-centro: 47 217 162;
    --punto-halo: 95 247 198;
  }

  .tarjeta__cara--frente[data-tono='morado'] {
    --punto-centro: 150 70 235;
    --punto-halo: 182 96 255;
  }

  .tarjeta__cara--frente[data-cursor] .tarjeta__punto {
    opacity: 0.85;
    scale: 1;
  }

  .tarjeta__pie {
    align-self: end;
    display: flex;
    justify-content: flex-end;
  }

  .tarjeta__boton {
    padding: 8px 14px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
    opacity: 0.75;
    transition:
      opacity 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }

  .tarjeta__boton:hover,
  .tarjeta__boton:focus-visible {
    opacity: 1;
  }

  /* ── El dorso: el contacto ────────────────────────────────── */
  .tarjeta__datos {
    align-self: center;
    display: grid;
    gap: clamp(8px, 1.6vw, 14px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tarjeta__datos li {
    display: flex;
  }

  /*
    Cada dato es un botón que lo copia. Al pasar el ratón crece un poco y
    se enciende en el tono del momento; al pulsarlo, el texto deja paso a
    "¡Copiado!" en el mismo sitio, un momento.
  */
  .tarjeta__dato {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 12px;
    padding: 2px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: clamp(16px, 2.6vw, 22px);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: left;
    cursor: pointer;
    transform-origin: 0 50%;
    transition:
      scale 400ms cubic-bezier(0.16, 1, 0.3, 1),
      color 250ms ease;
  }

  .tarjeta__dato:hover,
  .tarjeta__dato:focus-visible {
    scale: 1.06;
    color: var(--acento);
    outline: none;
  }

  /*
    El dato y el aviso comparten celda. Al copiar, el dato se va y las
    letras de "¡Copiado!" caen desde arriba una detrás de otra; al rato
    suben otra vez una detrás de otra, y entonces vuelve el dato.
  */
  .tarjeta__valor,
  .tarjeta__copiado {
    grid-area: 1 / 2;
  }

  .tarjeta__valor {
    transition: opacity 250ms ease 380ms;
  }

  .tarjeta__dato[data-copiado] .tarjeta__valor {
    opacity: 0;
    transition-delay: 0ms;
  }

  /* La letra de la web, en peso medio: ni negrita ni fina. */
  .tarjeta__copiado {
    display: flex;
    overflow: hidden;
    padding-block: 0.1em;
    font-weight: 500;
    letter-spacing: -0.01em;
    pointer-events: none;
  }

  .tarjeta__copiado span {
    display: inline-block;
    white-space: pre;
    opacity: 0;
    translate: 0 -110%;
    transition:
      translate 260ms cubic-bezier(0.5, 0, 0.75, 0),
      opacity 200ms ease;
    transition-delay: calc(var(--i) * 22ms);
  }

  .tarjeta__dato[data-copiado] .tarjeta__copiado span {
    opacity: 1;
    translate: 0 0;
    transition:
      translate 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms ease;
    transition-delay: calc(var(--i) * 26ms);
  }

  .tarjeta__datos svg {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  .tarjeta__lleno {
    fill: currentColor;
    stroke: none;
  }

  .tarjeta__acciones {
    display: flex;
    justify-content: flex-end;
  }

  /* El líquido: el lienzo de abajo con el humo, el de arriba con los
     brillos de las pompas, que no recibe clics. */
  .tarjeta__liquido {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tarjeta__liquido--brillo {
    z-index: 2;
  }

  /*
    El reflejo: un degradado tornasolado (verde y morado) que sigue a la
    luz, más un punto de brillo blanco, mezclados con la tarjeta. Es lo que
    hace que parezca un objeto y no un recuadro.
  */
  .tarjeta__brillo {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(circle at var(--lx, 50%) var(--ly, 50%), rgb(255 255 255 / 0.55), transparent 40%),
      linear-gradient(
        calc(115deg + var(--ry, 0) * 3deg),
        transparent 20%,
        rgb(95 247 198 / 0.1) 40%,
        rgb(182 96 255 / 0.1) 60%,
        transparent 80%
      );
    background-size: 100% 100%, 220% 220%;
    background-position: 0 0, var(--lx, 50%) var(--ly, 50%);
    mix-blend-mode: soft-light;
  }

  .tarjeta__cara--dorso .tarjeta__brillo {
    mix-blend-mode: screen;
    opacity: 0.35;
  }

  .tarjeta__cerrar {
    position: absolute;
    inset-block-start: clamp(16px, 2.4vw, 32px);
    inset-inline-end: max(16px, 5.5vw);
    padding: 10px 0;
    border: 0;
    background: none;
    color: #f4f1ec;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0.7;
  }

  .tarjeta__cerrar:hover,
  .tarjeta__cerrar:focus-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta__giro,
    .tarjeta[data-abierta] .tarjeta__giro {
      transition: none;
      translate: none;
      scale: none;
    }
  }
</style>

<script>
  import { crearLiquidoTarjeta, type LiquidoTarjeta } from '../scripts/liquid/tarjeta';

  const limitar = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  const dialogo = document.querySelector<HTMLDialogElement>('[data-tarjeta-dialogo]');

  if (dialogo) {
    const giro = dialogo.querySelector<HTMLElement>('[data-giro]')!;
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    /** Cuánto se inclina como mucho, en grados. */
    const INCLINA = 14;

    // El líquido del dorso: humo y pompas, como el hero.
    const dorso = dialogo.querySelector<HTMLElement>('.tarjeta__cara--dorso')!;
    let liquido: LiquidoTarjeta | null = null;
    try {
      liquido = crearLiquidoTarjeta(
        dialogo.querySelector<HTMLCanvasElement>('[data-liquido-fondo]')!,
        dialogo.querySelector<HTMLCanvasElement>('[data-liquido-brillo]')!,
      );
    } catch {
      liquido = null;
    }
    dorso.addEventListener('pointermove', (evento) => {
      const r = dorso.getBoundingClientRect();
      liquido?.raton((evento.clientX - r.left) / r.width, (evento.clientY - r.top) / r.height);
    });
    dorso.addEventListener('pointerleave', () => liquido?.raton(null, 0));

    // El punto del frente: persigue al cursor con retraso.
    const frente = dialogo.querySelector<HTMLElement>('.tarjeta__cara--frente')!;
    // Su color va alternando: verde la primera vez que se abre, morado al
    // volver atrás o al abrir otra vez, y así.
    let vecesPunto = 0;
    const alternarPunto = () => {
      frente.dataset.tono = vecesPunto % 2 === 0 ? 'verde' : 'morado';
      vecesPunto += 1;
    };
    const punto = { x: 50, y: 50, destinoX: 50, destinoY: 50, dentro: false };
    frente.addEventListener('pointermove', (evento) => {
      const r = frente.getBoundingClientRect();
      punto.destinoX = ((evento.clientX - r.left) / r.width) * 100;
      punto.destinoY = ((evento.clientY - r.top) / r.height) * 100;
      // Al entrar, aparece donde está el cursor, sin cruzar la tarjeta.
      if (!punto.dentro) {
        punto.x = punto.destinoX;
        punto.y = punto.destinoY;
        punto.dentro = true;
        frente.setAttribute('data-cursor', '');
      }
    });
    frente.addEventListener('pointerleave', () => {
      punto.dentro = false;
      frente.removeAttribute('data-cursor');
    });

    let destinoX = 0;
    let destinoY = 0;
    let x = 0;
    let y = 0;
    /** La vuelta: 0 de frente, 180 del revés. Va con muelle. */
    let vuelta = 0;
    let vueltaDestino = 0;
    let velocidadVuelta = 0;
    let bucle = 0;
    let anterior = 0;
    let origen: HTMLElement | null = null;

    /** De espaldas pasado el canto: con el ángulo entre 90° y 270°. */
    const mostrarCara = (angulo: number) => {
      const deEspaldas = Math.cos((angulo * Math.PI) / 180) < 0;
      giro.toggleAttribute('data-dorso', deEspaldas);
      // El líquido solo se anima con el dorso a la vista.
      liquido?.activar(deEspaldas && dialogo.open);
    };

    const paso = (ahora: number) => {
      const dt = anterior ? limitar((ahora - anterior) / 16.67, 0, 2.5) : 1;
      anterior = ahora;
      // Cuando el ratón no se mueve, la tarjeta flota sola un poco.
      const flotaX = Math.sin(ahora / 1700) * 0.12;
      const flotaY = Math.cos(ahora / 2100) * 0.1;
      x += (destinoX + flotaX - x) * (1 - Math.pow(0.9, dt));
      y += (destinoY + flotaY - y) * (1 - Math.pow(0.9, dt));
      velocidadVuelta += (vueltaDestino - vuelta) * 0.06 * dt;
      velocidadVuelta *= Math.pow(0.78, dt);
      vuelta += velocidadVuelta * dt;

      giro.style.setProperty('--ry', (x * INCLINA).toFixed(2));
      giro.style.setProperty('--rx', (-y * INCLINA).toFixed(2));
      giro.style.setProperty('--vuelta', `${vuelta.toFixed(2)}deg`);
      mostrarCara(vuelta + x * INCLINA);
      giro.style.setProperty('--lx', `${(50 + x * 45).toFixed(1)}%`);
      giro.style.setProperty('--ly', `${(50 + y * 45).toFixed(1)}%`);
      punto.x += (punto.destinoX - punto.x) * (1 - Math.pow(0.94, dt));
      punto.y += (punto.destinoY - punto.y) * (1 - Math.pow(0.94, dt));
      frente.style.setProperty('--px', `${punto.x.toFixed(2)}%`);
      frente.style.setProperty('--py', `${punto.y.toFixed(2)}%`);
      bucle = dialogo.open ? requestAnimationFrame(paso) : 0;
    };

    const abrir = (desde: HTMLElement) => {
      origen = desde;
      // Llega de canto y se endereza: la vuelta arranca girada.
      vuelta = quieto ? 0 : -70;
      vueltaDestino = 0;
      velocidadVuelta = 0;
      dialogo.showModal();
      alternarPunto();
      clearTimeout(glitch);
      if (!quieto) programarGlitch(0, 1500);
      requestAnimationFrame(() => dialogo.setAttribute('data-abierta', ''));
      if (!quieto && !bucle) {
        anterior = 0;
        bucle = requestAnimationFrame(paso);
      } else if (quieto) {
        giro.style.setProperty('--vuelta', '0deg');
      }
      mostrarCara(vuelta);
    };

    /*
      El glitch del nombre: el primero, al azar entre 0 y 1,5 s después de
      abrir; luego, uno cada 3 a 5 s mientras la tarjeta siga abierta.
    */
    const nombre = dialogo.querySelector<HTMLElement>('[data-nombre-tarjeta]')!;
    let glitch = 0;
    const espasmo = () => {
      nombre.removeAttribute('data-glitch');
      void nombre.offsetWidth; // para que la animación vuelva a empezar
      nombre.setAttribute('data-glitch', '');
    };
    nombre.addEventListener('animationend', (evento) => {
      if (evento.target === nombre) nombre.removeAttribute('data-glitch');
    });
    const programarGlitch = (desde: number, hasta: number) => {
      glitch = window.setTimeout(
        () => {
          espasmo();
          programarGlitch(3000, 5000);
        },
        desde + Math.random() * (hasta - desde),
      );
    };

    const cerrar = () => {
      dialogo.removeAttribute('data-abierta');
      liquido?.activar(false);
      clearTimeout(glitch);
      window.setTimeout(() => {
        dialogo.close();
        origen?.focus({ preventScroll: true });
      }, 300);
    };

    document.addEventListener('click', (evento) => {
      if (evento.defaultPrevented || evento.button !== 0) return;
      if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
      const enlace = (evento.target as Element).closest<HTMLElement>('[data-tarjeta]');
      if (!enlace) return;
      evento.preventDefault();
      abrir(enlace);
    });

    dialogo.addEventListener('pointermove', (evento) => {
      destinoX = (evento.clientX / window.innerWidth - 0.5) * 2;
      destinoY = (evento.clientY / window.innerHeight - 0.5) * 2;
    });

    dialogo.querySelectorAll('[data-voltear]').forEach((boton) =>
      boton.addEventListener('click', () => {
        vueltaDestino = vueltaDestino === 0 ? 180 : 0;
        if (vueltaDestino === 0) alternarPunto();
        if (quieto) {
          giro.style.setProperty('--vuelta', `${vueltaDestino}deg`);
          mostrarCara(vueltaDestino);
        }
      }),
    );

    /*
      Los datos: al pasar el ratón se encienden en verde, la siguiente vez
      en morado, y así, como la franja de contacto. Al pulsar, se copian.
    */
    let veces = 0;
    dialogo.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((dato) => {
      const alternar = () => {
        dorso.dataset.tono = veces % 2 === 0 ? 'verde' : 'morado';
        veces += 1;
      };
      dato.addEventListener('pointerenter', alternar);
      // Con el teclado sí; con el clic no, que si no el color cambiaba al copiar.
      let pulsado = false;
      dato.addEventListener('pointerdown', () => (pulsado = true));
      dato.addEventListener('focus', () => {
        if (!pulsado) alternar();
        pulsado = false;
      });

      let espera = 0;
      dato.addEventListener('click', async () => {
        const aviso = dato.querySelector('.tarjeta__copiado')!;
        // Cada letra en su caja, para que caigan y suban escalonadas.
        const escribir = (texto: string) => {
          aviso.replaceChildren(
            ...[...texto].map((letra, i) => {
              const caja = document.createElement('span');
              caja.textContent = letra;
              caja.style.setProperty('--i', String(i));
              return caja;
            }),
          );
        };
        try {
          await navigator.clipboard.writeText(dato.dataset.copiar!);
          if (aviso.textContent !== '¡Copiado!') escribir('¡Copiado!');
        } catch {
          escribir('¡No se pudo!');
        }
        void aviso.getBoundingClientRect(); // las letras nuevas parten de arriba
        dato.setAttribute('data-copiado', '');
        clearTimeout(espera);
        espera = window.setTimeout(() => dato.removeAttribute('data-copiado'), 1250);
      });
    });

    dialogo.querySelector('[data-cerrar-tarjeta]')!.addEventListener('click', cerrar);
    dialogo.addEventListener('cancel', (evento) => {
      evento.preventDefault();
      cerrar();
    });
    // Clic fuera de la tarjeta, en el fondo.
    dialogo.addEventListener('click', (evento) => {
      const t = evento.target as Element;
      if (t === dialogo || t.classList.contains('tarjeta__escena')) cerrar();
    });
  }
</script>
