---
import type { HeroCopy } from '../scripts/liquid/fonts';

interface Props {
  copy: HeroCopy;
}

const { copy } = Astro.props;
---

{/*
  El bloque de texto se dibuja DENTRO del canvas: el líquido tiene que poder
  refractarlo al pasar por encima, y eso solo es posible si forma parte de lo
  que se refracta. Lo que sí va en HTML es la barra de color y el icono, que
  son interfaz y ganan al verse nítidos.

  El bloque de respaldo mantiene el texto en el DOM para lectores de pantalla
  y buscadores, y es lo que se ve si no hay WebGL2.
*/}
{/*
  Diagnóstico de sensores. Solo aparece con ?gyro en la URL. Va FUERA del
  hero, ocupando su propio sitio: puesto encima tapaba justo lo que hay que
  mirar. Y escucha por su cuenta —no a través del hero— para que lo que
  informe sea lo que manda el aparato y no lo que el hero haya entendido.
*/}
<div class="probe" data-gyro-probe hidden>
  <button type="button" data-gyro-ask>Activar sensores</button>
  <pre data-gyro-out>…</pre>
</div>

<section class="hero" data-liquid-hero>
  {/*
    Todo lo que se ve del hero va dentro de una misma capa, para poder
    alejarlo como una sola pieza al hacer scroll. Escalando cada cosa por su
    lado se separarían entre ellas, que es lo contrario del efecto.
  */}
  <div class="hero__escena">
    <canvas class="hero__canvas" data-liquid-canvas aria-hidden="true"></canvas>

    <div class="hero__fallback">
      <p class="hero__eyebrow">{copy.eyebrowLeft} — {copy.eyebrowRight}</p>
      <h1 class="hero__title">{copy.title}</h1>
      <p class="hero__subtitle">{copy.subtitle}</p>
      <p class="hero__paragraph">{copy.paragraph}</p>
    </div>
  </div>

  {/*
    La señal de que hay más abajo. Va en el hero y no en la capa fija: así
    se va con el scroll y la tapa el módulo siguiente, en vez de quedarse
    flotando encima de todo.
  */}
  <span class="hero__bajar" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22">
      <path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
</section>

<style>
  /*
    El hero solo reserva su hueco en el flujo; lo que se ve va en una capa
    fija detrás. El módulo de abajo le pasa por encima y el hero se queda
    quieto, que es lo que hace que se lea como que se aleja.

    Se probó con position: sticky y daba problemas: el lienzo de WebGL se
    componía desplazado y dejaba una franja sin pintar arriba. Una capa fija
    no tiene ese problema y da el mismo resultado.
  */
  .hero {
    position: relative;
    width: 100%;
    /* Menos el grosor de la tira: así asoma por abajo nada más cargar, que es
       lo que anuncia que hay más página debajo. */
    height: calc(100svh - var(--barra));
    background: #050505;
    --gutter: max(24px, 5.5vw);
  }

  .hero__escena {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .hero.is-live .hero__canvas {
    opacity: 1;
  }

  .hero__fallback {
    position: absolute;
    inset-inline-start: var(--gutter);
    inset-block-end: calc(var(--gutter) + 18px);
    max-width: min(62%, 720px);
    color: #fff;
    font-family: Geist, ui-sans-serif, system-ui, sans-serif;
  }

  .hero__eyebrow {
    margin: 0 0 1.4em;
    font-size: clamp(9.5px, 0.85vw, 14px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
  }

  .hero__title,
  .hero__subtitle {
    font-size: clamp(32px, 8.2vw, 132px);
    line-height: 1;
    letter-spacing: -0.028em;
    margin: 0;
  }

  .hero__title { font-weight: 450; }
  .hero__subtitle { font-weight: 300; color: rgb(255 255 255 / 0.92); }

  .hero__paragraph {
    margin: 1.1em 0 0;
    font-size: clamp(12.5px, 1.3vw, 19px);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.62);
  }

  /* Con el canvas activo el texto lo dibuja él, pero sigue en el DOM. */
  .hero.is-live .hero__fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    max-width: none;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Diagnóstico de sensores. Temporal. */
  /* El display de la clase pisa al atributo hidden, así que hay que
     devolvérselo a mano o el panel sale siempre. */
  .probe[hidden] { display: none; }

  .probe {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: rgb(8 8 8 / 0.88);
    color: #fff;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    line-height: 1.5;
  }

  .probe :global(button) {
    appearance: none;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    font: inherit;
    font-size: 15px;
    padding: 14px;
    border-radius: 10px;
  }

  .probe :global(pre) {
    margin: 0;
    white-space: pre-wrap;
    color: rgb(255 255 255 / 0.85);
  }


  .hero__bajar {
    position: absolute;
    z-index: 1;
    inset-inline-start: 50%;
    inset-block-end: clamp(18px, 3svh, 32px);
    translate: -50% 0;
    color: rgb(255 255 255 / 0.7);
    pointer-events: none;
    animation: tira 1.8s ease-in-out infinite;
  }

  .hero__bajar svg {
    display: block;
  }

  /* Baja, se queda un instante abajo y vuelve: un tirón suave, no un bote. */
  @keyframes tira {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(7px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bajar {
      animation: none;
    }
  }
</style>

<script>
  import { createLiquidHero, type LiquidHandle } from '../scripts/liquid/hero';
  import { HERO_FONTS, type HeroCopy } from '../scripts/liquid/fonts';

  const section = document.querySelector<HTMLElement>('[data-liquid-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-liquid-canvas]');
  const fallback = document.querySelector<HTMLElement>('.hero__fallback');

  // Los textos se leen del propio DOM de respaldo: una sola fuente de verdad,
  // sin duplicarlos en un atributo data.
  function readCopy(): HeroCopy {
    const text = (selector: string) =>
      fallback?.querySelector(selector)?.textContent?.trim() ?? '';
    const [eyebrowLeft = '', eyebrowRight = ''] = text('.hero__eyebrow').split('—');
    return {
      eyebrowLeft: eyebrowLeft.trim(),
      eyebrowRight: eyebrowRight.trim(),
      title: text('.hero__title'),
      subtitle: text('.hero__subtitle'),
      paragraph: text('.hero__paragraph'),
    };
  }

  /**
   * Cuenta lo que el aparato manda de verdad por cada canal de sensores.
   *
   * Mide por su cuenta, sin pasar por el hero, para poder distinguir dos
   * cosas que desde fuera se parecen: que el móvil no emita nada, o que
   * emita y el hero no lo esté usando.
   */
  function mountProbe() {
    const panel = document.querySelector<HTMLElement>('[data-gyro-probe]');
    const out = document.querySelector<HTMLElement>('[data-gyro-out]');
    const button = document.querySelector<HTMLButtonElement>('[data-gyro-ask]');
    if (!panel || !out || !button) return;
    panel.hidden = false;

    type Gated = { requestPermission?: () => Promise<string> };
    const orientation =
      typeof DeviceOrientationEvent === 'undefined'
        ? undefined
        : (DeviceOrientationEvent as unknown as Gated);
    const motion =
      typeof DeviceMotionEvent === 'undefined'
        ? undefined
        : (DeviceMotionEvent as unknown as Gated);

    const counts = { orientation: 0, absolute: 0, motion: 0 };
    let last = '—';
    let granted = 'sin pedir';

    const report = () => {
      out.textContent = [
        `https (contexto seguro) : ${window.isSecureContext}`,
        `pointer: coarse         : ${matchMedia('(pointer: coarse)').matches}`,
        `puntos tactiles         : ${navigator.maxTouchPoints}`,
        `DeviceOrientationEvent  : ${orientation ? 'si' : 'NO'}  pide permiso: ${typeof orientation?.requestPermission === 'function'}`,
        `DeviceMotionEvent       : ${motion ? 'si' : 'NO'}  pide permiso: ${typeof motion?.requestPermission === 'function'}`,
        `permiso                 : ${granted}`,
        `navegador               : ${navigator.userAgent}`,
        `eventos orientation     : ${counts.orientation}`,
        `eventos absolute        : ${counts.absolute}`,
        `eventos motion          : ${counts.motion}`,
        `ultima lectura          : ${last}`,
      ].join('\n');
    };

    const onOrientation = (event: DeviceOrientationEvent, absolute: boolean) => {
      if (absolute) counts.absolute += 1;
      else counts.orientation += 1;
      last = `beta ${event.beta?.toFixed(1) ?? 'null'}  gamma ${event.gamma?.toFixed(1) ?? 'null'}`;
      report();
    };
    const onMotion = (event: DeviceMotionEvent) => {
      counts.motion += 1;
      const g = event.accelerationIncludingGravity;
      if (g) last = `gravedad x ${g.x?.toFixed(1) ?? 'null'}  y ${g.y?.toFixed(1) ?? 'null'}`;
      report();
    };

    const listen = () => {
      window.addEventListener('deviceorientation', (e) => onOrientation(e, false));
      window.addEventListener('deviceorientationabsolute', (e) =>
        onOrientation(e as DeviceOrientationEvent, true),
      );
      window.addEventListener('devicemotion', onMotion);
    };

    // El botón NO pide el permiso: solo hace de gesto, que es lo que el hero
    // necesita para pedirlo él. Pidiéndolo los dos, iOS deniega la segunda
    // petición y el diagnóstico acababa acusando al móvil de un problema que
    // causaba él mismo.
    window.addEventListener('hero:sensor', (event) => {
      granted = String((event as CustomEvent).detail);
      report();
    });

    // Y se escucha siempre, con permiso o sin él: si no lo hay no llega nada,
    // y si llega a haberlo los contadores lo cazan sin tener que reenganchar.
    listen();
    report();
  }

  /**
   * Aleja el hero a medida que se baja.
   *
   * Se escribe una sola variable en CSS y el resto lo resuelve la hoja de
   * estilos. Va dentro de requestAnimationFrame porque el evento de scroll se
   * dispara muchas más veces de las que hay fotogramas, y tocar estilos en
   * cada una obliga al navegador a recalcular de más.
   */
  function montarSalida(hero: LiquidHandle) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let pedido = false;

    const actualizar = () => {
      pedido = false;
      // El recorrido es una pantalla: bajada una, el alejamiento está al tope.
      const recorrido = Math.max(window.innerHeight, 1);
      const salida = Math.min(Math.max(window.scrollY / recorrido, 0), 1);
      hero.setZoom(1 - 0.24 * salida);
    };

    const alHacerScroll = () => {
      if (pedido) return;
      pedido = true;
      requestAnimationFrame(actualizar);
    };

    window.addEventListener('scroll', alHacerScroll, { passive: true });
    window.addEventListener('resize', alHacerScroll, { passive: true });
    actualizar();
  }

  if (section && canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const params = new URLSearchParams(location.search);
    // ?plain en la URL apaga el líquido para poder valorar la maquetación.
    const plain = params.has('plain');
    // Se puede cambiar de composición con ?marks=N sin tocar el código; no
    // hay interfaz para ello porque ya está elegida.
    const marks = Number(params.get('marks') ?? '5');
    if (params.has('gyro')) mountProbe();
    // ?water=cuentas suelta cada gota por su cuenta al inclinar el móvil.
    const water = params.get('water') === 'cuentas' ? 'cuentas' : 'masa';

    createLiquidHero(canvas, {
      copy: readCopy(),
      fonts: HERO_FONTS,
      reducedMotion,
      plain,
      marks,
      water,
    })
      .then((hero) => {
        section.classList.add('is-live');
        montarSalida(hero);
      })
      .catch((error) => {
        // Sin WebGL2 o si algo falla, se queda el hero de texto. Nada roto.
        console.warn('Hero líquido no disponible:', error);
      });
  }
</script>
