---
/**
 * Franja de credenciales, después de los proyectos destacados.
 *
 * Es un "mira con quién trabajo", no un módulo protagonista: compacta, con
 * los reconocimientos arriba y los logotipos debajo, cuatro por fila.
 * El humo de fondo la separa del módulo anterior, que es negro liso, sin
 * hacerla más alta.
 */
import HumoFondo from './HumoFondo.astro';
import { textos } from '../i18n/textos';

interface Props {
  id?: string;
}

const { id = 'creds' } = Astro.props;

interface Cliente {
  nombre: string;
  /**
   * Archivo dentro de /logos. Sin él, el nombre se compone en tipografía.
   * Así la fila no se rompe mientras falten archivos: cada logotipo que
   * aparezca sustituye a su nombre y el resto siguen funcionando.
   */
  logo?: string;
  /**
   * Alto relativo del logotipo.
   *
   * Los logotipos no se pueden poner todos al mismo alto: uno apaisado como
   * el de Red Bull mide cuatro veces más de ancho que de alto, y al mismo
   * alto que uno cuadrado pesaría el cuádruple.
   *
   * Los números están puestos a ojo y no con una fórmula. Probé a igualar el
   * área de cada uno y salió mal: un logotipo que es una palabra necesita
   * ancho para leerse, no área, y por área quedaban ilegibles justo los que
   * llevan letra fina.
   */
  escala?: number;
  /**
   * Para los de trazo muy fino. Necesitan ir menos apagados que uno macizo:
   * no es que estén más tenues, es que tienen menos tinta con la que estarlo.
   */
  tenue?: boolean;
}

interface Reconocimiento {
  /**
   * Finalista o nominado, con la palabra exacta que usa cada certamen.
   * El Sol llama "lista corta" a su selección de finalistas, y decir
   * "nominado" ahí sería decir algo que su palmarés no dice.
   */
  estado: string;
  /** Dónde: el festival y el año. */
  donde: string;
  /** Qué: la distinción, que es lo que hay que leer primero. */
  que: string;
  /**
   * La pieza. Se queda corta a propósito: comparte línea con el certamen, y
   * si una de las dos se alarga los bloques dejan de tener la misma silueta.
   */
  pieza: string;
  /** El mismo verde y morado de los puntos del hero. */
  color: 'verde' | 'morado';
}

const clientes: Cliente[] = [
  { nombre: 'Xiaomi', logo: 'xiaomi.png', escala: 0.34 },
  { nombre: 'BBVA', logo: 'bbva.svg', escala: 0.6 },
  { nombre: 'Red Bull', logo: 'redbull.svg', escala: 0.54 },
  { nombre: 'Junta de Andalucía', logo: 'junta.png', escala: 1.3 },
  { nombre: 'VivaGym', logo: 'vivagym.png', escala: 0.62 },
  { nombre: 'Mayumana', logo: 'mayumana.svg', escala: 1.15 },
  { nombre: 'Farmaindustria', logo: 'farmaindustria.png', escala: 1 },
  { nombre: 'Galicia R Televisión', logo: 'galiciar.png', escala: 0.5 },
  { nombre: 'Shaman Garage', logo: 'shamangarage.png', escala: 0.5, tenue: true },
  { nombre: 'Te falta calle', logo: 'tefaltacalle.png', escala: 0.82 },
];

const reconocimientos: Reconocimiento[] = [
  {
    estado: 'Finalista',
    donde: 'Festival El Sol 2026',
    // En inglés porque así se llama la categoría en el palmarés de El Sol.
    que: 'Sound Design',
    pieza: 'The Revelation',
    color: 'verde',
  },
  {
    estado: 'Nominado',
    donde: 'Dutch Game Awards 2024',
    // En inglés porque así se llama la categoría en su certamen.
    que: 'Best debut game',
    pieza: 'Data Garden',
    color: 'morado',
  },
];

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const t = textos(Astro.currentLocale);
---

<section class="creds" aria-labelledby={`${id}-titulo`}>
  <HumoFondo />

  <div class="creds__contenido">
    <h2 class="creds__titulo" id={`${id}-titulo`}>{t.creds.reconocimientos}</h2>

    <ul class="creds__premios">
      {
        reconocimientos.map((premio) => (
          <li class={`creds__premio creds__premio--${premio.color}`}>
            <p class="creds__estado">{premio.estado === 'Finalista' ? t.creds.finalista : t.creds.nominado}</p>
            <p class="creds__que">{premio.que}</p>
            <p class="creds__pieza">
              <span class="creds__certamen">{premio.donde}</span> · {premio.pieza}
            </p>
          </li>
        ))
      }
    </ul>

    <h2 class="creds__titulo creds__titulo--clientes">{t.creds.clientes}</h2>

    <ul class="creds__clientes">
      {
        clientes.map((cliente) => (
          <li>
            {cliente.logo ? (
              <img
                src={`${base}logos/${cliente.logo}`}
                alt={cliente.nombre}
                loading="lazy"
                class={cliente.tenue ? 'es-tenue' : undefined}
                style={`--escala: ${cliente.escala ?? 1}`}
              />
            ) : (
              <span class="creds__nombre">{cliente.nombre}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .creds {
    /*
      Por encima del hero, que va en una capa fija por detrás.
      La sombra cae hacia arriba, sobre el hero, y es lo que hace que este
      módulo se lea como una lámina que se le echa encima y no como otro
      trozo del mismo fondo.
    */
    position: relative;
    z-index: 1;
    overflow: hidden;
    box-shadow: 0 -34px 80px -12px rgb(0 0 0 / 0.92);
    /* 0 cuando el módulo asoma por abajo, 1 cuando ya está colocado. */
    --entrada: 1;
    /* La dispersión en reposo. Va aquí, en la sección, que es donde la
       cambia el script: declarada más abajo, en el contenido, tapaba la
       del script y el efecto no se movía nunca. */
    --dx: 0.3;
    --dy: 0;
    --gutter: max(24px, 5.5vw);
    /* Poco aire: es una franja de apoyo, no una pantalla. */
    padding: clamp(56px, 6vw, 104px) var(--gutter) clamp(88px, 9vw, 160px);
    background: #050505;
    color: #fff;
    /* Aquí manda la tipografía de titular y no la de texto.
       La de texto es muy fina, y a cuerpo pequeño en una pantalla grande se
       lee con esfuerzo. En el hero funciona porque va a cuerpos enormes. */
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    text-align: center;
  }

  /*
    El contenido llega de frente: entra un poco más grande y se va colocando
    según sube. Se escala el contenido y no la sección entera para que el
    fondo se quede quieto; escalando la sección, el propio fondo crecería y
    se vería el borde moverse.
  */
  /*
    Tres movimientos en una sola transformación:
    - la entrada: llega ampliado y se va colocando hasta un tamaño final
      algo mayor que el natural (--final);
    - el ratón: se desplaza hacia él (--mx, --my, en píxeles) y se inclina
      un poco (--rx, --ry, en grados), como la escena del hero;
    - la dispersión: ver más abajo.
    El origen va al centro: el zoom termina con el módulo centrado en la
    pantalla, y desde ahí es desde donde tiene que crecer.
  */
  .creds__contenido {
    position: relative;
    z-index: 1;
    transform: perspective(1400px) translate(calc(var(--mx, 0) * 1px), calc(var(--my, 0) * 1px))
      rotateX(calc(var(--rx, 0) * 1deg)) rotateY(calc(var(--ry, 0) * 1deg))
      scale(calc(var(--final, 1.06) + var(--zoom, 0.5) * (1 - var(--entrada))));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /*
    La dispersión de color, como la del hero: el contenido lleva siempre
    una capa roja y otra cian separadas apenas un pelo. Al mover el ratón
    se abren un poco en la dirección del movimiento y vuelven solas a su
    sitio. Las distancias (--dx, --dy, en píxeles) las pone el script.
    Los rótulos de sección se quedan limpios.
  */
  .creds__contenido {
    text-shadow:
      calc(var(--dx) * 1px) calc(var(--dy) * 1px) rgb(255 40 90 / 0.45),
      calc(var(--dx) * -1px) calc(var(--dy) * -1px) rgb(0 225 255 / 0.45);
  }

  .creds__titulo {
    text-shadow: none;
  }

  .creds__clientes img {
    --dispersion: drop-shadow(calc(var(--dx) * 1px) calc(var(--dy) * 1px) rgb(255 40 90 / 0.45))
      drop-shadow(calc(var(--dx) * -1px) calc(var(--dy) * -1px) rgb(0 225 255 / 0.45));
  }

  @media (prefers-reduced-motion: reduce) {
    .creds__contenido {
      transform: none;
    }
  }

  .creds__titulo {
    margin: 0 0 clamp(24px, 2.6vw, 40px);
    font-size: clamp(10px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }

  /*
    Cuatro por fila, y la última se queda centrada con las que sobren: con
    diez logotipos, 4 + 4 + 2. Con una rejilla de columnas fijas las dos
    últimas se irían a la izquierda y la fila quedaría coja.
  */
  .creds__clientes {
    margin: 0 auto;
    padding: 0;
    list-style: none;
    max-width: 1080px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: clamp(16px, 2vw, 40px);
    row-gap: clamp(22px, 2.4vw, 40px);
  }

  .creds__clientes li {
    flex: 0 0 calc(25% - clamp(16px, 2vw, 40px));
    min-height: clamp(30px, 3vw, 50px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
  }

  .creds__clientes img {
    /* Todos a blanco. Vienen cada uno de su color y de su fuente, y en una
       fila con seis tonos distintos lo que se lee es el desorden. */
    filter: brightness(0) invert(1) var(--dispersion);
    opacity: 0.66;
    /* Un punto por encima de la versión compacta, sin volver al tamaño de
       cuando el módulo ocupaba una pantalla entera. */
    height: calc(clamp(24px, 2.6vw, 46px) * var(--escala, 1));
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    /* El filtro sin transición: lleva la dispersión, que se mueve con el
       ratón a cada fotograma, y con transición iría siempre a la zaga. */
    transition: opacity 780ms ease;
  }

  /*
    El acercamiento va en la celda y no en la imagen.
    Aplicándolo solo a la imagen, en los que llevan palabra al lado —la R de
    Televisión— se acercaba el símbolo y la palabra se quedaba plantada.
  */
  .creds__clientes li {
    transition: transform 780ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .creds__clientes li:hover,
  .creds__clientes li:focus-within {
    transform: translateY(-2px) scale(1.02);
  }

  .creds__clientes li:hover img,
  .creds__clientes li:focus-within img {
    opacity: 0.92;
    filter: brightness(0) invert(1) drop-shadow(0 0 10px rgb(255 255 255 / 0.12)) var(--dispersion);
  }

  .creds__clientes li:hover span,
  .creds__clientes li:focus-within span {
    color: rgb(255 255 255 / 0.88);
    transition: color 780ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .creds__clientes li,
    .creds__clientes img {
      transition: none;
    }

    .creds__clientes li:hover {
      transform: none;
    }
  }

  .creds__clientes img.es-tenue {
    opacity: 0.82;
  }

  .creds__clientes span {
    font-size: clamp(14px, 1.3vw, 22px);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.66);
    white-space: nowrap;
  }

  .creds__nombre {
    font-size: clamp(16px, 1.5vw, 26px);
  }

  .creds__titulo--clientes {
    margin: clamp(36px, 4vw, 64px) auto clamp(24px, 2.6vw, 40px);
    padding-block-start: clamp(28px, 3vw, 48px);
    border-block-start: 1px solid rgb(255 255 255 / 0.1);
    max-width: 1080px;
  }

  .creds__premios {
    margin: 0 auto;
    padding: 0;
    max-width: 1080px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(30px, 3vw, 60px);
  }

  .creds__premio {
    display: grid;
    justify-items: center;
    gap: 7px;
    /* Al mismo ritmo que el color, para que sea un solo gesto y no dos. */
    transition: transform 950ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .creds__premio:hover,
  .creds__premio:focus-within {
    transform: scale(1.035);
  }

  @media (prefers-reduced-motion: reduce) {
    .creds__premio {
      transition: none;
    }

    .creds__premio:hover {
      transform: none;
    }
  }

  /*
    Al pasar por encima se enciende solo el nombre del certamen, no el bloque
    entero. Y despacio: casi un segundo. A la velocidad de un hover normal el
    cambio de color se lee como un parpadeo; así parece que va subiendo.
  */
  .creds__certamen {
    transition: color 950ms ease;
  }

  .creds__premio--verde:hover .creds__certamen,
  .creds__premio--verde:focus-within .creds__certamen {
    color: #5ff7c6;
  }

  .creds__premio--morado:hover .creds__certamen,
  .creds__premio--morado:focus-within .creds__certamen {
    color: #b660ff;
  }

  @media (prefers-reduced-motion: reduce) {
    .creds__certamen {
      transition: none;
    }
  }

  /*
    El punto va pegado al título, a su izquierda, y los dos se centran como
    un solo bloque. Encima del todo hacía de viñeta y separaba; al lado
    marca el título, que es lo que hay que leer primero.
  */
  .creds__que::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .creds__premio--verde .creds__que::before {
    background: #5ff7c6;
    box-shadow: 0 0 12px 3px rgb(95 247 198 / 0.45);
  }

  .creds__premio--morado .creds__que::before {
    background: #b660ff;
    box-shadow: 0 0 12px 3px rgb(182 96 255 / 0.45);
  }

  /*
    Una sola palabra arriba, el título en grande, y el detalle en una línea.
    Repartido de otra forma los dos bloques no rimaban: en uno la línea más
    ancha caía en el título y en el otro en la del medio, y aunque los dos
    tuvieran tres líneas, la silueta no era la misma.
  */
  .creds__estado {
    margin: 0 0 2px;
    font-size: clamp(9.5px, 0.75vw, 12px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }

  .creds__que {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    font-size: clamp(17px, 1.5vw, 25px);
    font-weight: 450;
    letter-spacing: -0.015em;
    color: #fff;
  }

  .creds__pieza {
    margin: 0;
    font-size: clamp(13px, 1vw, 16px);
    /* Bastante más marcada que antes: a menos opacidad esta línea se leía a
       duras penas, y es la que dice de qué trabajo se trata. */
    color: rgb(255 255 255 / 0.62);
  }

  @media (max-width: 760px) {
    .creds__clientes li {
      flex-basis: calc(33.333% - clamp(16px, 2vw, 40px));
    }

    .creds__premios {
      grid-template-columns: 1fr;
    }
  }

  /* En la tablet en vertical, algo más de aire arriba y abajo. */
  @media (min-width: 601px) and (max-width: 1100px) and (orientation: portrait) {
    .creds {
      padding-block: 120px 150px;
    }
  }
</style>

<script>
  const limitar = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  /**
   * El módulo de credenciales se mueve en tres capas, todas sobre variables
   * que lee el CSS:
   *
   * 1. La entrada. De 0 con el canto de arriba en el borde de abajo de la
   *    pantalla a 1 cuando el CENTRO del módulo llega al centro de la
   *    pantalla. Antes acababa al tocar arriba, y el zoom seguía corriendo
   *    con el módulo ya pasado de su sitio.
   * 2. El ratón. Como la escena del hero: el contenido se desplaza hacia
   *    él y se inclina un poco, con retraso.
   * 3. La dispersión de color, como la del hero: las capas roja y cian
   *    siempre un pelo separadas; al mover el ratón se abren un poco en su
   *    dirección y vuelven solas. Los rótulos de sección no la tienen.
   */
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conRaton = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('.creds').forEach((seccion) => {
    if (quieto) return;

    // ?zoom=0.7 en la URL para probar cuánto conviene sin tocar el código.
    const pedidoZoom = Number(new URLSearchParams(location.search).get('zoom'));
    if (Number.isFinite(pedidoZoom) && pedidoZoom > 0 && pedidoZoom <= 1.5) {
      seccion.style.setProperty('--zoom', String(pedidoZoom));
    }

    // ── 1 · La entrada ────────────────────────────────────────
    let pedido = false;
    // En el móvil y la tablet en vertical llega ya a su tamaño, sin zoom: recalcularlo en cada
    // fotograma de scroll hacía que el paso a este módulo fuera a tirones.
    const sinEntrada = window.matchMedia('(max-width: 600px), (max-width: 1100px) and (orientation: portrait)').matches;
    const entrar = () => {
      pedido = false;
      if (sinEntrada) {
        seccion.style.setProperty('--entrada', '1');
        return;
      }
      const alto = Math.max(window.innerHeight, 1);
      const caja = seccion.getBoundingClientRect();
      const final = alto / 2 - caja.height / 2;
      const avance = limitar((alto - caja.top) / Math.max(alto - final, 1), 0, 1);
      seccion.style.setProperty('--entrada', avance.toFixed(4));
    };
    const alHacerScroll = () => {
      if (pedido) return;
      pedido = true;
      requestAnimationFrame(entrar);
    };
    if (!sinEntrada) {
      window.addEventListener('scroll', alHacerScroll, { passive: true });
      window.addEventListener('resize', alHacerScroll, { passive: true });
    }
    entrar();

    /*
      Paralaje en la tablet en vertical: el contenido va algo más lento que
      el scroll, así se desliza a otra velocidad que los módulos de al lado.
      Se mueve con --my, el mismo desplazamiento que usa el ratón.
    */
    if (window.matchMedia('(min-width: 601px) and (max-width: 1100px) and (orientation: portrait)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let pedidoParalaje = false;
      const paralaje = () => {
        pedidoParalaje = false;
        const caja = seccion.getBoundingClientRect();
        const desvio = caja.top + caja.height / 2 - window.innerHeight / 2;
        seccion.style.setProperty('--my', (desvio * -0.22).toFixed(1));
      };
      window.addEventListener(
        'scroll',
        () => {
          if (pedidoParalaje) return;
          pedidoParalaje = true;
          requestAnimationFrame(paralaje);
        },
        { passive: true },
      );
      paralaje();
    }

    if (!conRaton) return;

    // ── 2 · El ratón ──────────────────────────────────────────
    /** Cuánto se desplaza como mucho, en píxeles, y cuánto se inclina, en grados. */
    const DESPLAZA = 14;
    const INCLINA = 2.5;
    let destinoX = 0;
    let destinoY = 0;
    let x = 0;
    let y = 0;
    let visible = false;
    let bucle = 0;
    let anterior = 0;

    // ── 3 · La dispersión ─────────────────────────────────────
    /** Separación en reposo, en píxeles: siempre hay un pelo de color. */
    const REPOSO = 0.3;
    /** Cuánto se abre como mucho con el ratón, en píxeles. */
    const MAXIMA = 1.5;
    let velX = 0;
    let velY = 0;
    let movX = 0;
    let movY = 0;

    const paso = (ahora: number) => {
      const dt = anterior ? limitar((ahora - anterior) / 16.67, 0, 2.5) : 1;
      anterior = ahora;
      x += (destinoX - x) * (1 - Math.pow(0.92, dt));
      y += (destinoY - y) * (1 - Math.pow(0.92, dt));
      seccion.style.setProperty('--mx', (x * DESPLAZA).toFixed(2));
      seccion.style.setProperty('--my', (y * DESPLAZA).toFixed(2));
      seccion.style.setProperty('--ry', (x * INCLINA).toFixed(3));
      seccion.style.setProperty('--rx', (-y * INCLINA).toFixed(3));

      /*
        La velocidad del ratón abre las capas en su dirección y luego se
        disipa sola: las capas vuelven a su sitio en algo menos de un
        segundo. Lo que se movió entre fotogramas entra en una media que
        se apaga, así un tirón suelto no da un salto.
      */
      velX = velX * Math.pow(0.88, dt) + movX * 0.12;
      velY = velY * Math.pow(0.88, dt) + movY * 0.12;
      movX = 0;
      movY = 0;
      const dx = REPOSO + limitar(velX * 0.12, -MAXIMA, MAXIMA);
      const dy = limitar(velY * 0.12, -MAXIMA, MAXIMA);
      seccion.style.setProperty('--dx', dx.toFixed(2));
      seccion.style.setProperty('--dy', dy.toFixed(2));

      bucle = visible ? requestAnimationFrame(paso) : 0;
    };

    let ultimo: { x: number; y: number } | null = null;
    window.addEventListener(
      'pointermove',
      (evento) => {
        if (!activo) return;
        destinoX = (evento.clientX / window.innerWidth - 0.5) * 2;
        destinoY = (evento.clientY / window.innerHeight - 0.5) * 2;
        if (ultimo) {
          movX += evento.clientX - ultimo.x;
          movY += evento.clientY - ultimo.y;
        }
        ultimo = { x: evento.clientX, y: evento.clientY };
      },
      { passive: true },
    );

    /*
      Solo responde al ratón cuando es el módulo que se está mirando: el
      que cruza la línea del centro de la pantalla. Si no, asomando un
      borde mientras se lee otro módulo, se movía con ese ratón. Al dejar
      de serlo, vuelve a su sitio despacio.
    */
    let activo = false;
    new IntersectionObserver(
      ([entrada]) => {
        activo = Boolean(entrada?.isIntersecting);
        if (!activo) {
          destinoX = 0;
          destinoY = 0;
          ultimo = null;
        }
      },
      { rootMargin: '-50% 0px -50% 0px' },
    ).observe(seccion);

    // Solo se anima mientras se ve.
    new IntersectionObserver(([entrada]) => {
      visible = Boolean(entrada?.isIntersecting);
      if (visible && !bucle) {
        anterior = 0;
        bucle = requestAnimationFrame(paso);
      }
    }).observe(seccion);
  });
</script>
