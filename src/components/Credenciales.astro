---
/**
 * Franja de credenciales, justo debajo del hero.
 *
 * Va aquí y no al final por una razón: quien entra decide en unos segundos si
 * esto es para él, y esa decisión la toma con los nombres, no con el
 * portfolio. Enterrarla abajo es pedirle que se convenza solo y darle la
 * prueba después.
 */

interface Cliente {
  nombre: string;
  /**
   * Archivo dentro de /logos. Sin él, el nombre se compone en tipografía.
   * Así la fila no se rompe mientras falten archivos: cada logotipo que
   * aparezca sustituye a su nombre y el resto siguen funcionando.
   */
  logo?: string;
  /**
   * Alto relativo del logotipo.
   *
   * Los logotipos no se pueden poner todos al mismo alto: uno apaisado como
   * el de Red Bull mide cuatro veces más de ancho que de alto, y al mismo
   * alto que uno cuadrado pesaría el cuádruple.
   *
   * Los números están puestos a ojo y no con una fórmula. Probé a igualar el
   * área de cada uno y salió mal: un logotipo que es una palabra necesita
   * ancho para leerse, no área, y por área quedaban ilegibles justo los que
   * llevan letra fina.
   */
  escala?: number;
  /** Palabra que acompaña al logotipo cuando el símbolo no dice el nombre. */
  coletilla?: string;
  /**
   * Para los de trazo muy fino. Necesitan ir menos apagados que uno macizo:
   * no es que estén más tenues, es que tienen menos tinta con la que estarlo.
   */
  tenue?: boolean;
  /**
   * Conserva los tonos en vez de pasarlo a blanco plano.
   *
   * Para los que dependen del contraste interno: el de Xiaomi es una "MI"
   * blanca calada sobre un cuadrado de color, y aplanándolo a blanco el
   * cuadrado se traga las letras y queda un bloque. En gris aclarado el
   * cuadrado se queda a medio tono, la "MI" sigue siendo blanca, y el
   * conjunto convive con los demás sin desentonar.
   */
  tonos?: boolean;
}

interface Reconocimiento {
  /** Dónde: el festival y el año. */
  donde: string;
  /** Qué: la distinción, que es lo que hay que leer primero. */
  que: string;
  /** Sobre qué pieza, y con quién. */
  pieza: string;
  /** El mismo verde y morado de los puntos del hero. */
  color: 'verde' | 'morado';
}

const clientes: Cliente[] = [
  { nombre: 'Xiaomi', logo: 'xiaomi.png', escala: 0.72, tonos: true },
  { nombre: 'BBVA', logo: 'bbva.svg', escala: 0.6 },
  { nombre: 'Red Bull', logo: 'redbull.svg', escala: 0.54 },
  { nombre: 'Junta de Andalucía', logo: 'junta.png', escala: 1.3 },
  { nombre: 'VivaGym', logo: 'vivagym.png', escala: 0.62 },
  { nombre: 'Mayumana', logo: 'mayumana.svg', escala: 1.15 },
  { nombre: 'Farmaindustria', logo: 'farmaindustria.png', escala: 1 },
  { nombre: 'Galicia R', logo: 'galiciar.svg', escala: 0.95, coletilla: 'Televisión' },
  { nombre: 'Shaman Garage', logo: 'shamangarage.png', escala: 0.85, tenue: true },
  { nombre: 'Te falta calle', logo: 'tefaltacalle.png', escala: 1 },
];

const reconocimientos: Reconocimiento[] = [
  {
    donde: 'Festival El Sol 2026',
    que: 'Lista corta en Sound Design',
    pieza: 'The Revelation · Casanova para la Junta de Andalucía',
    color: 'verde',
  },
  {
    donde: 'Dutch Game Awards 2024',
    que: 'Nominado a mejor juego debut',
    pieza: 'Data Garden · Shaman Garage',
    color: 'morado',
  },
];

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---

<section class="creds" aria-labelledby="creds-titulo">
  <h2 class="creds__titulo" id="creds-titulo">Han contado conmigo</h2>

  <ul class="creds__clientes">
    {
      clientes.map((cliente) => (
        <li>
          {cliente.logo ? (
            <>
              <img
                src={`${base}logos/${cliente.logo}`}
                alt={cliente.nombre}
                loading="lazy"
                class={[cliente.tenue && 'es-tenue', cliente.tonos && 'es-tonos']
                  .filter(Boolean)
                  .join(' ')}
                style={`--escala: ${cliente.escala ?? 1}`}
              />
              {cliente.coletilla && <span>{cliente.coletilla}</span>}
            </>
          ) : (
            <span class="creds__nombre">{cliente.nombre}</span>
          )}
        </li>
      ))
    }
  </ul>

  <ul class="creds__premios">
    {
      reconocimientos.map((premio) => (
        <li class={`creds__premio creds__premio--${premio.color}`}>
          <p class="creds__donde">{premio.donde}</p>
          <p class="creds__que">{premio.que}</p>
          <p class="creds__pieza">{premio.pieza}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .creds {
    --gutter: max(24px, 5.5vw);
    padding: clamp(72px, 9vw, 150px) var(--gutter) clamp(64px, 8vw, 130px);
    background: #050505;
    color: #fff;
    /* Aquí manda la tipografía de titular y no la de texto.
       La de texto es muy fina, y a cuerpo pequeño en una pantalla grande se
       lee con esfuerzo. En el hero funciona porque va a cuerpos enormes. */
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    text-align: center;
  }

  .creds__titulo {
    margin: 0 0 clamp(40px, 4.5vw, 72px);
    font-size: clamp(10px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.4);
  }

  /*
    Cuatro por fila, y la última se queda centrada con las que sobren.
    Con una rejilla de cuatro columnas fijas, las dos últimas se irían a la
    izquierda y la fila quedaría coja.
  */
  .creds__clientes {
    margin: 0 auto;
    padding: 0;
    list-style: none;
    max-width: 1080px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: clamp(16px, 2vw, 40px);
    row-gap: clamp(34px, 3.6vw, 62px);
  }

  .creds__clientes li {
    flex: 0 0 calc(25% - clamp(16px, 2vw, 40px));
    min-height: clamp(32px, 3.4vw, 58px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
  }

  .creds__clientes img {
    /* Todos a blanco. Vienen cada uno de su color y de su fuente, y en una
       fila con seis tonos distintos lo que se lee es el desorden. */
    filter: brightness(0) invert(1);
    opacity: 0.66;
    height: calc(clamp(28px, 3.1vw, 54px) * var(--escala, 1));
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .creds__clientes img.es-tenue {
    opacity: 0.82;
  }

  .creds__clientes img.es-tonos {
    filter: grayscale(1) brightness(1.55);
    opacity: 0.78;
  }

  .creds__clientes span {
    font-size: clamp(14px, 1.3vw, 22px);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.66);
    white-space: nowrap;
  }

  .creds__nombre {
    font-size: clamp(16px, 1.5vw, 26px);
  }

  .creds__premios {
    margin: clamp(56px, 6vw, 108px) auto 0;
    padding: clamp(36px, 3.6vw, 60px) 0 0;
    border-block-start: 1px solid rgb(255 255 255 / 0.1);
    max-width: 1080px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(30px, 3vw, 60px);
  }

  .creds__premio {
    display: grid;
    justify-items: center;
    gap: 7px;
  }

  .creds__premio::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-block-end: 12px;
  }

  .creds__premio--verde::before {
    background: #5ff7c6;
    box-shadow: 0 0 12px 3px rgb(95 247 198 / 0.45);
  }

  .creds__premio--morado::before {
    background: #b660ff;
    box-shadow: 0 0 12px 3px rgb(182 96 255 / 0.45);
  }

  .creds__donde {
    margin: 0;
    font-size: clamp(9.5px, 0.75vw, 12px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.42);
  }

  .creds__que {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 25px);
    font-weight: 450;
    letter-spacing: -0.015em;
    color: #fff;
  }

  .creds__pieza {
    margin: 0;
    font-size: clamp(13px, 1vw, 16px);
    /* Bastante más marcada que antes: a menos opacidad esta línea se leía a
       duras penas, y es la que dice de qué trabajo se trata. */
    color: rgb(255 255 255 / 0.62);
  }

  @media (max-width: 760px) {
    .creds__clientes li {
      flex-basis: calc(50% - clamp(16px, 2vw, 40px));
    }

    .creds__premios {
      grid-template-columns: 1fr;
    }
  }
</style>
