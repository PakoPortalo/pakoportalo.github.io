---
/**
 * Franja de credenciales, justo debajo del hero.
 *
 * Va aquí y no al final por una razón: quien entra decide en unos segundos si
 * esto es para él, y esa decisión la toma con los nombres, no con el
 * portfolio. Enterrarla abajo es pedirle que se convenza solo y darle la
 * prueba después.
 */

interface Cliente {
  nombre: string;
  /**
   * Archivo dentro de /logos. Sin él, el nombre se compone en tipografía.
   * Así la fila no se rompe mientras falten archivos: cada logotipo que
   * aparezca sustituye a su nombre y el resto siguen funcionando.
   */
  logo?: string;
  /**
   * Alto relativo del logotipo.
   *
   * Los logotipos no se pueden poner todos al mismo alto: uno apaisado como
   * el de Red Bull mide cuatro veces más de ancho que de alto, y al mismo
   * alto que uno cuadrado pesaría el cuádruple en la fila.
   *
   * Los números están puestos a ojo y no con una fórmula. Probé a igualar el
   * área de cada uno y salió mal: un logotipo que es una palabra necesita
   * ancho para leerse, no área, y por área quedaban ilegibles justo los que
   * llevan letra fina.
   */
  escala?: number;
  /**
   * Pinta el nombre al lado del logotipo. Para las marcas cuyo símbolo no
   * dice su nombre: el de Xiaomi es una "MI", y suelto no se lee "Xiaomi".
   */
  conNombre?: boolean;
  /**
   * Para los de trazo muy fino. A la misma opacidad que un logotipo macizo
   * casi desaparecen: no es que estén más apagados, es que tienen menos
   * tinta con la que estarlo.
   */
  tenue?: boolean;
}

interface Reconocimiento {
  texto: string;
  detalle: string;
  /** El mismo verde y morado de los puntos del hero. */
  color: 'verde' | 'morado';
}

const clientes: Cliente[] = [
  { nombre: 'Red Bull', logo: 'redbull.svg', escala: 0.52 },
  { nombre: 'BBVA', logo: 'bbva.svg', escala: 0.58 },
  { nombre: 'Xiaomi', logo: 'xiaomi.svg', escala: 1.05, conNombre: true },
  // La Junta, Sickhouse y Te falta calle siguen en tipografía: del primero
  // solo hay en abierto el escudo antiguo, que a este tamaño es una mancha,
  // y de los otros dos no hay archivo en ninguna fuente abierta.
  { nombre: 'Junta de Andalucía' },
  { nombre: 'VivaGym', logo: 'vivagym.png', escala: 0.6 },
  { nombre: 'Mayumana', logo: 'mayumana.svg', escala: 1.15 },
  { nombre: 'Farmaindustria', logo: 'farmaindustria.png', escala: 1.0 },
  { nombre: 'Sickhouse' },
  { nombre: 'Galicia R', logo: 'galiciar.svg', escala: 0.95, conNombre: true },
  { nombre: 'Shaman Garage', logo: 'shamangarage.png', escala: 0.8, tenue: true },
  { nombre: 'Te falta calle' },
];

const reconocimientos: Reconocimiento[] = [
  {
    texto: 'Lista corta — Festival El Sol 2026',
    detalle: 'Producción Craft / Film Craft / Sound Design, por The Revelation',
    color: 'verde',
  },
  {
    texto: 'Nominado a mejor debut — Dutch Game Awards 2024',
    detalle: 'Por Data Garden, de Shaman Garage',
    color: 'morado',
  },
];

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---

<section class="creds" aria-labelledby="creds-titulo">
  <h2 class="creds__titulo" id="creds-titulo">Han contado conmigo</h2>

  <ul class="creds__clientes">
    {
      clientes.map((cliente) =>
        cliente.logo ? (
          <li class="creds__marca">
            <img
              src={`${base}logos/${cliente.logo}`}
              alt={cliente.conNombre ? '' : cliente.nombre}
              loading="lazy"
              class={cliente.tenue ? 'es-tenue' : undefined}
              style={`--escala: ${cliente.escala ?? 1}`}
            />
            {cliente.conNombre && <span>{cliente.nombre}</span>}
          </li>
        ) : (
          <li class="creds__nombre">{cliente.nombre}</li>
        ),
      )
    }
  </ul>

  <ul class="creds__premios">
    {
      reconocimientos.map((premio) => (
        <li class={`creds__premio creds__premio--${premio.color}`}>
          <span class="creds__texto">{premio.texto}</span>
          <span class="creds__detalle">{premio.detalle}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .creds {
    --gutter: max(24px, 5.5vw);
    padding: clamp(56px, 7vw, 110px) var(--gutter) clamp(48px, 6vw, 90px);
    background: #050505;
    color: #fff;
    /* Las mismas dos del hero y con el mismo reparto: la de titular para los
       nombres, que son lo que tiene que pesar, y la de texto para el resto. */
    font-family: ClashDisplay, ui-sans-serif, system-ui, sans-serif;
    border-block-start: 1px solid rgb(255 255 255 / 0.08);
  }

  .creds__titulo {
    margin: 0 0 clamp(24px, 2.6vw, 40px);
    font-size: clamp(9.5px, 0.85vw, 13px);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .creds__clientes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    /* El hueco entre nombres hace de separador: con una línea o un punto en
       medio, diez nombres se leerían como una lista de la compra. */
    column-gap: clamp(28px, 3.4vw, 64px);
    row-gap: clamp(14px, 1.4vw, 22px);
  }

  .creds__clientes li {
    display: flex;
    align-items: center;
  }

  .creds__nombre {
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(17px, 1.75vw, 30px);
    font-weight: 380;
    letter-spacing: -0.015em;
    color: rgb(255 255 255 / 0.72);
    white-space: nowrap;
  }

  .creds__marca {
    gap: 0.45em;
  }

  .creds__marca span {
    font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(17px, 1.75vw, 30px);
    font-weight: 380;
    letter-spacing: -0.015em;
    color: rgb(255 255 255 / 0.72);
    white-space: nowrap;
  }

  .creds__marca img {
    /* Todos a blanco. Vienen cada uno de su color y de su fuente, y en una
       fila con seis tonos distintos lo que se lee es el desorden, no las
       marcas. En negativo sobre negro además es como se usan casi siempre. */
    filter: brightness(0) invert(1);
    opacity: 0.66;
    height: calc(clamp(26px, 2.6vw, 44px) * var(--escala, 1));
    width: auto;
    max-width: clamp(120px, 15vw, 240px);
    object-fit: contain;
    display: block;
  }

  .creds__marca img.es-tenue {
    opacity: 1;
  }

  .creds__premios {
    margin: clamp(40px, 4.4vw, 72px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(14px, 1.4vw, 20px);
  }

  .creds__premio {
    display: grid;
    /* El punto en su propia columna para que las dos líneas de texto queden
       alineadas entre sí y no colgando del punto. */
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    align-items: baseline;
  }

  .creds__premio::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    /* Desplazado para que caiga a la altura de la equis, no de la base. */
    transform: translateY(-2px);
  }

  .creds__premio--verde::before {
    background: #5ff7c6;
    box-shadow: 0 0 10px 2px rgb(95 247 198 / 0.5);
  }

  .creds__premio--morado::before {
    background: #b660ff;
    box-shadow: 0 0 10px 2px rgb(182 96 255 / 0.5);
  }

  .creds__texto {
    font-size: clamp(14px, 1.15vw, 19px);
    color: rgb(255 255 255 / 0.9);
  }

  .creds__detalle {
    grid-column: 2;
    font-size: clamp(12.5px, 0.95vw, 15px);
    color: rgb(255 255 255 / 0.48);
  }
</style>
