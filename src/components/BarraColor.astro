---
/**
 * La barra de color que hace de filo entre el hero y el módulo que le sigue.
 *
 * Va en el canto de arriba de ese módulo, no en el hero: en el hero se
 * quedaba fija detrás y el módulo se la comía al subir. Puesta aquí, sube con
 * él. El módulo que la lleve tiene que tener position: relative.
 *
 * El tramo de color sigue al ratón en horizontal con inercia, como si
 * colgara de un muelle: se pasa un poco al pararse el ratón y vuelve; si el ratón sale de la ventana, se queda donde
 * estaba. Antes de mover el ratón, cada barra está en su sitio. Guiño
 * a las tiras de control de color de imprenta.
 */
interface Props {
  /** Volteada en horizontal: el orden de los colores, al revés. */
  invertida?: boolean;
}

const { invertida = false } = Astro.props;
---

<div class:list={['barra-color', invertida && 'barra-color--invertida']} aria-hidden="true"></div>

<style>
  /*
    --c es el centro del tramo de color, en porcentaje del ancho. Lo mueve
    el script en :root, así todas las barras van a la vez. Los colores van
    de c-26% a c+20%, se blanquean en c+26% y se apagan en c+36%; por la
    izquierda, el mismo apagado en espejo. Todas esas distancias se
    multiplican por --e, el ancho, que también mueve el script.
  */
  .barra-color {
    position: absolute;
    z-index: 2;
    inset-inline: 0;
    inset-block-start: 0;
    height: var(--barra);
    --c: var(--barra-centro, 26%);
    /* El ancho del tramo: se estira en movimiento y se recoge en reposo. */
    --e: var(--barra-ancho, 0.85);
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.12) calc(var(--c) - 36% * var(--e)),
      rgb(255 255 255 / 0.5) calc(var(--c) - 30% * var(--e)),
      #18c6d4 calc(var(--c) - 26% * var(--e)),
      #2f3ad0 calc(var(--c) - 14% * var(--e)),
      #7b2fd0 calc(var(--c) - 4% * var(--e)),
      #d92b6a calc(var(--c) + 5% * var(--e)),
      #e8603a calc(var(--c) + 13% * var(--e)),
      #e8e030 calc(var(--c) + 20% * var(--e)),
      rgb(255 255 255 / 0.5) calc(var(--c) + 26% * var(--e)),
      rgb(255 255 255 / 0.12) calc(var(--c) + 36% * var(--e))
    );
  }

  /* Volteada, el centro va en espejo para que siga igual al ratón. */
  .barra-color--invertida {
    scale: -1 1;
    --c: calc(100% - var(--barra-centro, 74%));
  }
</style>

<script>
  /*
    Un solo bucle para todas las barras: el centro persigue la posición del
    ratón con retraso. Sin movimiento reducido ni en táctil, se queda fija.
  */
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conRaton = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const raiz = document.documentElement;

  if (!quieto && conRaton && !raiz.dataset.barraColor) {
    raiz.dataset.barraColor = '';
    let destino = 26;
    let x = 26;
    /** Ancho del tramo: 0,85 quieto, hasta 1,35 moviéndose rápido. */
    let ancho = 0.85;
    /** Velocidad del tramo, en % del ancho por fotograma. */
    let velocidad = 0;
    let primera = true;
    let bucle = 0;
    let anterior = 0;

    const paso = (ahora: number) => {
      const dt = anterior ? Math.min((ahora - anterior) / 16.67, 2.5) : 1;
      anterior = ahora;
      /*
        Un muelle poco amortiguado: el tramo tiene inercia, así que si el
        ratón se para de golpe sigue un poco hacia delante, se frena como
        un elástico y vuelve. La pérdida se eleva a dt para que vaya igual
        con fotogramas perdidos.
      */
      velocidad += (destino - x) * 0.018 * dt;
      velocidad *= Math.pow(0.88, dt);
      x += velocidad * dt;
      // Cuanto más rápido va, más se estira; al pararse se recoge despacio.
      const metaAncho = 0.85 + Math.min(Math.abs(velocidad) * 0.25, 0.5);
      const k = metaAncho > ancho ? 0.18 : 0.05;
      ancho += (metaAncho - ancho) * (1 - Math.pow(1 - k, dt));
      raiz.style.setProperty('--barra-centro', `${x.toFixed(2)}%`);
      raiz.style.setProperty('--barra-ancho', ancho.toFixed(3));
      const quietaYa =
        Math.abs(destino - x) < 0.05 && Math.abs(velocidad) < 0.01 && Math.abs(0.85 - ancho) < 0.003;
      bucle = quietaYa ? 0 : requestAnimationFrame(paso);
    };

    const arrancar = () => {
      if (bucle) return;
      anterior = 0;
      bucle = requestAnimationFrame(paso);
    };

    window.addEventListener(
      'pointermove',
      (evento) => {
        destino = (evento.clientX / window.innerWidth) * 100;
        // La primera vez arranca desde donde estaba la barra, no de un salto.
        if (primera) {
          primera = false;
          x = 26;
        }
        arrancar();
      },
      { passive: true },
    );
  }
</script>
