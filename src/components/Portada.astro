---
/**
 * La portada entera, en el idioma de la página que la monta: / (español)
 * o /en (inglés). Los textos salen de src/i18n/textos.ts.
 */
import HeroLiquid from './HeroLiquid.astro';
import Credenciales from './Credenciales.astro';
import ProyectosRecorrido from './ProyectosRecorrido.astro';
import ProyectosLista from './ProyectosLista.astro';
import ContactoAtajo from './ContactoAtajo.astro';
import Encargos from './Encargos.astro';
import QuienSoy from './QuienSoy.astro';
import Tarjeta from './Tarjeta.astro';
import Pie from './Pie.astro';
import VentanaProyecto from './VentanaProyecto.astro';
import CursorRastro from './CursorRastro.astro';
import { textos } from '../i18n/textos';
import '../styles/global.css';

const t = textos(Astro.currentLocale);
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---

<!doctype html>
<html lang={t.html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.titulo}</title>
    <meta name="description" content={t.meta.descripcion} />
    {/* Las dos versiones se señalan entre sí, para los buscadores. */}
    <link rel="alternate" hreflang="es" href={new URL(base, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}en/`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <meta name="theme-color" content="#050505" />
    {/*
      El idioma según dónde estás: en España, español; fuera, inglés. La
      web es estática, sin servidor que vea el país, así que se usa la zona
      horaria del aparato (Madrid, Canarias o Ceuta). Va lo primero, antes
      de pintar nada, para que el salto no se vea. Si alguien elige idioma
      en el pie, eso manda siempre. A los buscadores no se les redirige: así
      indexan las dos versiones.
    */}
    <script is:inline define:vars={{ lang: t.html, base }}>
      (() => {
        try {
          if (/bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)) return;
          const elegido = localStorage.getItem('idioma');
          const zona = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          const espana = ['Europe/Madrid', 'Atlantic/Canary', 'Africa/Ceuta'].includes(zona);
          const quiere = elegido === 'es' || elegido === 'en' ? elegido : espana ? 'es' : 'en';
          if (quiere !== lang) location.replace(base + (quiere === 'en' ? 'en/' : '') + location.search + location.hash);
        } catch {}
      })();
    </script>
    <style>
      body { margin: 0; background: #050505; }
    </style>
  </head>
  <body>
    <HeroLiquid
      copy={{
        eyebrowLeft: t.hero.eyebrowLeft,
        eyebrowRight: t.hero.eyebrowRight,
        title: t.hero.title,
        subtitle: t.hero.subtitle,
        paragraph: t.hero.paragraph,
      }}
    />
    <ProyectosRecorrido />
    <ProyectosLista />
    <ContactoAtajo />
    <Encargos fondo="montaje" opacidadFondo={0.3} />
    <Credenciales />
    <QuienSoy />
    <ContactoAtajo
      id="contacto"
      pregunta={t.cierre.pregunta}
      respuesta={t.cierre.respuesta}
      texto={t.cierre.texto}
      conOrbitas
    />
    <Pie />

    <VentanaProyecto />
    <Tarjeta />
    <CursorRastro />
  </body>
</html>
