---
/**
 * La portada entera, en el idioma de la página que la monta: / (español)
 * o /en (inglés). Los textos salen de src/i18n/textos.ts.
 */
import HeroLiquid from './HeroLiquid.astro';
import Credenciales from './Credenciales.astro';
import ProyectosRecorrido from './ProyectosRecorrido.astro';
import ProyectosLista from './ProyectosLista.astro';
import ContactoAtajo from './ContactoAtajo.astro';
import Encargos from './Encargos.astro';
import QuienSoy from './QuienSoy.astro';
import Tarjeta from './Tarjeta.astro';
import Pie from './Pie.astro';
import VentanaProyecto from './VentanaProyecto.astro';
import CursorRastro from './CursorRastro.astro';
import { textos } from '../i18n/textos';
import '../styles/global.css';

const t = textos(Astro.currentLocale);
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');

const aqui = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL(`${base}${t.meta.imagen}`, Astro.site).href;
const otroLocale = t.meta.locale === 'es_ES' ? 'en_GB' : 'es_ES';

/** Quién es, para los buscadores (schema.org). */
const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pako Portalo',
  url: new URL(base, Astro.site).href,
  image: new URL(`${base}sobre/pako-1-persona.webp`, Astro.site).href,
  jobTitle: t.meta.rol,
  description: t.meta.descripcion,
  email: 'mailto:pakoportalo@gmail.com',
  sameAs: ['https://www.instagram.com/pakoportalo/'],
  knowsAbout: ['Music composition', 'Sound design', 'Video game music', 'Advertising music'],
};
---

<!doctype html>
<html lang={t.html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.titulo}</title>
    <meta name="description" content={t.meta.descripcion} />
    <link rel="canonical" href={aqui} />
    <meta name="author" content="Pako Portalo" />

    {/* Iconos. */}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    {/* Al compartir el enlace (WhatsApp, LinkedIn, X, Slack…). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pako Portalo" />
    <meta property="og:title" content={t.meta.titulo} />
    <meta property="og:description" content={t.meta.descripcion} />
    <meta property="og:url" content={aqui} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={t.meta.imagenAlt} />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={otroLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.titulo} />
    <meta name="twitter:description" content={t.meta.descripcion} />
    <meta name="twitter:image" content={imagen} />
    <meta name="twitter:image:alt" content={t.meta.imagenAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(persona)} />
    {/* Las dos versiones se señalan entre sí, para los buscadores. */}
    <link rel="alternate" hreflang="es" href={new URL(base, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}en/`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <meta name="theme-color" content="#050505" />
    {/*
      El idioma según dónde estás: en España, español; fuera, inglés. La
      web es estática, sin servidor que vea el país, así que se usa la zona
      horaria del aparato (Madrid, Canarias o Ceuta). Va lo primero, antes
      de pintar nada, para que el salto no se vea. Si alguien elige idioma
      en el pie, eso manda siempre. A los buscadores no se les redirige: así
      indexan las dos versiones.
    */}
    <script is:inline define:vars={{ lang: t.html, base }}>
      (() => {
        try {
          if (/bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)) return;
          const elegido = localStorage.getItem('idioma');
          const zona = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          const espana = ['Europe/Madrid', 'Atlantic/Canary', 'Africa/Ceuta'].includes(zona);
          const quiere = elegido === 'es' || elegido === 'en' ? elegido : espana ? 'es' : 'en';
          if (quiere !== lang) location.replace(base + (quiere === 'en' ? 'en/' : '') + location.search + location.hash);
        } catch {}
      })();
    </script>
    <style>
      body { margin: 0; background: #050505; }
    </style>
  </head>
  <body>
    <HeroLiquid
      copy={{
        eyebrowLeft: t.hero.eyebrowLeft,
        eyebrowRight: t.hero.eyebrowRight,
        title: t.hero.title,
        subtitle: t.hero.subtitle,
        paragraph: t.hero.paragraph,
      }}
    />
    <ProyectosRecorrido />
    <ProyectosLista />
    <ContactoAtajo />
    <Encargos fondo="montaje" opacidadFondo={0.3} />
    <Credenciales />
    <QuienSoy />
    <ContactoAtajo
      id="contacto"
      pregunta={t.cierre.pregunta}
      respuesta={t.cierre.respuesta}
      texto={t.cierre.texto}
      conOrbitas
    />
    <Pie />

    <VentanaProyecto />
    <Tarjeta />
    <CursorRastro />
  </body>
</html>
