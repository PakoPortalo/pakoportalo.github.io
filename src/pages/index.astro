---
import HeroLiquid from '../components/HeroLiquid.astro';
import Credenciales from '../components/Credenciales.astro';
import ProyectosRecorrido from '../components/ProyectosRecorrido.astro';
import ContactoAtajo from '../components/ContactoAtajo.astro';
import Encargos from '../components/Encargos.astro';
import VentanaProyecto from '../components/VentanaProyecto.astro';
import CursorRastro from '../components/CursorRastro.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pako Portalo — Composición musical y diseño sonoro</title>
    <meta
      name="description"
      content="Composiciones originales para videojuegos y spots publicitarios, y diseño sonoro para piezas audiovisuales: del cine al teatro."
    />
    <meta name="theme-color" content="#050505" />
    <style>
      body { margin: 0; background: #050505; }
    </style>
  </head>
  <body>
    <HeroLiquid
      copy={{
        eyebrowLeft: 'Composición musical',
        eyebrowRight: 'Diseño sonoro',
        title: 'Pako Portalo.',
        subtitle: 'Sound & Music.',
        paragraph:
          'Composiciones originales para videojuegos y spots publicitarios, y diseño sonoro para piezas audiovisuales: del cine al teatro.',
      }}
    />
    <ProyectosRecorrido />
    <ContactoAtajo />
    <Encargos fondo="montaje" opacidadFondo={0.3} />
    <Credenciales />
    <ContactoAtajo id="contacto" pregunta="¿Hablamos de tu proyecto?" respuesta="¡Escríbeme!" />

    <VentanaProyecto />
    <CursorRastro />
  </body>
</html>
