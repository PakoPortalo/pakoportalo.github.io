---
import HeroLiquid from '../components/HeroLiquid.astro';
import Credenciales from '../components/Credenciales.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pako Portalo — Composición musical y diseño sonoro</title>
    <meta
      name="description"
      content="Composiciones originales para spots y videojuegos, diseño sonoro para cine, y la mezcla que hace que todo encaje con la imagen."
    />
    <meta name="theme-color" content="#050505" />
    <style>
      body { margin: 0; background: #050505; }
    </style>
  </head>
  <body>
    <HeroLiquid
      copy={{
        eyebrowLeft: 'Composición musical',
        eyebrowRight: 'Diseño sonoro',
        title: 'Pako Portalo.',
        subtitle: 'Sonido & Música.',
        paragraph:
          'Composiciones originales para spots y videojuegos, diseño sonoro para cine, y la mezcla que hace que todo encaje con la imagen.',
      }}
    />
    <Credenciales />
  </body>
</html>
