---
/**
 * Página no encontrada. En negro como la portada, con un solo camino: volver.
 */
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada — Pako Portalo</title>
    <meta name="theme-color" content="#050505" />
    <style is:global>
      body {
        margin: 0;
        background: #050505;
        color: #f4f1ec;
        font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body>
    <main class="perdida">
      <p class="perdida__codigo" aria-hidden="true">404</p>
      <h1 class="perdida__titulo">Aquí no suena nada.</h1>
      <p class="perdida__texto">La página que buscas no existe o ha cambiado de sitio.</p>
      <a class="perdida__volver" href={base}>Volver al inicio <span aria-hidden="true">→</span></a>
    </main>
  </body>
</html>

<style>
  .perdida {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 18px;
    padding: 0 max(24px, 5.5vw);
  }

  .perdida__codigo {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: rgb(255 255 255 / 0.45);
  }

  .perdida__titulo {
    margin: 0;
    font-family: ClashDisplay, InstrumentSans, sans-serif;
    font-size: clamp(40px, 6.4vw, 112px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .perdida__texto {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 18px);
    color: rgb(255 255 255 / 0.6);
  }

  .perdida__volver {
    margin-block-start: 12px;
    font-size: 15px;
    font-weight: 600;
    color: #5ff7c6;
    text-decoration: none;
  }

  .perdida__volver:hover,
  .perdida__volver:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
