---
/**
 * Página de trabajo: cuatro maneras de enseñar los proyectos en el móvil.
 * Pensada para verla en el teléfono. No está enlazada; cuando elijamos, se
 * borra.
 */
import ProyectosMovil from '../components/ProyectosMovil.astro';
import VentanaProyecto from '../components/VentanaProyecto.astro';
import '../styles/global.css';

const ideas = [
  { variante: 'lista', nombre: 'Lista', nota: 'Una obra debajo de otra, con scroll normal. Cada una entra al aparecer.' },
  { variante: 'carrusel', nombre: 'Carrusel', nota: 'Desliza con el dedo en horizontal. La siguiente asoma; abajo, contador y línea de progreso.' },
  { variante: 'reels', nombre: 'Reels', nota: 'Cada obra a pantalla completa. Al bajar, la siguiente se monta sobre la anterior.' },
  { variante: 'indice', nombre: 'Índice', nota: 'Ventana de vídeo arriba y los nombres debajo: al bajar se enciende cada uno y cambia el vídeo.' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Proyectos en móvil — cuatro ideas</title>
    <style is:global>
      body {
        margin: 0;
        background: #050505;
        color: #f4f1ec;
        font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
      }
      .rotulo {
        display: grid;
        gap: 6px;
        margin: 0;
        padding: 48px 20px 8px;
        border-top: 1px solid rgb(255 255 255 / 0.15);
        background: #111;
      }
      .rotulo strong {
        font-family: ClashDisplay, InstrumentSans, sans-serif;
        font-size: 24px;
        font-weight: 500;
      }
      .rotulo span {
        font-size: 14px;
        line-height: 1.45;
        color: rgb(255 255 255 / 0.6);
        padding-bottom: 16px;
      }
    </style>
  </head>
  <body>
    {
      ideas.map((idea, i) => (
        <Fragment>
          <p class="rotulo">
            <strong>
              {i + 1} · {idea.nombre}
            </strong>
            <span>{idea.nota}</span>
          </p>
          <ProyectosMovil variante={idea.variante} />
        </Fragment>
      ))
    }
    <VentanaProyecto />
  </body>
</html>
