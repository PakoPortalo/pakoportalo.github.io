---
/**
 * Página de trabajo: la lista de proyectos para el móvil, con cuatro
 * maneras de entrar al bajar.
 * Pensada para verla en el teléfono. No está enlazada; cuando elijamos, se
 * borra.
 */
import ProyectosMovil from '../components/ProyectosMovil.astro';
import VentanaProyecto from '../components/VentanaProyecto.astro';
import '../styles/global.css';

const ideas = [
  { variante: 'lados', nombre: 'Lados', nota: 'Una entra desde la izquierda y la siguiente desde la derecha, con un giro leve que se endereza al llegar.' },
  { variante: 'cortinilla', nombre: 'Cortinilla', nota: 'El vídeo se destapa con un barrido lateral, alternando el sentido, mientras se aleja por dentro. Después sube el título.' },
  { variante: 'zoom', nombre: 'Zoom con el scroll', nota: 'Ligado al dedo: cada vídeo se abre de estrecho a todo el ancho, y suelta el zoom, según sube hacia el centro. Si vuelves arriba, se cierra.' },
  { variante: 'montaje', nombre: 'Línea de montaje', nota: 'Una línea con el cabezal morado que avanza al bajar. Cada obra es un clip: su marca se enciende al pasar el cabezal y entra desde la derecha.' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Lista de proyectos — cuatro entradas</title>
    <style is:global>
      body {
        margin: 0;
        background: #050505;
        color: #f4f1ec;
        font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
      }
      .rotulo {
        display: grid;
        gap: 6px;
        margin: 0;
        padding: 48px 20px 8px;
        border-top: 1px solid rgb(255 255 255 / 0.15);
        background: #111;
      }
      .rotulo strong {
        font-family: ClashDisplay, InstrumentSans, sans-serif;
        font-size: 24px;
        font-weight: 500;
      }
      .rotulo span {
        font-size: 14px;
        line-height: 1.45;
        color: rgb(255 255 255 / 0.6);
        padding-bottom: 16px;
      }
    </style>
  </head>
  <body>
    {
      ideas.map((idea, i) => (
        <Fragment>
          <p class="rotulo">
            <strong>
              {i + 1} · {idea.nombre}
            </strong>
            <span>{idea.nota}</span>
          </p>
          <ProyectosMovil variante={idea.variante} />
        </Fragment>
      ))
    }
    <VentanaProyecto />
  </body>
</html>
