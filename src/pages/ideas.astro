---
/**
 * Página de trabajo: tres variantes para "Quién soy", con tono de
 * profesional de agencia. No está enlazada; cuando elijamos, se borra.
 */
import QuienSoyEnfoque from '../components/QuienSoyEnfoque.astro';
import Tarjeta from '../components/Tarjeta.astro';
import '../styles/global.css';

const ideas = [
  { variante: 'directo', nombre: 'Directo', nota: 'Nombre en la tipografía display de la web, el rol debajo y los tres párrafos a la vista. Lo más sobrio y profesional.' },
  { variante: 'times', nombre: 'Como antes, sin pasar página', nota: 'El rótulo en Times de ahora y la biografía entera debajo, en una sola pantalla.' },
  { variante: 'bloques', nombre: 'En tres bloques', nota: 'La biografía partida en Formación, Videojuegos y Publicidad: se escanea de un vistazo, como un CV de agencia.' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Quién soy — tres variantes</title>
    <style is:global>
      body {
        margin: 0;
        background: #050505;
        color: #f4f1ec;
        font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
      }
      .rotulo {
        display: grid;
        gap: 6px;
        padding: 64px max(16px, 5.5vw) 0;
        border-top: 1px solid rgb(255 255 255 / 0.1);
      }
      .rotulo strong {
        font-family: ClashDisplay, InstrumentSans, sans-serif;
        font-size: 26px;
        font-weight: 500;
      }
      .rotulo span {
        max-width: 70ch;
        font-size: 14px;
        color: rgb(255 255 255 / 0.55);
      }
    </style>
  </head>
  <body>
    {
      ideas.map((idea, i) => (
        <Fragment>
          <p class="rotulo">
            <strong>
              {String(i + 1).padStart(2, '0')} · {idea.nombre}
            </strong>
            <span>{idea.nota}</span>
          </p>
          <QuienSoyEnfoque variante={idea.variante} />
        </Fragment>
      ))
    }
    <Tarjeta />
  </body>
</html>
