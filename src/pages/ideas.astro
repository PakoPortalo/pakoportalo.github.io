---
/**
 * Página de trabajo: seis tarjetas de visita en horizontal (85 × 55 mm),
 * cada una con su delante y su detrás. No está enlazada; cuando elijamos,
 * se borra.
 *
 * Todas usan el mismo papel: un color claro con el grano encima, ampliado
 * para que se note (--zoom-grano).
 */
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const correo = 'pakoportalo@gmail.com';
const insta = '@pakoportalo';
const telefono = '+34 636 25 06 34';

const ideas = [
  {
    nombre: 'Gofrado',
    nota: 'Sin tinta: el nombre y el contacto van hundidos en el papel, como con un troquel en seco. Solo el punto verde va impreso. La luz viene de arriba a la izquierda.',
  },
  {
    nombre: 'Cosido',
    nota: 'El nombre y el punto bordados con hilo verde, en satinado: hilos paralelos en diagonal que abultan y brillan. Detrás, una costura recorre el borde.',
  },
  {
    nombre: 'Agujero',
    nota: 'Idea mía. El punto se convierte en un agujero troquelado de verdad, con la tinta verde abriéndose alrededor. Detrás, papel verde intenso y el agujero en espejo.',
  },
  {
    nombre: 'Risografía',
    nota: 'Idea mía. Dos tintas planas, verde y morado, que se mezclan donde se pisan, como en una risografía.',
  },
  {
    nombre: 'Brutalista',
    nota: 'Idea mía, y la del detrás arriesgado. Delante, el nombre tan grande que se sale del papel. Detrás, el correo ocupa la tarjeta entera, partido a lo bruto, con Instagram y teléfono en bandas negras.',
  },
  {
    nombre: 'Estampado',
    nota: 'Idea mía. El punto en lámina metálica verde que cambia con la luz (mueve el ratón). Detrás, papel negro con el contacto estampado en la misma lámina.',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Tarjeta — seis ideas</title>
    <style is:global>
      @font-face {
        font-family: 'Switzer';
        src: url('/fonts/Switzer.woff2') format('woff2');
        font-weight: 100 900;
        font-display: swap;
      }
      @font-face {
        font-family: 'FunnelDisplay';
        src: url('/fonts/FunnelDisplay.woff2') format('woff2');
        font-weight: 300 800;
        font-display: swap;
      }
      @font-face {
        font-family: 'FamiljenGrotesk';
        src: url('/fonts/FamiljenGrotesk.woff2') format('woff2');
        font-weight: 100 900;
        font-display: swap;
      }
      body {
        margin: 0;
        background: #0b0b0b;
        color: #f4f1ec;
        font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif;
      }
    </style>
  </head>
  <body style={`--grano: url('${base}tarjeta/papel.webp')`}>
    {
      ideas.map((idea, n) => (
        <section class="idea" data-idea={n + 1}>
          <p class="rotulo">
            <strong>
              {n + 1} · {idea.nombre}
            </strong>
            <span>{idea.nota}</span>
          </p>

          <div class="par">
            {/* ═══ DELANTE ═══ */}
            <div class="carta" data-carta>
              <div class={`cara d${n + 1}`}>
                {n === 0 && (
                  <>
                    <span class="punto" />
                    <svg class="relieve" viewBox="0 0 850 550" aria-label="Pako Portalo, Música y Diseño sonoro">
                      <g filter="url(#hundido)">
                        <text x="790" y="395" text-anchor="end" class="g-nombre">
                          Pako Portalo
                        </text>
                        <text x="790" y="455" text-anchor="end" class="g-lema">
                          MÚSICA &amp; DISEÑO SONORO
                        </text>
                      </g>
                    </svg>
                  </>
                )}

                {n === 1 && (
                  <svg class="costura" viewBox="0 0 850 550" aria-label="Pako Portalo, Música y Diseño sonoro">
                    <defs>
                      {/* El satinado: hilos paralelos en diagonal, cada uno con su brillo. */}
                      <pattern id="satin" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(58)">
                        <rect width="5" height="5" fill="#0a7a55" />
                        <rect x="0.5" width="3.8" height="5" fill="#1fbf8a" />
                        <rect x="1.6" width="1" height="5" fill="#a6ffdf" opacity="0.7" />
                      </pattern>
                      <pattern id="satin-punto" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
                        <rect width="5" height="5" fill="#0a7a55" />
                        <rect x="0.5" width="3.8" height="5" fill="#1fbf8a" />
                        <rect x="1.6" width="1" height="5" fill="#a6ffdf" opacity="0.7" />
                      </pattern>
                      {/* Relieve del bordado: abulta un poco y proyecta sombra en el papel. */}
                      <filter id="bordado" x="-5%" y="-5%" width="110%" height="115%">
                        <feGaussianBlur in="SourceAlpha" stdDeviation="2" result="b" />
                        <feSpecularLighting in="b" surfaceScale="3" specularConstant="0.5" specularExponent="18" lighting-color="#fff" result="brillo">
                          <feDistantLight azimuth="225" elevation="50" />
                        </feSpecularLighting>
                        <feComposite in="brillo" in2="SourceAlpha" operator="in" result="brilloDentro" />
                        <feOffset in="SourceAlpha" dx="1.2" dy="2" result="s" />
                        <feGaussianBlur in="s" stdDeviation="1.4" result="sombra" />
                        <feFlood flood-color="#000" flood-opacity="0.4" />
                        <feComposite in2="sombra" operator="in" result="sombraColor" />
                        <feMerge>
                          <feMergeNode in="sombraColor" />
                          <feMergeNode in="SourceGraphic" />
                          <feMergeNode in="brilloDentro" />
                        </feMerge>
                      </filter>
                    </defs>
                    <g filter="url(#bordado)">
                      <text x="62" y="300" class="c-texto">
                        Pako
                      </text>
                      <text x="62" y="440" class="c-texto">
                        Portalo
                      </text>
                      <circle cx="680" cy="160" r="88" fill="url(#satin-punto)" class="c-borde" />
                    </g>
                    <text x="786" y="500" text-anchor="end" class="c-lema">
                      Música &amp; Diseño sonoro
                    </text>
                  </svg>
                )}

                {n === 2 && (
                  <>
                    <span class="halo" />
                    <span class="hueco" />
                    <div class="a-texto">
                      <p class="a-nombre">Pako Portalo</p>
                      <p class="a-lema">Música &amp; Diseño sonoro</p>
                    </div>
                  </>
                )}

                {n === 3 && (
                  <>
                    <span class="r-punto" />
                    <p class="r-nombre" aria-label="Pako Portalo">
                      <span>Pako</span>
                      <span>Portalo</span>
                    </p>
                    <p class="r-lema">Música &amp; Diseño sonoro</p>
                  </>
                )}

                {n === 4 && (
                  <>
                    <span class="punto b-punto" />
                    <p class="b-nombre">
                      <span>PAKO</span>
                      <span>PORTALO</span>
                    </p>
                    <p class="b-lema">Música &amp; Diseño sonoro — 2026</p>
                  </>
                )}

                {n === 5 && (
                  <>
                    <span class="lamina" />
                    <div class="e-texto">
                      <p class="e-nombre">Pako Portalo</p>
                      <p class="e-lema">Música &amp; Diseño sonoro</p>
                    </div>
                  </>
                )}
              </div>
            </div>

            {/* ═══ DETRÁS ═══ */}
            <div class="carta" data-carta>
              <div class={`cara t${n + 1}`}>
                {n === 0 && (
                  <>
                    <svg class="relieve" viewBox="0 0 850 550" aria-label={`${correo}, ${insta}, ${telefono}`}>
                      <g filter="url(#hundido)" class="g-datos">
                        <text x="425" y="230" text-anchor="middle">
                          {correo}
                        </text>
                        <text x="425" y="295" text-anchor="middle">
                          {insta}
                        </text>
                        <text x="425" y="360" text-anchor="middle">
                          {telefono}
                        </text>
                      </g>
                    </svg>
                    <span class="punto punto--mini" />
                  </>
                )}

                {n === 1 && (
                  <>
                    <svg class="costura" viewBox="0 0 850 550" aria-hidden="true">
                      <rect x="34" y="34" width="782" height="482" rx="10" class="c-agujero" pathLength="1000" />
                      <rect x="34" y="34" width="782" height="482" rx="10" class="c-agujero c-agujero--b" pathLength="1000" />
                      <g class="c-hilo-sombra">
                        <rect x="34" y="34" width="782" height="482" rx="10" class="c-hilo" pathLength="1000" />
                      </g>
                    </svg>
                    <ul class="datos datos--cosido">
                      <li>{correo}</li>
                      <li>{insta}</li>
                      <li>{telefono}</li>
                    </ul>
                  </>
                )}

                {n === 2 && (
                  <>
                    <span class="hueco hueco--espejo" />
                    <ul class="datos datos--agujero">
                      <li>{correo}</li>
                      <li>{insta}</li>
                      <li>{telefono}</li>
                    </ul>
                  </>
                )}

                {n === 3 && (
                  <>
                    <span class="r-punto r-punto--detras" />
                    <ul class="datos datos--riso">
                      <li>{correo}</li>
                      <li>{insta}</li>
                      <li>{telefono}</li>
                    </ul>
                  </>
                )}

                {n === 4 && (
                  <>
                    <p class="b-correo" aria-label={correo}>
                      <span>PAKO</span>
                      <span>PORTALO</span>
                      <span>@GMAIL.COM</span>
                    </p>
                    <p class="b-banda b-banda--insta">IG {insta}</p>
                    <p class="b-banda b-banda--tel">TEL {telefono}</p>
                    <span class="b-marca" aria-hidden="true">
                      ✶
                    </span>
                  </>
                )}

                {n === 5 && (
                  <ul class="datos datos--lamina">
                    <li>{correo}</li>
                    <li>{insta}</li>
                    <li>{telefono}</li>
                  </ul>
                )}
              </div>
            </div>
          </div>
        </section>
      ))
    }

    {/*
      El gofrado: el alfa del texto, difuminado, hace de mapa de alturas
      hundido (surfaceScale negativo). Una luz de arriba a la izquierda lo
      ilumina; lo plano queda en gris medio exacto, que en "overlay" no
      cambia el papel, y solo se ven los cantos de las letras.
    */}
    <svg width="0" height="0" aria-hidden="true" style="position: absolute">
      <filter id="hundido" x="-5%" y="-10%" width="110%" height="120%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceAlpha" stdDeviation="1.4" result="altura" />
        <feDiffuseLighting in="altura" surfaceScale="-5" diffuseConstant="1" lighting-color="#ffffff">
          <feDistantLight azimuth="225" elevation="30" />
        </feDiffuseLighting>
      </filter>
    </svg>

    <style>
      .idea {
        padding: 56px max(16px, 5.5vw) 72px;
        border-top: 1px solid rgb(255 255 255 / 0.1);
      }

      .rotulo {
        display: grid;
        gap: 6px;
        margin: 0 0 36px;
      }

      .rotulo strong {
        font-family: ClashDisplay, InstrumentSans, sans-serif;
        font-size: 26px;
        font-weight: 500;
      }

      .rotulo span {
        max-width: 80ch;
        font-size: 14px;
        color: rgb(255 255 255 / 0.55);
      }

      .par {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(24px, 4vw, 56px);
        perspective: 1400px;
      }

      /* ── La tarjeta y su papel ────────────────────────────── */
      .carta {
        width: min(560px, 90vw);
        aspect-ratio: 85 / 55;
        container-type: inline-size;
        transform: rotateX(calc(var(--rx, 0) * 1deg)) rotateY(calc(var(--ry, 0) * 1deg));
        transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .cara {
        --papel: #ecebe6;
        --tinta: #141414;
        --verde: #5ff7c6;
        position: relative;
        height: 100%;
        overflow: hidden;
        border-radius: 3px;
        background:
          radial-gradient(130% 100% at 15% 0%, #f5f4f0, transparent 65%),
          var(--papel);
        color: var(--tinta);
        box-shadow:
          0 40px 60px -32px rgb(0 0 0 / 0.85),
          0 0 0 1px rgb(0 0 0 / 0.05);
      }

      /* El grano, ampliado, encima de todo lo impreso. */
      .cara::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: var(--grano) 0 0 / var(--zoom-grano, 1300px);
        mix-blend-mode: overlay;
        opacity: var(--fuerza-grano, 1);
      }

      /* Un punto de luz que sigue al ratón: lo que lo hace objeto. */
      .cara::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: radial-gradient(circle at var(--lx, 30%) var(--ly, 20%), rgb(255 255 255 / 0.45), transparent 50%);
        mix-blend-mode: soft-light;
      }

      .cara p,
      .cara ul {
        margin: 0;
      }

      /* El punto verde de tinta, como el de la referencia. */
      .punto {
        position: absolute;
        top: -8%;
        left: 4%;
        width: 52cqw;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          #10b884 0%,
          #2fd9a2 14%,
          rgb(95 247 198 / 0.62) 30%,
          rgb(95 247 198 / 0.24) 48%,
          rgb(95 247 198 / 0) 68%
        );
        filter: blur(4px);
        mix-blend-mode: multiply;
      }

      .punto--mini {
        top: auto;
        bottom: -14cqw;
        left: auto;
        right: -14cqw;
        width: 34cqw;
      }

      .datos {
        padding: 0;
        list-style: none;
      }

      /* ── 1 · Gofrado ──────────────────────────────────────── */
      .relieve {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        mix-blend-mode: overlay;
      }

      .g-nombre {
        font-family: ClashDisplay, sans-serif;
        font-size: 92px;
        font-weight: 600;
        letter-spacing: -3px;
      }

      .g-lema {
        font-family: InstrumentSans, sans-serif;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: 6px;
      }

      .g-datos text {
        font-family: FamiljenGrotesk, InstrumentSans, sans-serif;
        font-size: 40px;
        font-weight: 600;
        letter-spacing: -0.5px;
      }

      /* ── 2 · Cosido ───────────────────────────────────────── */
      /* Encima del grano: el hilo no es papel. */
      .costura {
        z-index: 1;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .c-texto {
        font-family: ClashDisplay, sans-serif;
        font-size: 150px;
        font-weight: 700;
        letter-spacing: -1px;
        fill: url(#satin);
      }

      /* El remate del borde, en un verde más oscuro. */
      .c-texto,
      .c-borde {
        stroke: #08694a;
        stroke-width: 1.4;
      }

      /* Los agujeros de la aguja, en los dos extremos de cada puntada. */
      .c-agujero {
        fill: none;
        stroke: rgb(40 30 20 / 0.55);
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-dasharray: 0 10.5;
      }

      .c-agujero--b {
        stroke-dashoffset: 3.5;
      }

      .c-agujero--fino {
        stroke-width: 1.2;
        stroke-dasharray: 0 7;
      }

      /* El hilo: puntada de 7 y hueco de 3,5, con relieve y un brillo. */
      .c-hilo-sombra {
        filter: drop-shadow(0.7px 1px 0.5px rgb(0 0 0 / 0.45));
      }

      .c-hilo {
        fill: none;
        stroke: #12a877;
        stroke-width: 2.8;
        stroke-linecap: round;
        stroke-dasharray: 7 3.5;
      }

      .c-brillo {
        fill: none;
        stroke: #b9ffe6;
        stroke-width: 0.8;
        stroke-linecap: round;
        stroke-dasharray: 4.5 6;
        stroke-dashoffset: -1.2;
        opacity: 0.8;
      }

      .c-hilo--punto {
        stroke-width: 3.6;
        stroke-dasharray: 5 2;
      }

      .c-brillo--punto {
        stroke-dasharray: 3 4;
      }

      .t2 .c-hilo,
      .t2 .c-agujero {
        stroke-dasharray: 3 2;
      }

      .t2 .c-agujero {
        stroke-dasharray: 0 5;
      }

      .t2 .c-agujero--b {
        stroke-dashoffset: 2;
      }

      .c-lema {
        font-family: InstrumentSans, sans-serif;
        font-size: 24px;
        font-weight: 500;
        fill: var(--tinta);
      }

      .datos--cosido {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        gap: 1.2cqw;
        text-align: center;
        font-size: 3.6cqw;
        font-weight: 600;
      }

      /* ── 3 · Agujero ──────────────────────────────────────── */
      .d3 {
        --hx: 28%;
        --hy: 46%;
      }

      .t3 {
        --hx: 72%;
        --hy: 46%;
        --papel: #57e8b4;
        background: var(--papel);
      }

      /* El agujero: una máscara que deja ver lo que hay detrás. */
      .d3,
      .t3 {
        mask-image: radial-gradient(circle 10cqw at var(--hx) var(--hy), transparent 99%, #000 100%);
      }

      .halo {
        position: absolute;
        left: var(--hx);
        top: var(--hy);
        width: 62cqw;
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
        background: radial-gradient(circle, #10b884 14%, rgb(95 247 198 / 0.55) 26%, rgb(95 247 198 / 0.18) 44%, transparent 66%);
        filter: blur(3px);
        mix-blend-mode: multiply;
      }

      /* El canto del corte: una sombra fina por dentro del borde. */
      .hueco {
        position: absolute;
        left: var(--hx);
        top: var(--hy);
        width: 20.4cqw;
        aspect-ratio: 1;
        translate: -50% -50%;
        border-radius: 50%;
        box-shadow:
          0 0 0 1px rgb(0 0 0 / 0.25),
          0 1px 3px rgb(0 0 0 / 0.35);
      }

      .a-texto {
        position: absolute;
        right: 7%;
        bottom: 11%;
        text-align: right;
      }

      .a-nombre {
        font-family: Switzer, InstrumentSans, sans-serif;
        font-size: 7cqw;
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1;
      }

      .a-lema {
        margin-top: 1.4cqw !important;
        font-family: Switzer, InstrumentSans, sans-serif;
        font-size: 2.6cqw;
        font-weight: 500;
      }

      .datos--agujero {
        position: absolute;
        left: 7%;
        top: 50%;
        translate: 0 -50%;
        display: grid;
        gap: 0.6cqw;
        font-family: Switzer, InstrumentSans, sans-serif;
        font-size: 4cqw;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      /* ── 4 · Risografía ───────────────────────────────────── */
      .d4,
      .t4 {
        --riso-verde: #22c792;
        --riso-morado: #7b4fd6;
      }

      /* Tintas planas que se mezclan donde se pisan, como en una riso. */
      .r-punto,
      .r-nombre,
      .r-lema,
      .datos--riso {
        mix-blend-mode: multiply;
      }

      .r-punto {
        position: absolute;
        left: 30%;
        top: -30%;
        width: 66cqw;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, var(--riso-verde) 40%, transparent 41%);
        filter: blur(0.4px);
      }

      .r-punto--detras {
        right: auto;
        left: -24%;
        top: 34%;
      }

      .r-nombre {
        position: absolute;
        left: 6%;
        bottom: 15%;
        display: grid;
        font-family: ClashDisplay, sans-serif;
        font-size: 15cqw;
        font-weight: 600;
        letter-spacing: -0.045em;
        line-height: 0.82;
        color: var(--riso-morado);
      }

      /* La segunda pasada, en verde y un pelo descolocada. */
      .r-nombre--fantasma {
        color: var(--riso-verde);
        translate: 0.5cqw -0.35cqw;
        opacity: 0.85;
        z-index: -0;
      }

      .r-lema {
        position: absolute;
        left: 6.4%;
        bottom: 7%;
        font-size: 2.6cqw;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--riso-morado);
      }

      .datos--riso {
        position: absolute;
        right: 7%;
        top: 50%;
        translate: 0 -50%;
        display: grid;
        gap: 0.4cqw;
        text-align: right;
        font-family: ClashDisplay, sans-serif;
        font-size: 5cqw;
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--riso-morado);
      }

      /* ── 5 · Brutalista ───────────────────────────────────── */
      .b-punto {
        top: 10%;
        left: 40%;
        width: 66cqw;
      }

      .b-nombre {
        position: absolute;
        left: -1.2cqw;
        bottom: -4.6cqw;
        display: grid;
        font-family: FunnelDisplay, ClashDisplay, sans-serif;
        font-size: 24cqw;
        font-weight: 800;
        letter-spacing: -0.06em;
        line-height: 0.76;
      }

      .b-lema {
        position: absolute;
        top: 6%;
        left: 5%;
        font-family: FamiljenGrotesk, InstrumentSans, sans-serif;
        font-size: 2.3cqw;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .t5 {
        display: grid;
      }

      /* El correo, partido a lo bruto, ocupando la tarjeta. */
      .b-correo {
        position: absolute;
        inset: 3% 3% auto;
        display: grid;
        font-family: FunnelDisplay, ClashDisplay, sans-serif;
        font-weight: 800;
        letter-spacing: -0.06em;
        line-height: 0.8;
      }

      .b-correo span:nth-child(1) {
        font-size: 19cqw;
      }

      .b-correo span:nth-child(2) {
        font-size: 19cqw;
        justify-self: end;
      }

      .b-correo span:nth-child(3) {
        font-size: 13.4cqw;
        letter-spacing: -0.05em;
      }

      .b-banda {
        position: absolute;
        background: var(--tinta);
        color: var(--papel);
        font-family: FamiljenGrotesk, InstrumentSans, sans-serif;
        font-size: 3cqw;
        font-weight: 700;
        letter-spacing: 0.06em;
        padding: 1cqw 2cqw;
        white-space: nowrap;
      }

      .b-banda--insta {
        left: 3%;
        bottom: 5%;
        rotate: -4deg;
      }

      .b-banda--tel {
        right: 3%;
        bottom: 11%;
        rotate: 3deg;
        background: var(--verde);
        color: var(--tinta);
      }

      .b-marca {
        position: absolute;
        right: 4%;
        top: 46%;
        font-size: 6cqw;
        line-height: 1;
      }

      /* ── 6 · Estampado ────────────────────────────────────── */
      /*
        La lámina: un degradado metálico verde que se desliza con la luz,
        con borde nítido (el estampado no se difumina) y un relieve leve.
      */
      .lamina,
      .datos--lamina li {
        background:
          linear-gradient(
            calc(120deg + var(--ry, 0) * 6deg),
            #0e7d5a 0%,
            #5ff7c6 22%,
            #e9fff6 34%,
            #2fd9a2 46%,
            #0b6b4c 62%,
            #8ff5d0 80%,
            #137f5c 100%
          )
          calc(50% + var(--ry, 0) * 4%) 50% / 300% 300%;
      }

      .lamina {
        z-index: 1;
        position: absolute;
        left: 9%;
        top: 50%;
        translate: 0 -50%;
        width: 30cqw;
        aspect-ratio: 1;
        border-radius: 50%;
        box-shadow:
          inset 0 1px 1px rgb(255 255 255 / 0.6),
          inset 0 -1px 2px rgb(0 0 0 / 0.35),
          0 0.5px 1px rgb(0 0 0 / 0.3);
      }

      .e-texto {
        position: absolute;
        right: 7%;
        bottom: 12%;
        text-align: right;
      }

      .e-nombre {
        font-family: InstrumentSans, sans-serif;
        font-size: 5.6cqw;
        font-weight: 600;
        letter-spacing: -0.03em;
      }

      .e-lema {
        margin-top: 0.8cqw !important;
        font-size: 2.4cqw;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.6;
      }

      .t6 {
        --papel: #161616;
        background: var(--papel);
      }

      /* En papel negro, el grano más suave. */
      .t6::after {
        mix-blend-mode: soft-light;
        opacity: 0.8;
      }

      .datos--lamina {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 1cqw;
        font-family: InstrumentSans, sans-serif;
        font-size: 4.4cqw;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .datos--lamina li {
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
    </style>

    <script>
      // Cada tarjeta se inclina con el ratón y la luz la sigue.
      document.querySelectorAll<HTMLElement>('[data-carta]').forEach((carta) => {
        carta.addEventListener('pointermove', (evento) => {
          const r = carta.getBoundingClientRect();
          const x = (evento.clientX - r.left) / r.width - 0.5;
          const y = (evento.clientY - r.top) / r.height - 0.5;
          carta.style.setProperty('--ry', (x * 14).toFixed(2));
          carta.style.setProperty('--rx', (-y * 14).toFixed(2));
          carta.style.setProperty('--lx', `${((x + 0.5) * 100).toFixed(1)}%`);
          carta.style.setProperty('--ly', `${((y + 0.5) * 100).toFixed(1)}%`);
        });
        carta.addEventListener('pointerleave', () => {
          ['--rx', '--ry', '--lx', '--ly'].forEach((p) => carta.style.removeProperty(p));
        });
      });
    </script>
  </body>
</html>
