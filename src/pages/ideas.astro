---
/**
 * Página de trabajo: cuatro maquetaciones de "Especializado en" para el
 * móvil. Pensada para verla en el teléfono. No está enlazada; cuando
 * elijamos, se borra.
 */
import Encargos from '../components/Encargos.astro';
import '../styles/global.css';

const ideas = [
  { movil: 'medio', nombre: 'Medio', nota: 'Como estaba, pero a un tamaño intermedio y con las líneas equilibradas: sin palabras sueltas.' },
  { movil: 'bloques', nombre: 'Bloques', nota: 'Cada servicio en su mitad de la pantalla: uno arriba, otro abajo, con el vídeo en medio.' },
  { movil: 'acento', nombre: 'Acento', nota: 'Lo de «para quién» en grande y en color; el resto de la frase, pequeño, como entradilla.' },
  { movil: 'centrado', nombre: 'Centrado', nota: 'Todo al eje, con el punto de color encima de cada frase.' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Especializado en — cuatro maquetaciones</title>
    <style is:global>
      body { margin: 0; background: #050505; color: #f4f1ec; font-family: InstrumentSans, ui-sans-serif, system-ui, sans-serif; }
      .rotulo { position: relative; z-index: 3; display: grid; gap: 6px; margin: 0; padding: 40px 20px 20px; background: #161616; border-top: 1px solid rgb(255 255 255 / 0.15); }
      .rotulo strong { font-family: ClashDisplay, InstrumentSans, sans-serif; font-size: 24px; font-weight: 500; }
      .rotulo span { font-size: 14px; line-height: 1.45; color: rgb(255 255 255 / 0.6); }
      .hueco { position: relative; z-index: 2; height: 14svh; background: #050505; }
    </style>
  </head>
  <body>
    {
      ideas.map((idea, i) => (
        <Fragment>
          <p class="rotulo">
            <strong>{i + 1} · {idea.nombre}</strong>
            <span>{idea.nota}</span>
          </p>
          <Encargos fondo="montaje" opacidadFondo={0.3} movil={idea.movil} id={`encargos-${i}`} />
          <div class="hueco" />
        </Fragment>
      ))
    }
  </body>
</html>
