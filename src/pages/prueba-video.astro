---
/**
 * Página de diagnóstico temporal: por qué los clips no se mueven en el
 * iPhone. Prueba cada clip de dos formas (con el mp4 puesto desde el HTML y
 * con la carga perezosa de la web) y enseña lo que responde el navegador.
 * Se borra en cuanto esté resuelto.
 */
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const clips = ['xiaomi', 'revelation', 'culo', 'datagarden'];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Prueba de vídeo</title>
    <style>
      body { margin: 0; padding: 16px; background: #111; color: #eee; font: 13px/1.4 ui-monospace, monospace; }
      video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #333; margin-top: 6px; }
      pre { white-space: pre-wrap; margin: 6px 0 22px; padding: 8px; background: #000; color: #8f8; }
      h2 { font-size: 14px; margin: 18px 0 0; }
      #general { color: #ff8; }
    </style>
  </head>
  <body>
    <pre id="general">…</pre>
    {
      clips.map((c) => (
        <>
          <h2>{c} · mp4 directo, autoplay</h2>
          <video data-prueba muted loop playsinline autoplay preload="auto" poster={`${base}proyectos/clips/${c}.webp`}>
            <source src={`${base}proyectos/clips/${c}.mp4`} type="video/mp4" />
          </video>
          <pre data-informe>…</pre>
        </>
      ))
    }
    <script>
      const general = document.getElementById('general')!;
      const lineas: string[] = [];
      lineas.push(`UA: ${navigator.userAgent}`);
      const v = document.createElement('video');
      lineas.push(`canPlayType mp4: "${v.canPlayType('video/mp4')}"`);
      lineas.push(`canPlayType webm av1: "${v.canPlayType('video/webm; codecs="av01.0.05M.08"')}"`);
      lineas.push(`ahorro de datos / movimiento reducido: ${matchMedia('(prefers-reduced-motion: reduce)').matches ? 'MOVIMIENTO REDUCIDO ACTIVADO' : 'no'}`);
      navigator.mediaCapabilities
        ?.decodingInfo({ type: 'file', video: { contentType: 'video/webm; codecs="av01.0.05M.08"', width: 1280, height: 720, bitrate: 1e6, framerate: 25 } })
        .then((i) => {
          lineas.push(`AV1: supported=${i.supported} smooth=${i.smooth} powerEfficient=${i.powerEfficient}`);
          general.textContent = lineas.join('\n');
        })
        .catch((e) => {
          lineas.push(`AV1 decodingInfo error: ${e}`);
          general.textContent = lineas.join('\n');
        });
      general.textContent = lineas.join('\n');

      document.querySelectorAll<HTMLVideoElement>('[data-prueba]').forEach((video) => {
        const informe = video.nextElementSibling as HTMLElement;
        const log: string[] = [];
        const pintar = () => {
          informe.textContent = [
            `paused=${video.paused} t=${video.currentTime.toFixed(2)} readyState=${video.readyState} networkState=${video.networkState}`,
            `error=${video.error ? video.error.code + ' ' + video.error.message : 'ninguno'}`,
            ...log,
          ].join('\n');
        };
        ['loadedmetadata', 'canplay', 'playing', 'stalled', 'suspend', 'error'].forEach((ev) =>
          video.addEventListener(ev, () => {
            log.push(`evento: ${ev}`);
            pintar();
          }),
        );
        video
          .play()
          .then(() => log.push('play(): OK'))
          .catch((e) => log.push(`play() RECHAZADO: ${e.name} — ${e.message}`))
          .finally(pintar);
        setInterval(pintar, 1000);
      });
    </script>
  </body>
</html>
