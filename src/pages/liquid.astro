---
// Página de prueba aislada para el hero líquido, sin tocar el resto del sitio.
import HeroLiquid from '../components/HeroLiquid.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pako Portalo</title>
    <meta name="robots" content="noindex" />
    <style>
      body { margin: 0; background: #050505; }
    </style>
  </head>
  <body>
    <HeroLiquid
      copy={{
        eyebrowLeft: 'Sound design',
        eyebrowRight: 'Web solutions',
        title: 'Pako Portalo.',
        subtitle: 'Music & Web.',
        paragraph:
          'Efectos, bandas sonoras para spots y videojuegos, ambientes para cine — y las webs donde todo eso se ve.',
      }}
    />
  </body>
</html>
